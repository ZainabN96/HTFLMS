@{
    ViewData["Title"] = "About";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}


<main class="about-page">
  <!-- ================= HERO ================= -->
  <section class="ab-hero">
    <div class="ab-container ab-hero__grid">
      <div class="ab-hero__text">
        <span class="ab-eyebrow-pill"
          ><i class="ab-dot"></i> HCC Technology Foundation &bull; Est.
          2000</span
        >
        <h1 class="ab-hero__title">
          <span class="ab-hero__about">ABOUT</span>
          <span class="ab-hero__us">US.</span>
        </h1>
        <p class="ab-hero__lead">
          We are HCC, a team that helps people stand out, connect and grow
          through world-class technology, targeted vocational training, and
          dedicated executive mentorship.
        </p>
      </div>

      <div class="ab-hero__visual" aria-hidden="true">
        <div class="ab-orbit ab-orbit--1"></div>
        <div class="ab-orbit ab-orbit--2"></div>
        <div class="ab-sphere">
          <small>Empowering Future Tech</small>
          <strong>Inspire. Learn. Lead.</strong>
        </div>
        <span class="ab-chip ab-chip--top"
          ><i class="ab-dot ab-dot--green"></i> Innovation Hub</span
        >
        <span class="ab-chip ab-chip--bottom">4+ Yrs Empowering Youth</span>
      </div>
    </div>
  </section>

  <!-- ================= OUR STORY (ab upar) ================= -->
  <section class="ab-story">
    <div class="ab-container ab-story__inner">
      <span class="ab-pill reveal">Our Story</span>
      <p class="ab-story__text reveal" style="--d: 0.1s">
        We believe talent has no gender, and every woman deserves the
        opportunity to shape the future of technology name was born from a
        simple question: if women graduate with the knowledge and potential to
        succeed, why are so few represented in technology leadership? We saw a
        gap between what women learn in the classroom and what the industry
        expects , and we knew something had to change .So, we set out to do more
        than create opportunities. We set out to build a community where women
        feel supported, gain practical skills, get real-world experience, and
        find the confidence to turn their ambitions into careers. And we're
        putting that belief into practice. Today, 99% of our employees are
        former name students.  That's more than a statistic; it's a reflection
        of what happens when potential is nurtured, opportunities are created,
        and talent is given room to grow. At HCC Technology Foundation, we don't
        just prepare women for the world of work. We empower them to find their
        place, make their mark, and help shape the future of tech.
      </p>
    </div>
    @*
  </section>
  *@

  <!-- ================= TIMELINE ================= -->
  @*
  <section class="ab-timeline">
    *@
    <div class="ab-container">
      <header class="ab-timeline__head reveal ab-timeline__margin">
        <span class="ab-eyebrow">Our Evolution &amp; Impact</span>
        <h2 class="ab-timeline__title">How it all began</h2>
        <span class="ab-underline"></span>
      </header>

