@{
    ViewData["Title"] = "About";
    Layout = "_Layout";
}
<main class="main">

    <!-- Page Title -->
    <div class="page-title page-title-about" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1>About Us<br></h1>
                        <p class="mb-0">HTF LMS is the learning platform of HCC, built to support professional growth through practical, industry-focused education. We help students and professionals develop the skills needed to succeed in technology, business, and digital transformation.</p>
                    </div>
                </div>
            </div>
        </div>
        @* <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a href="#">Home</a></li>
                    <li class="current">About Us<br></li>
                </ol>
            </div>
        </nav> *@
    </div><!-- End Page Title -->
    <!-- About Us Section -->
    <section id="about-us" class="section about-us">

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-up" data-aos-delay="100">
                    <img src="~/img/about/about-1.webp" class="img-fluid" alt="">
                </div>

                <div class="col-lg-6 order-2 order-lg-1 content" data-aos="fade-up" data-aos-delay="200">
                    <h3>Building Skills for a Digital Future</h3>
                    <p class="fst-italic">
                        HTF LMS reflects HCC’s commitment to innovation, professional development, and practical learning that creates real impact.
                    </p>
                    <ul>
                        <li><i class="bi bi-check-circle"></i> <span>Industry-focused courses designed to match modern business and technology needs.</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>Learning experiences that combine theory, guided practice, and real-world application.</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>A platform created to help learners grow with confidence, stay competitive, and build career-ready skills.</span></li>
                    </ul>
                </div>

            </div>

        </div>

    </section><!-- /About Us Section -->
    <!-- Counts Section -->
    <section id="counts" class="section counts light-background">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-4">

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="397"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Alumni</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="12"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Courses</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="45"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Events</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="28"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Cohorts</p>
                    </div>
                </div>

            </div>

        </div>

    </section>
    <!-- Testimonials Section -->
    <!-- Success Stories Section -->
    <section id="testimonials" class="testimonials section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Success Stories</h2>
            <p>From Learners to Leaders</p>
        </div>

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="swiper init-swiper">
                <script type="application/json" class="swiper-config">
                    {
                      "loop": true,
                      "speed": 600,
                      "autoplay": {
                        "delay": 5000
                      },
                      "slidesPerView": "auto",
                      "pagination": {
                        "el": ".swiper-pagination",
                        "type": "bullets",
                        "clickable": true
                      },
                      "breakpoints": {
                        "320": {
                          "slidesPerView": 1,
                          "spaceBetween": 40
                        },
                        "1200": {
                          "slidesPerView": 2,
                          "spaceBetween": 20
                        }
                      }
                    }
                </script>

                <div class="swiper-wrapper">

                    <!-- Amna Abid -->
                    <div class="swiper-slide">
                        <div class="testimonial-wrap">
                            <div class="testimonial-item">
                                <img src="~/img/person/amna1.png" class="testimonial-img" alt="Amna Abid">

                                <h3>Amna Abid</h3>
                                <h4>Manager, HCC Technology Foundation</h4>

                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>
                                        Amna Abid began her journey as a learner at HCC Technology Foundation. Through dedication, continuous learning, and leadership development, she progressed within the organization and now serves as the Manager of HCC Technology Foundation, helping create opportunities for future learners.
                                    </span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Ayman Mehmood -->
                    <div class="swiper-slide">
                        <div class="testimonial-wrap">
                            <div class="testimonial-item">
                                <img src="~/img/trainers/ayman1.png" class="testimonial-img" alt="Ayman Mehmood">

                                <h3>Ayman Mehmood</h3>
                                <h4>Marketing Professional</h4>

                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>
                                        Ayman Mehmood started her journey with HCC Technology Foundation as a trainer. Her passion for communication, branding, and professional growth helped her transition into the marketing field, where she now contributes to promoting educational initiatives and community engagement.
                                    </span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Zainab Naveed -->
                    <div class="swiper-slide">
                        <div class="testimonial-wrap">
                            <div class="testimonial-item">
                                <img src="~/img/trainers/zainab1.png" class="testimonial-img" alt="Zainab Naveed">

                                <h3>Zainab Naveed</h3>
                                <h4>WordPress Trainer</h4>

                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>
                                        Zainab Naveed joined HCC Technology Foundation as a learner and developed strong web development skills through practical training. Today, she serves as a WordPress Trainer, helping aspiring developers gain hands-on experience in website design and digital solutions.
                                    </span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Sehrish Batool -->
                    <div class="swiper-slide">
                        <div class="testimonial-wrap">
                            <div class="testimonial-item">
                                <img src="~/img/person/person-f-12.webp" class="testimonial-img" alt="Sehrish Batool">

                                <h3>Sehrish Batool</h3>
                                <h4>Figma & UI/UX Trainer</h4>

                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>
                                        Sehrish Batool began as a learner with a passion for creativity and design. Through consistent learning and practical experience, she became a Figma and UI/UX Trainer, empowering future designers with industry-relevant skills and real-world knowledge.
                                    </span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="swiper-pagination"></div>

            </div>

        </div>

    </section>
    <!-- End Success Stories Section -->
</main>