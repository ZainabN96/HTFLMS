    <header class="dashboard-topbar">
        <div class="dashboard-topbar-left">
            <button class="dashboard-icon-btn" id="dashboardSidebarToggle" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="dashboard-brand" asp-controller="Trainers" asp-action="Index">
                <img src="~/img/hcc_logo(1).png" alt="HCC Logo" class="dashboard-logo" />
            </a>
        </div>

        <div class="dashboard-topbar-center">
            <div class="dashboard-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search courses, students, lessons..." />
            </div>
        </div>

        <div class="dashboard-topbar-right">
            <div class="dashboard-notification">
                <button class="dashboard-icon-btn"
                        id="notificationToggle"
                        type="button"
                        aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="dashboard-dot"></span>
                </button>

                <div class="dashboard-notification-dropdown" id="notificationDropdown">
                    <div class="dashboard-notification-header">Notifications</div>

                    <div class="dashboard-notification-item">
                        New student enrolled in your course
                    </div>

                    <div class="dashboard-notification-item">
                        Assignment submitted for review
                    </div>

                    <div class="dashboard-notification-item">
                        Profile updated successfully
                    </div>

                    <div class="dashboard-notification-footer">
                        View all
                    </div>
                </div>
            </div>

            <div class="dashboard-userchip">
                <div class="dashboard-avatar">@name.Substring(0, 1).ToUpper()</div>
                <div class="dashboard-usertext">
                    <div class="dashboard-username">@name</div>
                    <div class="dashboard-role">Trainer</div>
                </div>
            </div>

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="dashboard-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="dashboard-btn dashboard-btn-outline">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </header>
    <div class="admin-shell" id="adminShell">

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <nav class="admin-nav">

                <a class="admin-nav-item"
                   asp-area="Admin" asp-controller="Admin" asp-action="AdminDashboard">
                    <i class="bi bi-grid-1x2"></i>
                    Dashboard
                </a>

                <div class="admin-nav-section">Management</div>

                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="AdminCourses"
                   asp-action="AdminMyCourses">
                    <i class="bi bi-journal-bookmark"></i>
                    Courses
                </a>

                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="AdminModulesLessons"
                   asp-action="AdminModules">

                    <i class="bi bi-collection-play"></i>
                    Modules & Lessons
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-people"></i>
                    Users
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-person-badge"></i>
                    Trainers
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-person-check"></i>
                    Enrollments
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-award"></i>
                    Grades
                </a>

                <div class="admin-nav-section">Settings</div>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-gear"></i>
                    System Settings
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-shield-check"></i>
                    Roles & Permissions
                </a>
            </nav>
        </aside>

        <!-- Main content -->
        <main class="admin-content">
            @RenderBody()

            @await Html.PartialAsync("_SuccessPopup")

            <footer class="admin-footer">
                <div>© @DateTime.Now.Year HTF LMS</div>
                <div class="admin-footer-links">
                    <a href="#">Support</a>
                    <a href="#">Docs</a>
                    <a href="#">Privacy</a>
                </div>
            </footer>
        </main>

    </div>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const toggle = document.getElementById('adminSidebarToggle');
        const shell = document.getElementById('adminShell');

        if (toggle && shell) {
            toggle.addEventListener('click', () => {
                shell.classList.toggle('collapsed');
            });
        }
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>