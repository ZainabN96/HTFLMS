@using System.Security.Claims

@{
    var name = User?.Identity?.Name ?? "Admin";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HTF LMS</title>

    <link rel="stylesheet"
          href="~/css/dashboards.css"
          asp-append-version="true" />

    <link rel="icon"
          type="image/png"
          href="~/img/fav.png">

    <link rel="apple-touch-icon"
          href="~/img/fav.png">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="dashboard-body">

    <!-- =========================
         TOP HEADER
    ========================== -->

    <header class="dashboard-topbar">

        <div class="dashboard-topbar-left">

            <button class="dashboard-icon-btn"
                    id="dashboardSidebarToggle"
                    type="button"
                    aria-label="Toggle sidebar">

                <i class="bi bi-list"></i>

            </button>

            <a class="dashboard-brand"
               asp-controller="admin"
               asp-action="Index">

                <img src="~/img/hcc_logo(1).png"
                     alt="HCC Logo"
                     class="dashboard-logo" />

            </a>

        </div>


        <!-- Search -->

        <div class="dashboard-topbar-center">

            <div class="dashboard-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Search users, courses, enrollments..." />

            </div>

        </div>


        <!-- Right Side -->

        <div class="dashboard-topbar-right">


            <!-- =========================
                 NOTIFICATIONS
            ========================== -->

            <div class="dashboard-notification">

                <button class="dashboard-icon-btn"
                        id="notificationToggle"
                        type="button"
                        aria-label="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="dashboard-dot"
                          id="notificationUnreadDot"
                          hidden>
                    </span>

                </button>


                <div class="dashboard-notification-dropdown"
                     id="notificationDropdown">

                    <div class="dashboard-notification-header">

                        Notifications<span id="notificationCount"></span>

                    </div>


                    <div id="notificationList">

                        <div class="dashboard-notification-item">
                            Loading notifications...
                        </div>

                    </div>


                    <div class="dashboard-notification-footer"
                         id="notificationMarkAllRead">

                        Mark all as read

                    </div>

                </div>

            </div>


            <!-- =========================
                 USER INFO
            ========================== -->

            <div class="dashboard-userchip">

                <div class="dashboard-avatar">
                    @name.Substring(0, 1).ToUpper()
                </div>

                <div class="dashboard-usertext">

                    <div class="dashboard-username">
                        @name
                    </div>

                    <div class="dashboard-role">
                        Admin
                    </div>

                </div>

            </div>


            <!-- =========================
                 LOGOUT
            ========================== -->

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="dashboard-logout">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="dashboard-btn dashboard-btn-outline">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </button>

            </form>

        </div>

    </header>



    <!-- =========================
         PAGE SHELL
    ========================== -->

    <div class="dashboard-shell"
         id="dashboardShell">


        <!-- =========================
             SIDEBAR
        ========================== -->

        <aside class="dashboard-sidebar"
               id="dashboardSidebar">

            <nav class="dashboard-nav">


                <!-- Dashboard -->

                <a asp-area="Admin"
                   asp-controller="Admin"
                   asp-action="Index"
                   class="dashboard-nav-item
                   @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin"
                                      && ViewContext.RouteData.Values["action"]?.ToString() == "Index"
                                      ? "active" : "")">

                    <i class="bi bi-grid-1x2"></i>

                    Dashboard

                </a>


                <div class="dashboard-nav-divider"></div>


                <div class="dashboard-nav-section">
                    Management
                </div>


                <!-- Courses -->

                <a asp-area="Admin"
                   asp-controller="Courses"
                   asp-action="Index"
                   class="dashboard-nav-item
                   @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses"
                                      ? "active" : "")">

                    <i class="bi bi-journal-bookmark"></i>

                    <span>Courses</span>

                </a>


                <!-- Modules & Lessons -->

                <a asp-area="Admin"
                   asp-controller="ModulesLessons"
                   asp-action="Index"
                   asp-route-id="1"
                   class="dashboard-nav-item
                   @(ViewContext.RouteData.Values["controller"]?.ToString() == "ModulesLessons"
                                      ? "active" : "")">

                    <i class="bi bi-collection"></i>

                    <span>Modules & Lessons</span>

                </a>


                <!-- Students -->

                <a class="dashboard-nav-item
                   @((controller == "Students" && action == "Index")
                                      ? "active" : "")"
                   asp-controller="Students"
                   asp-action="Index">

                    <i class="bi bi-people"></i>

                    Students

                </a>


                <!-- Trainers -->

                <a class="dashboard-nav-item
                   @(controller == "ManageTrainers"
                                      ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="ManageTrainers"
                   asp-action="Trainers">

                    <i class="bi bi-person-badge"></i>

                    <span>Trainers</span>

                </a>


                <div class="dashboard-nav-divider"></div>


                <div class="dashboard-nav-section">
                    Grading
                </div>


                <!-- Certificates -->

                <a asp-area="Admin"
                   asp-controller="Certificates"
                   asp-action="Index"
                   class="dashboard-nav-item
                   @(ViewContext.RouteData.Values["controller"]?.ToString() == "Certificates"
                                      ? "active" : "")">

                    <i class="bi bi-award"></i>

                    <span>Certificates</span>

                </a>

            </nav>

        </aside>



        <!-- =========================
             MAIN CONTENT
        ========================== -->

        <main class="dashboard-content">

            @RenderBody()

            @await Html.PartialAsync("_SuccessPopup")


            <!-- Footer -->

            <footer class="dashboard-footer">

                <div>
                    © @DateTime.Now.Year HTF LMS
                </div>

                <div class="dashboard-footer-links">

                    <a href="#">Support</a>

                    <a href="#">Docs</a>

                    <a href="#">Privacy</a>

                </div>

            </footer>

        </main>

    </div>



    <!-- =========================
         SCRIPTS
    ========================== -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Sidebar -->

    <script>
        (function () {

            const toggle =
                document.getElementById('dashboardSidebarToggle');

            const shell =
                document.getElementById('dashboardShell');

            if (toggle && shell) {

                toggle.addEventListener('click', function () {

                    shell.classList.toggle('collapsed');

                });

            }

        })();
    </script>


    <!-- SignalR Client -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>


    <!-- Notification JS -->

    <script src="~/js/notifications.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>