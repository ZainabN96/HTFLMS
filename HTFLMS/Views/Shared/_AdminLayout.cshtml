@using System.Security.Claims
@{
    var name = User?.Identity?.Name ?? "Admin";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTF LMS Admin</title>

    <!-- Admin-specific CSS -->
    <link rel="stylesheet" href="~/css/dashboards.css" asp-append-version="true" />

    <!-- Bootstrap Icons (you already use bi icons) -->
    <link rel="icon" type="image/png" href="~/img/fav.png">
    <link rel="apple-touch-icon" href="~/img/fav.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="admin-body">

    <!-- Top header -->
    <header class="admin-topbar">
        <div class="admin-topbar-left">
            <button class="admin-icon-btn" id="adminSidebarToggle" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="admin-brand" asp-controller="Admin" asp-action="Index">
                <img src="~/img/hcc_logo(1).png" alt="HCC Logo" class="admin-logo" />
                <span class="admin-brand-text">Admin</span>
            </a>
        </div>

        <div class="admin-topbar-center">
            <div class="admin-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search users, courses, enrollments..." />
            </div>
        </div>

        <div class="admin-topbar-right">
            <button class="admin-icon-btn" type="button" aria-label="Notifications">
                <i class="bi bi-bell"></i>
                <span class="admin-dot"></span>
            </button>

            <div class="admin-userchip">
                <div class="admin-avatar">@name.Substring(0, 1).ToUpper()</div>
                <div class="admin-usertext">
                    <div class="admin-username">@name</div>
                    <div class="admin-role">Administrator</div>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post" class="admin-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-btn admin-btn-outline">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </header>


    <div class="admin-shell" id="adminShell">

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <nav class="admin-nav">
                <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    Dashboard
                </a>

                <div class="admin-nav-section">Management</div>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-journal-bookmark"></i>
                    Courses
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-collection-play"></i>
                    Modules & Lessons
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-people"></i>
                    Users
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-person-badge"></i>
                    Trainers
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-person-check"></i>
                    Enrollments
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-award"></i>
                    Grades
                </a>

                <div class="admin-nav-section">Settings</div>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-gear"></i>
                    System Settings
                </a>

                <a class="admin-nav-item" href="#">
                    <i class="bi bi-shield-check"></i>
                    Roles & Permissions
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <div class="admin-mini">
                    <div class="admin-mini-title">Quick actions</div>
                    <div class="admin-mini-actions">
                        <a class="admin-mini-btn" href="#"><i class="bi bi-plus-circle"></i> New Course</a>
                        <a class="admin-mini-btn" href="#"><i class="bi bi-person-plus"></i> New User</a>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <main class="admin-content">
            @RenderBody()

            @await Html.PartialAsync("_SuccessPopup")

            <footer class="admin-footer">
                <div>© @DateTime.Now.Year HTF LMS</div>
                <div class="admin-footer-links">
                    <a href="#">Support</a>
                    <a href="#">Docs</a>
                    <a href="#">Privacy</a>
                </div>
            </footer>
        </main>

    </div>

    <script>
        (function () {
            const toggle = document.getElementById('adminSidebarToggle');
            const shell = document.getElementById('adminShell');
            if (!toggle || !shell) return;

            toggle.addEventListener('click', () => {
                shell.classList.toggle('collapsed');
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)

</body>
</html>
