@{
    var msg = TempData["SuccessMessage"] as string;   // <-- NOT Peek
}
@if (!string.IsNullOrWhiteSpace(msg))
{
    <div id="appToast" class="app-toast" role="status" aria-live="polite">
        <span class="app-toast-icon">✓</span>
        <span class="app-toast-text">@msg</span>
    </div>

    <script>
        window.addEventListener("load", function () {
            const loader = document.getElementById("loader-wrapper");

            if (loader) {
                loader.classList.add("is-hidden");

                setTimeout(() => {
                    loader.remove();
                    showSuccessPopup();
                }, 400);
            } else {
                showSuccessPopup();
            }

            function showSuccessPopup() {
                const popup = document.getElementById("appToast");
                if (!popup) return;

                popup.classList.add("show");
                setTimeout(() => popup.classList.remove("show"), 3500);
            }
        });
        </script>
} 
