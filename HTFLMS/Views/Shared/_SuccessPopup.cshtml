@{
    var msg = TempData["SuccessMessage"] as string ?? "";
}

<div id="appToast" class="app-toast" role="status" aria-live="polite">
    <span class="app-toast-icon">✓</span>
    <span class="app-toast-text" id="appToastText">@msg</span>
</div>

<script>
    function showSuccessPopup(message) {
        const popup = document.getElementById("appToast");
        const text = document.getElementById("appToastText");

        if (!popup) return;

        if (message && text) {
            text.innerText = message;
        }

        if (!text || !text.innerText.trim()) return;

        popup.classList.add("show");

        setTimeout(() => {
            popup.classList.remove("show");
        }, 3500);
    }

    window.addEventListener("load", function () {
        const hasTempDataMessage = "@(!string.IsNullOrWhiteSpace(msg))".toLowerCase() === "true";

        if (!hasTempDataMessage) return;

        const loader = document.getElementById("loader-wrapper");

        if (loader) {
            loader.classList.add("is-hidden");

            setTimeout(() => {
                loader.remove();
                showSuccessPopup();
            }, 400);
        } else {
            showSuccessPopup();
        }
    });
</script>