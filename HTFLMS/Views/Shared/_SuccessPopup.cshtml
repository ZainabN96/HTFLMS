@{
    var msg = TempData["SuccessMessage"] as string;   // <-- NOT Peek
}
@if (!string.IsNullOrWhiteSpace(msg))
{
    <div id="loginSuccessPopup" class="login-success-popup" role="status" aria-live="polite">
        <span class="popup-icon">✓</span>
        <span class="popup-text">@msg</span>
    </div>

    <script>
        window.addEventListener("load", function () {
            const loader = document.getElementById("loader-wrapper");

            if (loader) {
                loader.classList.add("is-hidden");

                setTimeout(() => {
                    loader.remove();
                    showLoginSuccessPopup();
                }, 400);
            } else {
                showLoginSuccessPopup();
            }

            function showLoginSuccessPopup() {
                const popup = document.getElementById("loginSuccessPopup");
                if (!popup) return;

                popup.classList.add("show");
                setTimeout(() => popup.classList.remove("show"), 3500);
            }
        });
    </script>
}
