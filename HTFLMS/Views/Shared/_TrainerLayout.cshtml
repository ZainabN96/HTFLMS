@using System.Security.Claims
@{
    var name = User?.Identity?.Name ?? "Trainer";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTF LMS</title>

    <link rel="stylesheet" href="~/css/dashboards.css" asp-append-version="true" />

    <link rel="icon" type="image/png" href="~/img/fav.png" />
    <link rel="apple-touch-icon" href="~/img/fav.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="dashboard-body">

    <header class="dashboard-topbar">
        <div class="dashboard-topbar-left">
            <button class="dashboard-icon-btn" id="dashboardSidebarToggle" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="dashboard-brand" asp-controller="Trainers" asp-action="Index">
                <img src="~/img/hcc_logo(1).png" alt="HCC Logo" class="dashboard-logo" />
            </a>
        </div>

        <div class="dashboard-topbar-center">
            <div class="dashboard-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search courses, students, lessons..." />
            </div>
        </div>

        <div class="dashboard-topbar-right">
            <div class="dashboard-notification">
                <button class="dashboard-icon-btn"
                        id="notificationToggle"
                        type="button"
                        aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="dashboard-dot"></span>
                </button>

                <div class="dashboard-notification-dropdown" id="notificationDropdown">
                    <div class="dashboard-notification-header">Notifications</div>

                    <div class="dashboard-notification-item">
                        New student enrolled in your course
                    </div>

                    <div class="dashboard-notification-item">
                        Assignment submitted for review
                    </div>

                    <div class="dashboard-notification-item">
                        Profile updated successfully
                    </div>

                    <div class="dashboard-notification-footer">
                        View all
                    </div>
                </div>
            </div>

            <div class="dashboard-userchip">
                <div class="dashboard-avatar">@name.Substring(0, 1).ToUpper()</div>
                <div class="dashboard-usertext">
                    <div class="dashboard-username">@name</div>
                    <div class="dashboard-role">Trainer</div>
                </div>
            </div>

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="dashboard-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="dashboard-btn dashboard-btn-outline">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </header>

    <div class="dashboard-shell" id="dashboardShell">

        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <nav class="dashboard-nav">
                <a asp-area="Trainer" asp-controller="Trainer" asp-action="Index"
                   class="dashboard-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Trainer"
                                         && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    Dashboard
                </a>

                <div class="dashboard-nav-section">Teaching</div>

                <a asp-area="Trainer" asp-controller="Courses" asp-action="Index"
                   class="dashboard-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")">
                    <i class="bi bi-journal-bookmark"></i>
                    <span>Courses</span>
                </a>

                <a asp-area="Trainer" asp-controller="ModulesLessons" asp-action="Index" asp-route-id="1"
                   class="dashboard-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ModulesLessons" ? "active" : "")">
                    <i class="bi bi-collection"></i>
                    <span>Modules & Lessons</span>
                </a>

                <a asp-area="Trainer" asp-controller="SlidesAssignments" asp-action="Index"
                   asp-route-courseId="@ViewBag.CourseId" asp-route-moduleId="1"
                   class="dashboard-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SlidesAssignments" ? "active" : "")">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Slides & Assignments</span>
                </a>


                <a class="dashboard-nav-item @((controller == "Students" && action == "Index") ? "active" : "")"
                   asp-controller="Students" asp-action="Index">
                    <i class="bi bi-people"></i>
                    Students
                </a>

                <div class="dashboard-nav-divider"></div>

                <div class="dashboard-nav-section">Grading</div>

                <a asp-area="Trainer" asp-controller="Submissions" asp-action="Index"
                   class="dashboard-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Submissions" ? "active" : "")">
                    <i class="bi bi-journal-check"></i>
                    <span>All Submissions</span>
                </a>

                <a asp-area="Trainer" asp-controller="Gradebook" asp-action="Index"
                   class="dashboard-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gradebook" ? "active" : "")">
                    <i class="bi bi-award"></i>
                    <span>Gradebook</span>
                </a>

                <div class="dashboard-nav-divider"></div>

                <div class="dashboard-nav-section dashboard-nav-section-account">Account</div>

                <a class="dashboard-nav-item @((controller == "Profile" && action == "Index") ? "active" : "")"
                   asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person"></i>
                    Profile
                </a>
            </nav>
        </aside>

        <main class="dashboard-content">
            @RenderBody()

            @await Html.PartialAsync("_SuccessPopup")

            <footer class="dashboard-footer">
                <div>© @DateTime.Now.Year HTF LMS</div>
                <div class="dashboard-footer-links">
                    <a href="#">Support</a>
                    <a href="#">Docs</a>
                    <a href="#">Privacy</a>
                </div>
            </footer>
        </main>

    </div>

    <script>
        (function () {
            const toggle = document.getElementById('dashboardSidebarToggle');
            const shell = document.getElementById('dashboardShell');
            if (!toggle || !shell) return;

            toggle.addEventListener('click', () => {
                shell.classList.toggle('collapsed');
            });
        })();

        const notificationBtn = document.getElementById("notificationToggle");
        const notificationDropdown = document.getElementById("notificationDropdown");

        if (notificationBtn) {
            notificationBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                notificationDropdown.classList.toggle("show");
            });
        }

        document.addEventListener("click", function () {
            if (notificationDropdown) {
                notificationDropdown.classList.remove("show");
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>