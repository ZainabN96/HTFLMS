            <img src="~/img/htf_logo1.png" alt="HTF Logo" style="height:48px;">
        </a>

        <nav class="nav" id="nav" aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="About" asp-action="AboutIndex">About Us</a>
            <a asp-controller="Courses" asp-action="CoursesIndex">Courses</a>
