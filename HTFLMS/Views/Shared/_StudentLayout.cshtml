@using System.Security.Claims
@{
    var name = User?.Identity?.Name ?? "Student";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTF LMS</title>

    <link rel="stylesheet" href="~/css/dashboards.css" asp-append-version="true" />

    <link rel="icon" type="image/png" href="~/img/fav.png">
    <link rel="apple-touch-icon" href="~/img/fav.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="dashboard-body">

    <header class="dashboard-topbar">
        <div class="dashboard-topbar-left">
            <button class="dashboard-icon-btn" id="dashboardSidebarToggle" type="button" aria-label="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="dashboard-brand" asp-area="Student" asp-controller="Student" asp-action="Index">
                <img src="~/img/hcc_logo(1).png" alt="HCC Logo" class="dashboard-logo" />
            </a>
        </div>

        <div class="dashboard-topbar-center">
            <div class="dashboard-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search courses, lessons..." />
            </div>
        </div>

        <div class="dashboard-topbar-right">
            <div class="dashboard-notification">

                <button class="dashboard-icon-btn"
                        id="notificationToggle"
                        type="button"
                        aria-label="Notifications">

                    <i class="bi bi-bell"></i>
                    <span class="dashboard-dot"></span>

                </button>

                <div class="dashboard-notification-dropdown" id="notificationDropdown">
                    <div class="dashboard-notification-header">Notifications</div>

                    <div class="dashboard-notification-item">
                        New assignment uploaded
                    </div>

                    <div class="dashboard-notification-item">
                        Your grade was updated
                    </div>

                    <div class="dashboard-notification-item">
                        Profile updated successfully
                    </div>

                    <div class="dashboard-notification-footer">
                        View all
                    </div>
                </div>
            </div>

            <div class="dashboard-userchip">
                <div class="dashboard-avatar">@name.Substring(0, 1).ToUpper()</div>
                <div class="dashboard-usertext">
                    <div class="dashboard-username">@name</div>
                    <div class="dashboard-role">Student</div>
                </div>
            </div>


            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="dashboard-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="dashboard-btn dashboard-btn-outline">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </header>

    <div class="dashboard-shell" id="dashboardShell">

        <!-- Student Sidebar -->
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
                var area = ViewContext.RouteData.Values["area"]?.ToString();
            }

            <nav class="dashboard-nav">
                <a class="dashboard-nav-item @((area == "Student" && controller == "Student" && action == "Index") ? "active" : "")"
                   asp-area="Student" asp-controller="Student" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    Dashboard
                </a>

                <div class="dashboard-nav-divider"></div>

                <div class="dashboard-nav-section">Learning</div>

                <a class="dashboard-nav-item @((area == "Student" && controller == "Courses" && action == "Index") ? "active" : "")"
                   asp-area="Student" asp-controller="Courses" asp-action="Index">
                    <i class="bi bi-journal-bookmark"></i>
                    My Course
                </a>

                <a class="dashboard-nav-item @((area == "Student" && controller == "Grades" && action == "Index") ? "active" : "")"
                   asp-area="Student" asp-controller="Grades" asp-action="Index">
                    <i class="bi bi-award"></i>
                    Grades
                </a>

                <a class="dashboard-nav-item @((area == "Student" && controller == "Notes" && action == "Index") ? "active" : "")"
                   asp-area="Student" asp-controller="Notes" asp-action="Index">
                    <i class="bi bi-stickies"></i>
                    Notes
                </a>

                <a class="dashboard-nav-item @((area == "Student" && controller == "Certificates" && action == "Index") ? "active" : "")"
                   asp-area="Student" asp-controller="Certificates" asp-action="Index">
                    <i class="bi bi-patch-check"></i>
                    Certificate
                </a>

                <div class="dashboard-nav-divider"></div>

                <div class="dashboard-nav-section dashboard-nav-section-account">Account</div>

                <a class="dashboard-nav-item @((area == "Student" && controller == "Profile" && action == "Index") ? "active" : "")"
                   asp-area="Student" asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person"></i>
                    Profile
                </a>
            </nav>
        </aside>

        <!-- Main content -->
        <main class="dashboard-content">
            @RenderBody()

            @await Html.PartialAsync("_SuccessPopup")

            <footer class="dashboard-footer">
                <div>© @DateTime.Now.Year HTF LMS</div>
                <div class="dashboard-footer-links">
                    <a href="#">Support</a>
                    <a href="#">Docs</a>
                    <a href="#">Privacy</a>
                </div>
            </footer>
        </main>

    </div>

    <script>
        (function () {
            const toggle = document.getElementById('dashboardSidebarToggle');
            const shell = document.getElementById('dashboardShell');
            if (!toggle || !shell) return;
            toggle.addEventListener('click', () => shell.classList.toggle('collapsed'));
        })();

                const notificationBtn = document.getElementById("notificationToggle");
        const notificationDropdown = document.getElementById("notificationDropdown");

        if(notificationBtn){

            notificationBtn.addEventListener("click", function(e){

                e.stopPropagation();

                notificationDropdown.classList.toggle("show");

            });

        }

        document.addEventListener("click", function(){

            if(notificationDropdown){

                notificationDropdown.classList.remove("show");

            }

        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>