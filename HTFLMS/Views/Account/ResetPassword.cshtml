@model HTFLMS.Models.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<main class="main auth">
    <section class="auth-wrap">
        <div class="auth-logo">
            <img src="~/img/hcc_logo(1).png" alt="HCC Logo" />
        </div>

        <div class="auth-card">
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Set a new password for your account</p>

            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FlowId" />
                <input type="hidden" asp-for="Email" />

                <div class="auth-field">
                    <input asp-for="NewPassword" class="auth-input" placeholder=" " />
                    <label>New Password</label>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="ConfirmPassword" class="auth-input" placeholder=" " />
                    <label>Confirm Password</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="text-danger small mb-2">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>

                <button type="submit" class="auth-btn">Update Password</button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
