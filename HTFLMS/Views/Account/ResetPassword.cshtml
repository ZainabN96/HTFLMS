@model HTFLMS.Models.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<main class="main auth">
    <section class="auth-wrap">
        <div class="auth-logo">
            <img src="~/img/hcc_logo(1).png" alt="HCC Logo" />
        </div>

        <div class="auth-card">
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Set a new password for your account</p>

            <form id="resetPasswordForm">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="FlowId" id="FlowId" />
                <input type="hidden" asp-for="Email" id="Email" />

                <div class="auth-field">
                    <input asp-for="NewPassword" class="auth-input" id="NewPassword" placeholder=" " />
                    <label>New Password</label>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <input asp-for="ConfirmPassword" class="auth-input" id="ConfirmPassword" placeholder=" " />
                    <label>Confirm Password</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="text-danger small mb-2" id="resetErrorBox"></div>

                <button type="submit" class="auth-btn" id="resetPasswordBtn">
                    Update Password
                </button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("resetPasswordForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const btn = document.getElementById("resetPasswordBtn");
            const errorBox = document.getElementById("resetErrorBox");

            const data = {
                flowId: document.getElementById("FlowId").value,
                email: document.getElementById("Email").value,
                newPassword: document.getElementById("NewPassword").value,
                confirmPassword: document.getElementById("ConfirmPassword").value
            };

            btn.disabled = true;
            btn.innerText = "Updating...";
            errorBox.innerHTML = "";

            try {
                const response = await fetch("/api/email/reset-password", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    localStorage.setItem(
                        "loginSuccessMessage",
                        result.message || "Password changed successfully. Please login."
                    );

                    window.location.href = "/Account/Login";
                    return;
                }

                errorBox.innerHTML = result.message || "Password could not be changed.";
            }
            catch {
                errorBox.innerHTML = "Something went wrong. Please try again.";
            }
            finally {
                btn.disabled = false;
                btn.innerText = "Update Password";
            }
        });
    </script>
}