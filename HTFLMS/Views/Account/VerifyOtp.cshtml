@model HTFLMS.Models.Auth.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
    Layout = "_AuthLayout";
}

<main class="main auth">
    <section class="auth-wrap">
        <div class="auth-logo">
            <img src="~/img/hcc_logo(1).png" alt="HCC Logo" />
        </div>

        <div class="auth-card">
            <h1 class="auth-title">Verify OTP</h1>
            <p class="auth-subtitle">Enter the 6-digit code sent to your email</p>

            <form id="verifyOtpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FlowId" id="FlowId" />
                <input type="hidden" asp-for="Email" id="Email" />

                <div class="auth-field">
                    <input asp-for="Otp" class="auth-input" id="Otp" placeholder=" " inputmode="numeric" maxlength="6" />
                    <label>OTP (6 digits)</label>
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn" id="verifyOtpBtn">Verify</button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("verifyOtpForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const flowId = document.getElementById("FlowId").value;
            const email = document.getElementById("Email").value;
            const otp = document.getElementById("Otp").value;

            const btn = document.getElementById("verifyOtpBtn");
            btn.disabled = true;
            btn.innerText = "Verifying...";

            try {
                const response = await fetch("/api/email/verify-otp", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        flowId: flowId,
                        email: email,
                        otp: otp
                    })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    localStorage.setItem("successMessage", result.message || "OTP verified successfully.");

                    window.location.href = "/Account/ResetPassword?flowId="
                        + encodeURIComponent(result.flowId)
                        + "&email="
                        + encodeURIComponent(result.email);

                    return;
                }

                showSuccessPopup(result.message || "Invalid OTP.");
            }
            catch {
                showSuccessPopup("Something went wrong. Please try again.");
            }
            finally {
                btn.disabled = false;
                btn.innerText = "Verify";
            }
        });
    </script>
}