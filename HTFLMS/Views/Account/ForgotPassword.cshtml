@model HTFLMS.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<main class="main auth">
    <section class="auth-wrap">
        <div class="auth-logo">
            <img src="~/img/hcc_logo(1).png" alt="HCC Logo" />
        </div>

        <div class="auth-card">
            <h1 class="auth-title">Forgot Password</h1>
            <p class="auth-subtitle">Enter your email to receive a 6-digit OTP</p>

            <form id="forgotPasswordForm">
                @Html.AntiForgeryToken()

                <div class="auth-field">
                    <input asp-for="Email" class="auth-input" id="Email" placeholder=" " />
                    <label>Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn" id="sendOtpBtn">Send OTP</button>

                <div class="auth-links mt-3">
                    <a asp-action="Login" asp-controller="Account">Back to Login</a>
                </div>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("forgotPasswordForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = e.target;
            const email = document.getElementById("Email").value;
            const btn = document.getElementById("sendOtpBtn");

            btn.disabled = true;
            btn.innerText = "Sending...";

            try {
                const response = await fetch("/api/email/forgot-password", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        email: email
                    })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    localStorage.setItem("successMessage", result.message || "OTP sent successfully.");

                    window.location.href = "/Account/VerifyOtp?flowId="
                        + encodeURIComponent(result.flowId || "")
                        + "&email="
                        + encodeURIComponent(result.email || email);

                    return;
                }

                showSuccessPopup(result.message || "Something went wrong. Please try again.");
            }
            catch {
                showSuccessPopup("Something went wrong. Please try again.");
            }
            finally {
                btn.disabled = false;
                btn.innerText = "Send OTP";
            }
        });
    </script>
}
