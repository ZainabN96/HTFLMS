@model HTFLMS.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<main class="main auth">
    <section class="auth-wrap">
        <div class="auth-logo">
            <img src="~/img/hcc_logo(1).png" alt="HCC Logo" />
        </div>

        <div class="auth-card">
            <h1 class="auth-title">Forgot Password</h1>
            <p class="auth-subtitle">Enter your email to receive a 6-digit OTP</p>

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="auth-field">
                    <input asp-for="Email" class="auth-input" placeholder=" " />
                    <label>Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn">Send OTP</button>

                <div class="auth-links mt-3">
                    <a asp-action="Login" asp-controller="Account">Back to Login</a>
                </div>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
