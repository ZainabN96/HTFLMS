@model HTFLMS.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Registration Form";
    Layout = "_AuthLayout";
    var returnUrl = (string?)ViewBag.ReturnUrl;
}

<main class="main">
    <section class="reg-wrap">
        <div class="reg-card">
            <div class="auth-logo">
                <img src="~/img/hcc_logo(1).png" alt="HCC Logo" />
            </div>
            <h2 class="reg-title">Registration Form</h2>

            <form id="registerForm">
                @Html.AntiForgeryToken()
                @* <input type="hidden" name="returnUrl" value="@returnUrl" /> *@
                <input type="hidden" id="returnUrl" name="returnUrl" value="@returnUrl" />
                <div class="reg-grid">
                    <div class="reg-pill">Profile</div>

                    <div class="reg-field">
                        <input asp-for="Name" class="reg-input" placeholder="Name*" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="Email" class="reg-input" placeholder="Email Address*" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="Password" type="password" class="reg-input" placeholder="Password*" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="ConfirmPassword" type="password" class="reg-input" placeholder="Confirm Password*" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <select asp-for="Gender" class="reg-input">
                            <option value="">Gender*</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>


                    <div class="reg-field">
                        <select asp-for="Qualification" class="reg-input">
                            <option value="">Qualification</option>
                            <option>Matric</option>
                            <option>Intermediate</option>
                            <option>Bachelors</option>
                            <option>Masters</option>
                        </select>
                    </div>

                    <div class="reg-field">
                        <input asp-for="CNIC" class="reg-input" placeholder="CNIC*" />
                        <span asp-validation-for="CNIC" class="text-danger small"></span>
                    </div>


                    <div class="reg-pill">Home Address</div>

                    <div class="reg-field">
                        <input asp-for="Address" class="reg-input" placeholder="Address" />
                    </div>

                    <div class="reg-field">
                        <select asp-for="Country" class="reg-input">
                            <option value="">Select Country*</option>
                            <option>Pakistan</option>
                            <option>United States</option>
                            <option>UAE</option>
                        </select>
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <select asp-for="City" class="reg-input">
                            <option value="">Select City*</option>
                            <option>Lahore</option>
                            <option>Karachi</option>
                            <option>Islamabad</option>
                        </select>
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="MobileNumber" class="reg-input" placeholder="Mobile Number*" />
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="LinkedIn" class="reg-input" placeholder="LinkedIn" />
                    </div>

                    <div class="reg-field">
                        <select asp-for="EmploymentStatus" class="reg-input">
                            <option value="">Employment Status*</option>
                            <option value="Searching for Job">Searching for Job</option>
                            <option value="Employed">Employed</option>
                            <option value="Student">Student</option>
                        </select>
                        <span asp-validation-for="EmploymentStatus" class="text-danger small"></span>
                    </div>


                </div>

                @* <div class="text-danger small mb-2">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div> *@
                <div class="text-danger small mb-2 error-box"></div>

                @* <div class="text-center">
                    <button type="submit" class="btn btn-danger sub-btn">Submit Your Application Today!</button>
                </div> *@
                <div class="text-center mt-3">
                    <button type="submit" id="submitBtn" class="btn btn-danger sub-btn">
                        Submit Your Application Today!
                    </button>
                </div>

                <div class="text-center mt-3">
                    <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@returnUrl">Already have an account? Login</a>
                </div>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/ajax/register.js" asp-append-version="true"></script>
}