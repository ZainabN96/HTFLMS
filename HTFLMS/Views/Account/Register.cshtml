@model HTFLMS.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Registration Form";
    Layout = "_Layout";
    var returnUrl = (string?)ViewBag.ReturnUrl;
}

<main class="main">
    <section class="reg-wrap">
        <div class="reg-card">
            <h2 class="reg-title">Registration Form</h2>

            <form asp-action="Register" asp-controller="Account" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="reg-grid">
                    <div class="reg-pill">Profile</div>

                    <div class="reg-field span-2">
                        <label class="req">Profile Picture*</label>
                        <input asp-for="ProfilePicture" type="file" class="reg-input" />
                    </div>

                    <div class="reg-field">
                        <label class="req">Title*</label>
                        <select asp-for="Title" class="reg-input">
                            <option value="">Select</option>
                            <option>Mr</option>
                            <option>Ms</option>
                            <option>Mrs</option>
                        </select>
                    </div>

                    <div class="reg-field">
                        <label class="req">Member*</label>
                        <select asp-for="MemberType" class="reg-input">
                            <option value="">Select</option>
                            <option value="Student">Student</option>
                            <option value="Trainer">Trainer</option>
                        </select>

                        <span asp-validation-for="MemberType" class="text-danger small"></span>

                    </div>

                    <div class="reg-field">
                        <input asp-for="FirstName" class="reg-input" placeholder="First Name*" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="LastName" class="reg-input" placeholder="Last Name*" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <label class="req">Date of Birth*</label>
                        <input asp-for="DateOfBirth" type="date" class="reg-input" />
                    </div>

                    <div class="reg-field">
                        <select asp-for="Qualification" class="reg-input">
                            <option value="">Qualification*</option>
                            <option>Matric</option>
                            <option>Intermediate</option>
                            <option>Bachelors</option>
                            <option>Masters</option>
                        </select>
                    </div>

                    <div class="reg-field">
                        <select asp-for="BloodGroup" class="reg-input">
                            <option value="">Blood Group*</option>
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                            <option>O+</option>
                            <option>O-</option>
                        </select>
                    </div>

                    <div class="reg-field span-2">
                        <input asp-for="CNIC" class="reg-input" placeholder="CNIC*" />
                        <span asp-validation-for="CNIC" class="text-danger small"></span>
                    </div>

                    <div class="reg-pill">Home Address</div>

                    <div class="reg-field">
                        <input asp-for="Address" class="reg-input" placeholder="Address*" />
                    </div>

                    <div class="reg-field">
                        <input asp-for="PostCode" class="reg-input" placeholder="PostCode/ZIP*" />
                    </div>

                    <div class="reg-field">
                        <select asp-for="Country" class="reg-input">
                            <option value="">Select Country</option>
                            <option>Pakistan</option>
                            <option>United States</option>
                            <option>UAE</option>
                        </select>
                    </div>

                    <div class="reg-field">
                        <select asp-for="City" class="reg-input">
                            <option value="">Select City</option>
                            <option>Lahore</option>
                            <option>Karachi</option>
                            <option>Islamabad</option>
                        </select>
                    </div>

                    <div class="reg-field">
                        <input asp-for="MobileNumber" class="reg-input" placeholder="Mobile Number*" />
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="Email" class="reg-input" placeholder="Email Address*" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="reg-field span-2">
                        <input asp-for="LinkedIn" class="reg-input" placeholder="LinkedIn" />
                    </div>

                    <div class="reg-field span-2">
                        <select asp-for="EmploymentStatus" class="reg-input">
                            <option value="">Employment Status*</option>
                            <option>Employed</option>
                            <option>Unemployed</option>
                            <option>Student</option>
                        </select>
                    </div>

                    <div class="reg-pill">Login Details</div>

                    <div class="reg-field">
                        <input asp-for="UserId" class="reg-input" placeholder="Email Id*" />
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="Password" class="reg-input" placeholder="Password*" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <input asp-for="ConfirmPassword" class="reg-input" placeholder="Confirm Password*" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="reg-field">
                        <select asp-for="SecurityQuestion" class="reg-input">
                            <option value="">Please Select One Of The Following Question:</option>
                            <option>What is your pet name?</option>
                            <option>What is your favorite city?</option>
                            <option>What is your school name?</option>
                        </select>
                    </div>

                    <div class="reg-field">
                        <input asp-for="SecurityAnswer" class="reg-input" placeholder="Secret Answer" />
                    </div>
                </div>

                <div class="text-danger small mb-2">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-danger sub-btn">Submit Your Application Today!</button>
                </div>

                <div class="text-center mt-3">
                    <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@returnUrl">Already have an account? Login</a>
                </div>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
