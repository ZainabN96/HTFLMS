@{
    ViewData["Title"] = "Tariners";
    Layout = "_Layout";
}
<main class="main">

    <!-- Page Title -->
    <div class="page-title page-title-trainers" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1>Trainers</h1>
                        <p class="mb-0">Our trainers bring together academic knowledge, industry experience, and practical insight to deliver learning that is relevant, professional, and career-focused. They guide learners with real-world expertise across business, technology, and digital skills.</p>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- End Page Title -->
