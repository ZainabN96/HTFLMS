@{
    ViewData["Title"] = "Contact Us";
    Layout = "_Layout";
}

<main class="main">
    <div class="htf-courses htf-contact">

        <!-- HERO -->
        <section class="htf-courses__hero">
            <div class="htf-courses__intro">
                <h1 class="htf-courses__heading">
                    <span class="htf-courses__our">Let's make</span>
                    <span class="htf-courses__our">an impact</span>
                    <span class="htf-courses__script">together</span>
                </h1>
            </div>

            <div class="htf-courses__visual">
                <div class="htf-courses__orbit">
                    <span class="htf-courses__orbit-label htf-courses__orbit-label--top">
                        <i class="htf-courses__dot"></i>We'd love to hear from you
                    </span>
                    <div class="htf-courses__circle">
                        <span class="htf-courses__circle-caption">GET IN TOUCH</span>
                        <span class="htf-courses__circle-title">Connect. Collaborate. Grow.</span>
                    </div>
                    <span class="htf-courses__orbit-label htf-courses__orbit-label--bottom">info@hcc.com.pk</span>
                </div>
            </div>
        </section>

        <!-- INTRO -->
        <section class="htf-contact__intro">
            <span class="htf-contact__pill">GET IN TOUCH</span>
            <h2 class="htf-contact__title">Let’s connect, and shape a better future <em>together</em></h2>
            <p class="htf-contact__lead">
                Whether you're looking to start your journey in tech, explore a partnership, collaborate with us,
                or support our mission to bridge the gender gap in technology, we'd love to hear from you.
            </p>
        </section>

        <!-- CONNECT PANEL -->
        <section class="htf-contact__panel-wrap">
            <div class="htf-contact__panel">
                <h3 class="htf-contact__panel-title">How would you like to connect?</h3>
                <p class="htf-contact__panel-sub">Choose the path that best describes you.</p>

                <div class="htf-contact__paths">

                    <a asp-controller="Contact" asp-action="Form" asp-route-type="student" class="htf-contact__path">
                        <svg class="htf-contact__icon" style="color:#7c3aed" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 9l10-5 10 5-10 5z" />
                            <path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" />
                            <path d="M22 9v6" />
                        </svg>
                        <h4>I'm a student</h4>
                        <p>Explore learning opportunities and take your first steps into tech.</p>
                        <span class="htf-contact__arrow" aria-hidden="true">&rarr;</span>
                    </a>

                    <a asp-controller="Contact" asp-action="Form" asp-route-type="contribute" class="htf-contact__path">
                        <svg class="htf-contact__icon" style="color:#e0a020" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z" />
                            <path d="M9.5 11l2 2 3.5-3.5" />
                        </svg>
                        <h4>I want to contribute</h4>
                        <p>Apply for an internship or employment, or volunteer your skills.</p>
                        <span class="htf-contact__arrow" aria-hidden="true">&rarr;</span>
                    </a>

                    <a asp-controller="Contact" asp-action="Form" asp-route-type="support" class="htf-contact__path">
                        <svg class="htf-contact__icon" style="color:#3b82f6" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="6" cy="5" r="1.6" />
                            <path d="M3 14c3 0 4-2 6-2s3 1 5 1 3-1 6-3M3 19h18" />
                        </svg>
                        <h4>I want to support</h4>
                        <p>Help create opportunities for more women in technology.</p>
                        <span class="htf-contact__arrow" aria-hidden="true">&rarr;</span>
                    </a>

                    <a asp-controller="Contact" asp-action="Form" asp-route-type="partner" class="htf-contact__path">
                        <svg class="htf-contact__icon" style="color:#22c55e" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 14l4-4M8 12l-2 2a3 3 0 104 4l2-2M16 12l2-2a3 3 0 10-4-4l-2 2" />
                        </svg>
                        <h4>Let’s partner up</h4>
                        <p>Explore industry partnerships, collaborations, and shared initiatives.</p>
                        <span class="htf-contact__arrow" aria-hidden="true">&rarr;</span>
                    </a>

                </div>
            </div>
        </section>

    </div>
</main>

















