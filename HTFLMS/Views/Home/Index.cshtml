    <!-- ============ CTA ============ -->
    <section class="cta" id="contact">
        <div class="cta__shape" id="ctaShape">
            <div class="cta__blobs" aria-hidden="true">
                <i class="blob blob--1"></i><i class="blob blob--2"></i><i class="blob blob--3"></i>
            </div>

            <div class="cta__inner">
                <h2 class="cta__title" aria-label="Ready to start?">
                    <span class="cta__row"><span class="cta__words" data-split>Ready to</span></span>
                    <span class="cta__row cta__row--italic"><span class="cta__start" data-split-italic>start</span><span class="cta__q">?</span></span>
                </h2>

                <div class="cta__btnwrap">
                    @* <span class="ring ring--1" aria-hidden="true"></span>
                    <span class="ring ring--2" aria-hidden="true"></span>
                    <span class="ring ring--3" aria-hidden="true"></span> *@
                    <a href="mailto:info@hcc.com.pk" class="cta__btn" id="ctaBtn">
                        <span class="cta__btn-fill" aria-hidden="true"></span>
                        <span class="cta__btn-label">Let’s talk</span>
                        <svg class="cta__btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
