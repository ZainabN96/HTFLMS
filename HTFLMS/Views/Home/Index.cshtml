@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<main class="main">

    <!-- Hero Section -->
    <section id="hero" class="hero section dark-background">

        <img src="~/img/Herobanner.jpg" alt="" data-aos="fade-in">

        <div class="container">
            <h2 data-aos="fade-up" data-aos-delay="100">Learn Today,<br>Lead Tomorrow</h2>
            <p data-aos="fade-up" data-aos-delay="200">HTF LMS is the digital learning platform of HCC, designed to help students and professionals gain practical skills through structured courses, hands-on projects, and guided learning paths.</p>
            <div class="d-flex mt-4" data-aos="fade-up" data-aos-delay="300">
                <a class="btn-get-started"
                   asp-controller="Courses"
                   asp-action="CoursesIndex">
                    Get Started
                </a>
            </div>
        </div>

    </section><!-- /Hero Section -->
    <!-- About Section -->
    <section id="about" class="about section">

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-up" data-aos-delay="100">
                    <img src="~/img/about.jpg" class="img-fluid" alt="">
                </div>

                <div class="col-lg-6 order-2 order-lg-1 content" data-aos="fade-up" data-aos-delay="200">
                    <h3>HCC Mission and Overview</h3>
                    <p class="fst-italic">
                        HCC started in 2000 as the technology consulting arm of Crowe Pakistan and has grown into a global digital transformation and consulting company combining expertise in finance and technology.

                        HTF LMS is built to support this mission by providing accessible, industry-relevant learning programs that prepare students for real careers in technology and business.
                    </p>
                    <ul>
                        <li><i class="bi bi-check-circle"></i> <span>Learn practical skills aligned with industry needs</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>Courses designed by technology and consulting professionals</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>Hands-on projects and real-world case studies</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>Career-focused learning paths</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>Continuous skill development for modern digital jobs</span></li>
                    </ul>
                    <a asp-controller="About" asp-action="AboutIndex" class="read-more"><span>Read More</span><i class="bi bi-arrow-right"></i></a>
                </div>

            </div>

        </div>

    </section><!-- /About Section -->

    <!-- Counts Section -->
    <section id="counts" class="section counts light-background">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-4">

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="397"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Alumni</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="12"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Courses</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="45"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Events</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stats-item text-center w-100 h-100">
                        <div class="counter-wrapper">
                            <span data-purecounter-start="0"
                                  data-purecounter-end="28"
                                  data-purecounter-duration="1"
                                  class="purecounter"></span>
                            <span class="counter-plus">+</span>
                        </div>
                        <p>Cohorts</p>
                    </div>
                </div>

            </div>

        </div>

    </section>
    
    <!-- Why Us Section -->
    <section id="why-us" class="section why-us">

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="why-box">
                        <h3>Why Choose Our Learning Platform?</h3>
                        <p>
                            HTF LMS provides structured learning paths designed with industry experts. Our programs combine theory, practical exercises, and real-world projects to ensure learners develop skills that are directly applicable in professional environments.
                        </p>
                        <div class="text-center">
                            <a asp-controller="Courses"
                               asp-action="CoursesIndex"
                               class="more-btn">
                                <span>Learn More</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div><!-- End Why Box -->

                <div class="col-lg-8 d-flex align-items-stretch">
                    <div class="row gy-4" data-aos="fade-up" data-aos-delay="200">

                        <div class="col-xl-4">
                            <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                                <i class="bi bi-journal-code"></i>
                                <h4>Industry Skills</h4>
                                <p>Courses designed to match modern tools, technologies, and real industry requirements</p>
                            </div>
                        </div><!-- End Icon Box -->

                        <div class="col-xl-4" data-aos="fade-up" data-aos-delay="300">
                            <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                                <i class="bi bi-person-workspace"></i>
                                <h4>Expert Trainers</h4>
                                <p>Learn from professionals with real experience in consulting, development, and digital transformation</p>
                            </div>
                        </div><!-- End Icon Box -->

                        <div class="col-xl-4" data-aos="fade-up" data-aos-delay="400">
                            <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                                <i class="bi bi-laptop"></i>
                                <h4>Practical Learning</h4>
                                <p>Work on real projects and assignments to build confidence and hands-on experience</p>
                            </div>
                        </div><!-- End Icon Box -->

                    </div>
                </div>
            </div>

        </div>

    </section><!-- /Why Us Section -->
    <!-- Features Section -->
    <section id="features" class="features section">

        <div class="container">

            <div class="section-title text-center mb-3" data-aos="fade-up">
                <h2>Partners</h2>
                <p>Our Technology & Academic Partners</p>
            </div>

            <div class="row gy-4">

                <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="features-item">
                        <i class="bi bi-mortarboard" style="color: #b2904f;"></i>
                        <h3><a href="" class="stretched-link">NUST</a></h3>
                    </div>
                </div><!-- End Feature Item -->

                <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="150">
                    <div class="features-item">
                        <i class="bi bi-mortarboard-fill" style="color: #b20969;"></i>
                        <h3><a href="" class="stretched-link">Namal University</a></h3>
                    </div>
                </div><!-- End Feature Item -->

                <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="features-item">
                        <i class="bi bi-briefcase" style="color: #ff5828;"></i>
                        <h3><a href="" class="stretched-link">SABAC</a></h3>
                    </div>
                </div><!-- End Feature Item -->

                <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="250">
                    <div class="features-item">
                        <i class="bi bi-bank" style="color: #29cc61;"></i>
                        <h3><a href="" class="stretched-link">Superior University</a></h3>
                    </div>
                </div><!-- End Feature Item -->

                <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="features-item">
                        <i class="bi bi-cash-coin" style="color: #ffbb2c;"></i>
                        <h3><a href="" class="stretched-link">EduFi</a></h3>
                    </div>
                </div><!-- End Feature Item -->

                <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="350">
                    <div class="features-item">
                        <i class="bi bi-lightning-charge" style="color: #5578ff;"></i>
                        <h3><a href="" class="stretched-link">Apexx</a></h3>
                    </div>
                </div><!-- End Feature Item -->

            </div>

        </div>

    </section><!-- /Features Section -->
    <!-- Courses Section -->
    <section id="courses" class="courses section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Courses</h2>
            <p>Popular Courses</p>
        </div><!-- End Section Title -->

        <div class="container">

            <div class="row">

                <div class="col-lg-4 col-md-6 d-flex align-items-stretch" data-aos="zoom-in" data-aos-delay="100">
                    <div class="course-item">
                        <img src="~/img/course/wordpress.jpg" class="img-fluid" alt="WordPress Course">
                        <div class="course-content">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="category">WordPress</p>
                            </div>

                            <h3><a href="course-details.html">WordPress</a></h3>
                            <p class="description">Learn how to create, customize, and manage professional websites using WordPress.</p>

                            <div class="trainer d-flex justify-content-between align-items-center">
                                <div class="trainer-profile d-flex align-items-center">
                                    <img src="~/img/trainers/zainab1.png" class="img-fluid" alt="Zainab">
                                    <a href="" class="trainer-link">Zainab</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 d-flex align-items-stretch mt-4 mt-md-0" data-aos="zoom-in" data-aos-delay="200">
                    <div class="course-item">
                        <img src="~/img/course/videoediting.jpg" class="img-fluid" alt="Video Editing Course">
                        <div class="course-content">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="category">Video Editing</p>
                            </div>

                            <h3><a href="course-details.html">Video Editing</a></h3>
                            <p class="description">Learn professional video editing skills, transitions, effects, and content creation techniques.</p>

                            <div class="trainer d-flex justify-content-between align-items-center">
                                <div class="trainer-profile d-flex align-items-center">
                                    <img src="~/img/trainers/ayman1.png" class="img-fluid" alt="Ayman">
                                    <a href="" class="trainer-link">Ayman</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 d-flex align-items-stretch mt-4 mt-lg-0" data-aos="zoom-in" data-aos-delay="300">
                    <div class="course-item">
                        <img src="~/img/course/figma.jpg" class="img-fluid" alt="Figma Course">
                        <div class="course-content">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="category">Figma</p>
                            </div>

                            <h3>
                                <a href="course-details.html">
                                    Figma UI/UX
                                </a>
                            </h3>
                            <p class="description">Learn how to design modern user interfaces, wireframes, and prototypes using Figma.</p>

                            <div class="trainer d-flex justify-content-between align-items-center">
                                <div class="trainer-profile d-flex align-items-center">
                                    <img src="~/img/trainers/trainer-2.jpg" class="img-fluid" alt="Sehrish">
                                    <a href="" class="trainer-link">Sehrish</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </section><!-- /Courses Section -->
