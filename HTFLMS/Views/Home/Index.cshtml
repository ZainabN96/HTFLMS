
@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<main>
    <!-- ============ HERO ============ -->
    <section class="hero" id="about">
        <div class="hero__text">
            @* <p class="hero__eyebrow" data-hero="eyebrow">HCC Technology Foundation • Est. 2000</p> *@

            @* <h1 class="hero__title" aria-label="Learn. Build. Grow.">
                <span class="hero__line hero__line--learn"><span class="mask"><span data-hero="line">LEARN</span></span></span>
                <span class="hero__line hero__line--build">
                    <span class="mask"><span data-hero="line">BUILD</span></span>
                    <span class="mask mask--grow"><span class="hero__grow" data-hero="grow">Grow.</span></span>
                </span>
            </h1> *@
            <h1 class="hero-title" aria-label="Learn. Build. Grow.">
                <span class="hero-title-line hero-title-black">
                    <span class="mask"><span data-hero="line">LEARN</span></span>
                </span>

                <span class="hero-title-line hero-title-line--inline">
                    <span class="hero-title-red">
                        <span class="mask"><span data-hero="line">BUILD</span></span>
                    </span>
                    <span class="mask mask--grow">
                        <span class="hero-title-pink" data-hero="grow">Grow.</span>
                    </span>
                </span>
            </h1>

            <p class="hero__para" data-hero="lead">
                Her potential is limitless. With technology education, hands-on skills, and real mentorship, she can build a future that is truly her own.
                @* Every woman deserves the power to shape her own future. We give her the tech skills, the guidance, and the confidence to do it. *@
                @* Her skills. Her voice. Her future. Together, we give young women the education, mentorship, and opportunity to shape it.               *@
                @* We empower women through technology education, practical skills, and mentorship to build a brighter, more independent future. *@
            </p>
        </div>

        <div class="hero__photos" aria-hidden="true">
            <figure class="photo photo--1" data-hero="photo"><img src="~/img/Home/batch.jpeg" alt="" /></figure>
            <figure class="photo photo--2" data-hero="photo"><img src="~/img/Home/EQUITYEVENT 2.JPG" alt="" /></figure>
            <figure class="photo photo--3" data-hero="photo"><img src="~/img/Home/WOMWNSDAY 2025.jpg" alt="" /></figure>
        </div>
    </section>

    <!-- ============ BRIDGE STRIP ============ -->
    <section class="bridge" aria-label="Let’s bridge the gender gap in technology">
        <div class="bridge__track" id="bridgeTrack" aria-hidden="true">
            <div class="bridge__set">
                <span class="bridge__text">Let’s bridge the gender gap in technology</span><i class="bridge__mark"></i>
                <span class="bridge__text">Let’s bridge the gender gap in technology</span><i class="bridge__mark"></i>
                <span class="bridge__text">Let’s bridge the gender gap in technology</span><i class="bridge__mark"></i>
            </div>
        </div>
    </section>

    <!-- ============ ROTATING STATEMENT ============ -->
    <section class="statement" aria-label="What we do">
        <h2 class="swap">
            <span class="swap__row"><span class="swap__mask"><span class="swap__line">We Empower Women To </span></span></span>
            <span class="swap__row">
                <span class="swap__mask"><span class="swap__line">Become&nbsp;</span></span>
                <span class="swap__mask swap__mask--word">
                    <span class="swap__word" id="swapWord" aria-live="polite">
                        <span class="swap__item is-active">Leaders.</span>
                        <span class="swap__item">Coders.</span>
                        <span class="swap__item">Innovators.</span>
                        <span class="swap__item">Trailblazers.</span>
                        @* Future Leaders.Confident Professionals.Skilled Innovators.Industry Trailblazers.
                            <span class="swap__item">brands.</span>
                        <span class="swap__item">users.</span>
                        <span class="swap__item">consumers.</span> *@
                    </span>
                </span>
            </span>
        </h2>
    </section>

    <!-- ============ STATS ============ -->
    <section class="stats" id="courses">
        <h2 class="stats__title serif-title" data-reveal>Number That Tell Our <em>Story</em></h2>
        <p class="stats__sub" data-reveal>
            Together, we are building a brighter future for young women through
            education, mentorship and opportunity.
        </p>

        <div class="stats__grid" id="statsGrid">
            <article class="stat">
                <div class="stat__num" data-value="420" data-suffix="+" aria-label="420+">420+</div>
                <h5>Alumni</h5>
                @* <p class="stat__label">Shaping the future of women in tech.</p> *@
            </article>
            <article class="stat">
                <div class="stat__num" data-value="30" data-suffix="+" aria-label="30+">30+</div>
                <h5>Cohorts</h5>
                @* <p class="stat__label">Skill-based learning for a stronger future.</p> *@
            </article>
            <article class="stat">
                <div class="stat__num" data-value="15" data-suffix="+" aria-label="15+">15+</div>
                <h5>Courses</h5>
                @* <p class="stat__label">Connecting, learning, and growing together.</p> *@
            </article>
            <article class="stat">
                <div class="stat__num" data-value="20" data-suffix="+" aria-label="20+">20+</div>
                <h5>Events</h5>
                @* <p class="stat__label">Creating pathways to new opportunities.</p> *@
            </article>
        </div>

        @* <p class="stats__source" data-reveal>Sources: ProPakistani (2023), Deloitte (2026), Girls Who Code &amp; Accenture</p> *@
    </section>

    <!-- ============ GALLERY ============ -->
    <section class="gallery" id="gallery">
        <div class="gallery__bg" aria-hidden="true"></div>

        <header class="gallery__head">
            <h2 class="gallery__title">
                <span class="gallery__mask"><span class="gallery__l1">Moments from our</span></span>
                <span class="gallery__mask"><span class="gallery__l2">Journey</span></span>
            </h2>
            <a asp-controller="Gallery"
                asp-action="Index" class="btn-ghost gallery__open">Open gallery <span class="arr">→</span></a>
        </header>

        <div class="gallery__viewport">
            <ul class="gallery__track" id="galleryTrack">
                <li class="g-card">
                    <figure>
                        <div class="g-card__img"><img src="~/img/Home/PINKOCT.JPG" alt="Sports week highlights" loading="lazy" /></div>
                        <figcaption>The inspirational guests</figcaption>
                    </figure>
                </li>
                <li class="g-card">
                    <figure>
                        <div class="g-card__img"><img src="~/img/Home/EQUITYEVENT 2.JPG" alt="Mentorship moments" loading="lazy" /></div>
                        <figcaption>Breast Cancer Awareness</figcaption>
                    </figure>
                </li>
                <li class="g-card">
                    <figure>
                        <div class="g-card__img"><img src="~/img/Home/batch.jpeg" alt="Self-defense session" loading="lazy" /></div>
                        <figcaption>Graduation</figcaption>
                    </figure>
                </li>
                <li class="g-card">
                    <figure>
                        <div class="g-card__img"><img src="~/img/Home/WOMWNSDAY 2025.jpg" alt="Celebrating 4 years" loading="lazy" /></div>
                        <figcaption>Sports week highlights</figcaption>
                    </figure>
                </li>
                <li class="g-card">
                    <figure>
                        <div class="g-card__img"><img src="~/img/Home/Home-Journey-08.jpg" alt="Orientation session" loading="lazy" /></div>
                        <figcaption>An inspiring orientation session</figcaption>
                    </figure>
                </li>
            </ul>
        </div>
    </section>

    <!-- ============ TESTIMONIALS ============ -->

    <section class="stories" id="trainers">
        <div class="stories__panel">
            <h2 class="stories__title" data-reveal>Student Success <em>Stories</em></h2>
            <p class="stories__sub" data-reveal>Discover how HTF has helped them grow, upskill, and achieve their goals.</p>

            <div class="stories__stage" id="storiesStage">
                <div class="stories__track" id="storiesTrack">

                    <!-- AMNA SHAFIQ -->
                    <article class="s-card">
                        <div class="s-card__photo">
                            <img class="s-card__bg s-card__bg--1" src="~/img/Amna.jpeg" alt="" loading="lazy" />
                        </div>
                        <div class="s-card__front">
                            <img class="s-card__avatar" src="~/img/Amna.jpeg" alt="Amna Shafiq" />
                            <h3 class="s-card__name">Amna Shafiq</h3>
                            <p class="s-card__role">Software Engineer</p>
                            <p class="s-card__quote">
                                “I’m Amna Shafiq, an IT graduate. I wanted to take my creative skills beyond the basics, so I completed Canva with AI at HCC Technology Foundation, where I learned modern tools, AI-powered design, and best practices. Today, I work as a Trainer at Robotronics.ai and a remote Software Engineer at Vibe Training, UAE.”
                            </p>
                        </div>
                        <p class="s-card__glass-quote" hidden>
                            “Canva with AI at HCC improved my designing skills and helped me learn modern tools and AI in creative design.”
                        </p>
                    </article>

                    <!-- RUBAB -->
                    <article class="s-card">
                        <div class="s-card__photo">
                            <img class="s-card__bg s-card__bg--2" src="~/img/Rubab.png" alt="" loading="lazy" />
                        </div>
                        <div class="s-card__front">
                            <img class="s-card__avatar" src="~/img/Rubab.png" alt="Rubab" />
                            <h3 class="s-card__name">Rubab</h3>
                            <p class="s-card__role">Full Stack Developer</p>
                            <p class="s-card__quote">
                                @* "I’m Rubab, a Computer Science graduate. Programming was never initially my passion, and learning independently was challenging. I completed a Web Development course at HTF, which gave me the guidance I needed. I have now completed two years at Apex Innovation Technology as a Full Stack Web Developer." *@
                                “I’m Rubab, a Computer Science graduate. Programming wasn’t initially my passion, and learning independently was challenging. HTF’s Web Development course gave me the guidance and support I needed. I secured my first opportunity at Apex Innovation Technology, where I grew from Backend Developer to Full Stack Web Developer.”
                            </p>
                        </div>
                        <p class="s-card__glass-quote" hidden>
                            “My journey from struggling with programming to becoming a Full Stack Web Developer was made possible with the support I received at HTF.”
                        </p>
                    </article>

                    <!-- Alisha -->
                    <article class="s-card">
                        <div class="s-card__photo">
                            <img class="s-card__bg s-card__bg--3" src="~/img/AlishaBG.png" alt="" loading="lazy" />
                        </div>
                        <div class="s-card__front">
                            <img class="s-card__avatar" src="~/img/AlishaBG.png" alt="Maryam Yaqoob" />
                            <h3 class="s-card__name">Alisha Maqsood</h3>
                            <p class="s-card__role">SAP Consultant</p>
                            <p class="s-card__quote">
                                “I’m Alisha, a Computer Science graduate. At HCC Technology Foundation, I learned Front-End Development and UI/UX using Figma. I volunteered as an intern to gain experience in Technical Consulting. Today, I work as an SAP Business One and SAP HANA Technical Consultant at HCC Technology Consulting.”
                            </p>
                        </div>
                        <p class="s-card__glass-quote" hidden>
                            “HTF’s Front-End Development training helped me progress from UI/UX design to SAP Technical Consulting professionally.”
                        </p>
                    </article>

                    <!-- Shiza -->
                    <article class="s-card">
                        <div class="s-card__photo">
                            <img class="s-card__bg s-card__bg--4" src="~/img/shiza2.jpeg" alt="" loading="lazy" />
                        </div>
                        <div class="s-card__front">
                            <img class="s-card__avatar" src="~/img/shiza2.jpeg" alt="Alina Mirza" />
                            <h3 class="s-card__name">Shiza Kiran</h3>
                            <p class="s-card__role">UI/UX Designer</p>
                            <p class="s-card__quote">
                                “I’m Shiza Kiran, a Computer Science graduate. I was always passionate about design, but gaining practical experience was initially challenging. My UI/UX volunteership at HCC Technology Foundation helped me improve my skills and build confidence. Today, I’m working at Revolutic as a UI/UX Designer, creating meaningful digital experiences.”
                            </p>
                        </div>
                        <p class="s-card__glass-quote" hidden>
                            “My UI/UX volunteership at HTF helped me gain practical experience and the confidence to pursue my passion for design.”
                        </p>
                    </article>

                    <!-- Iqra -->
                    <article class="s-card">
                        <div class="s-card__photo">
                            <img class="s-card__bg s-card__bg--5" src="~/img/IqraKhan.png" alt="Iqra Khan" loading="lazy" />
                        </div>
                        <div class="s-card__front">
                            <img class="s-card__avatar" src="~/img/IqraKhan.png" alt="iqra khan " />
                            <h3 class="s-card__name">Iqra Khan</h3>
                            <p class="s-card__role">Software Engineer</p>
                            <p class="s-card__quote">
                                “I’m Iqra Khan, a Computer Science graduate. After a career break for motherhood, I restarted my career through HCC Technology Foundation’s C# training in 2022. With support and guidance, I trained and secured an internship in HTF. Today, I’m a Software Engineer at ARVO by Punjab Group.”
                            </p>
                        </div>
                        <p class="s-card__glass-quote" hidden>
                            “HTF’s C# training helped me restart my career after motherhood and become a Software Engineer.”
                        </p>
                    </article>

                   

                   

                   

                </div>
            </div>
        </div>
    </section>

 
    <!-- ============ PARTNERS MARQUEE ============ -->
    <section class="partners" aria-label="Our partners">

        <div class="partners__track" id="partnersTrack">

            <!-- Original Logos -->
            <div class="partners__set">

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-13.png"
                         alt="Walled City of Lahore Authority" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-14.png"
                         alt="EDUFI" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-15.png"
                         alt="Superior University" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-16.png"
                         alt="SABAC" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/apexx.png"
                         alt="Apex Innovation Technology" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-18.png"
                         alt="NUST" />
                </div>

            </div>

            <!-- Duplicate Logos for Seamless Animation -->
            <div class="partners__set" aria-hidden="true">

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-13.png" alt="" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-14.png" alt="" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-15.png" alt="" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-16.png" alt="" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/apexx.png" alt="apex" />
                </div>

                <div class="partners__logo">
                    <img src="~/img/Home/Home-Journey-18.png" alt="" />
                </div>

            </div>

        </div>

    </section>

    <!-- ============ CTA ============ -->
    <section class="cta" id="contact">
        <div class="cta__shape" id="ctaShape">
            <div class="cta__blobs" aria-hidden="true">
                <i class="blob blob--1"></i><i class="blob blob--2"></i><i class="blob blob--3"></i>
            </div>

            <div class="cta__inner">
                <h2 class="cta__title" aria-label="Ready to start?">
                    <span class="cta__row"><span class="cta__words" data-split>Ready to</span></span>
                    <span class="cta__row cta__row--italic"><span class="cta__start" data-split-italic>start</span><span class="cta__q">?</span></span>
                </h2>

                <div class="cta__btnwrap">
                    @* <span class="ring ring--1" aria-hidden="true"></span>
                    <span class="ring ring--2" aria-hidden="true"></span>
                    <span class="ring ring--3" aria-hidden="true"></span> *@
                    <a   asp-controller ="Contact"
                       asp-action="ContactIndex"
                       class="cta__btn" id="ctaBtn">
                        <span class="cta__btn-fill" aria-hidden="true"></span>
                        <span class="cta__btn-label">Let’s talk</span>
                        <svg class="cta__btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>