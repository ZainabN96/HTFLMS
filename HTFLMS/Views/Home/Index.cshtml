                        <div class="s-card__front">
                            <img class="s-card__avatar" src="~/img/Home/Home-Journey-09.png" alt="Ayesha Farman" />
                            <h3 class="s-card__name">Ayesha Farman</h3>
                            <p class="s-card__role">UI/UX Designer</p>
