@{
    ViewData["Title"] = "Gallery";
}

@section Styles {
    @* Existing stylesheet should already be loaded by Layout.
       Gallery CSS is appended to that same stylesheet. *@
}

<main class="htf-gallery" id="galleryPage">

    <section class="htf-gallery__hero">
        <div class="htf-gallery__intro">
            @* <h1 class="htf-gallery__heading">
                <span class="htf-gallery__script">Moments</span>
                <span class="htf-gallery__heading-line">FROM OUR</span>
                <span class="htf-gallery__heading-line">JOURNEY</span>
            </h1> *@
            <h1 class="hero-title hero-title--md">
                <span class="hero-title-line hero-title-black">OUR</span>
                <span class="hero-title-line hero-title-pink">journey</span>
            </h1>
            <p class="hero__para">
                A glimpse into the lives we're shaping through
                technology and education. Every photo is a
                milestone of empowerment, collaboration and hope.
            </p>

            @* <div class="htf-gallery__filters"
                 role="group"
                 aria-label="Filter gallery">
                <button type="button"
                        class="htf-gallery__filter is-active"
                        data-filter="all"
                        aria-pressed="true">
                    All
                </button>

                <button type="button"
                        class="htf-gallery__filter"
                        data-filter="highlighted"
                        aria-pressed="false">
                    Highlighted
                </button>
            </div> *@
        </div>

        <div class="htf-gallery__visual"
             aria-label="Empowering future tech">
            <div class="htf-gallery__orbit">
                <span class="htf-gallery__orbit-label htf-gallery__orbit-label--top">
                    <span class="htf-gallery__dot"></span>
                    Innovation Hub
                </span>

                <div class="htf-gallery__circle">
                    <span class="htf-gallery__circle-caption">
                        EMPOWERING FUTURE TECH
                    </span>
                    <span class="htf-gallery__circle-title">
                        Inspire. Learn. Lead.
                    </span>
                </div>

                <span class="htf-gallery__orbit-label htf-gallery__orbit-label--bottom">
                    4+ Yrs Empowering Youth
                </span>
            </div>
        </div>
    </section>

    <section class="htf-gallery__content"
             aria-label="Our gallery moments">

        <div class="htf-gallery__grid" id="galleryGrid">

          

            <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/8march4.JPG"
                         alt="International Women's Day celebration"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>Empowering Women, Transforming Tomorrow</h2>
                    <p>
                        From writing code to creating change, we celebrate the talent, determination, and limitless potential of women in technology. Together, we are building a future where every woman has the opportunity to learn, lead, innovate, and make her mark.
                    </p>
                </div>
            </article>
            <article class="htf-gallery__card"
                     data-category="highlighted">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/DR-Arfa.JPG"
                         alt="Inspirational chief guest visit"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>The Inspirational Chief Guest, Dr. Arfa Syeda Zehra</h2>
                    <p>
                        Dr. Arfa Syeda Zehra's spirit on analysis on
                        gender parity in the occasion of IWD 2023,
                        on the event organised by HTF.
                    </p>
                </div>
            </article>
            <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/FigmaVolunteers.png"
                         alt="Students participating in collaborative learning"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>Creative Ideas, Real-World Designs</h2>
                    <p>
                        From initial concepts to interactive prototypes, our UI/UX interns present their creative projects, showcasing their design skills, problem-solving abilities, and growing understanding of user-centered experiences. A proud moment celebrating creativity, progress, and practical learning.
                    </p>
                </div>
            </article>

      
            <article class="htf-gallery__card"
                     data-category="highlighted">
                <div class="htf-gallery__image">
                    <span class="htf-gallery__image-tag">
                        HIGHLIGHTED MOMENTS
                    </span>
                    <img src="~/img/Gallery/SELF DEFENCE SESSION.jpg"
                         alt="Self-defense training session"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>
                        Self-defense session with Martial Arts
                        
                    </h2>
                    <p>
                        The session covered basic self-defense skills and practical defense techniques. Students learned ways to stay safe, build confidence, and respond to challenging situations.
                    </p>
                </div>
            </article>
           

            <article class="htf-gallery__card"
                     data-category="highlighted">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/Graduation1.jpeg"
                         alt="Foundation anniversary group photograph"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>
                        Celebrating Achievements, Inspiring New Beginnings
                    </h2>
                    <p>
                        A memorable celebration of hard work, dedication, and success as students proudly mark the completion of their learning journey. The ceremony honors their achievements and inspires them to step confidently into new opportunities.
                    </p>
                </div>
            </article>
            <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/Namal2.JPG"
                         alt="Mentorship session"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>Mentorship Moments</h2>
                    <p>Moments from our mentorship session at NAMAL University, Mianwali, sharing knowledge, guidance, and career insights with students. Inspiring young minds to explore new opportunities and grow with confidence.</p>
                </div>
            </article>
            <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/PINK OCT 2.JPG"
                         alt="Special artist visit"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>Raising Awareness, Inspiring Early Detection</h2>
                    <p>
                        An empowering session dedicated to breaking the silence around breast cancer, spreading awareness about early warning signs, and highlighting the importance of self-examination, regular screening, and timely medical care
                    </p>
                </div>
            </article>

            @* <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/images/gallery/team-building.jpg"
                         alt="Team building activities"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>Mountains, motivation, and memories</h2>
                    <p>
                        Team Building Activity in Murree brought
                        the entire team together for some
                        well-deserved fun, reflection, and bonding.
                    </p>
                </div>
            </article> *@
            <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/SUPERIOR UNI.jpg"
                         alt="Team building activities"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>HTF & Superior University Join Hands</h2>
                    <p>
                        A meaningful partnership focused on connecting education with industry through skill development, practical learning, and career opportunities. The MOU marks a shared commitment to empowering students and preparing them for a successful professional future.
                    </p>
                </div>
            </article>

            <article class="htf-gallery__card"
                     data-category="all">
                <div class="htf-gallery__image">
                    <img src="~/img/Gallery/CMIT1.jpeg"
                         alt="Sports week activities"
                         loading="lazy" />
                </div>
                <div class="htf-gallery__card-body">
                    <h2>
                         From Learning to Achievement
                        CMIT Final Project Showcase
                    </h2>
                    <p>
                        A proud milestone as CMIT interns present their final projects, demonstrating the skills, creativity, and practical knowledge gained throughout their internship. A celebration of growth, hard work, and the journey from learning to real-world experience..
                    </p>
                </div>
            </article>

        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/Website/Gallery.js" asp-append-version="true"></script>
}
