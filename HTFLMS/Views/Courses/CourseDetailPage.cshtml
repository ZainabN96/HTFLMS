@{
    ViewData["Title"] = "Web Development";
    Layout = "_Layout";
}

<main class="main">
    <div class="htf-cd">
        <script>document.currentScript.parentNode.classList.add('htf-cd--js');</script>

        <div class="htf-cd__page">

            <header class="htf-cd__head">
                <h1 class="hero-title htf-cd__up" aria-label="Web Development">
                    <span class="hero-title-line hero-title-black">Web</span>
                    <span class="hero-title-line hero-title-pink">Development</span>
                </h1>
                <p class="htf-cd__summary htf-cd__up">Learn modern web development from scratch and gain hands-on experience with real-world projects. Master HTML, CSS, JavaScript, React and more to create dynamic and responsive websites.</p>
                @* <div class="htf-cd__byline htf-cd__up">
                    <span class="htf-cd__avatar" aria-hidden="true">NN</span>
                    <p>Taught by <b>Dr. M Nouman Noor</b><br>Lead Web Engineer, Course Director</p>
                </div> *@

            </header>

            <aside class="htf-cd__aside htf-cd__up" aria-label="Enrolment">
                <div class="htf-cd__enrol">
                    <span class="htf-cd__free">Free to enrol</span>
                    <h2>Reserve your seat</h2>
                    <a class="htf-cd__btn" asp-controller="Account" asp-action="Login">Enroll now <span class="htf-cd__arr">&rarr;</span></a>
                    <div class="htf-cd__cohort">
                        <i><svg class="htf-cd__ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg></i>
                        <div><small>Next cohort</small><b>4 March 2027</b><span>Once in a week · Onsite</span></div>
                    </div>

                    <ul class="htf-cd__rows">
                        <li>
                            <span>
                                <svg class="htf-cd__ico" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="M12 7v5l3 2" />
                                </svg>
                                Duration
                            </span>
                            <b>12 weeks</b>
                        </li>
                        <li>
                            <span>
                                <svg class="htf-cd__ico" viewBox="0 0 24 24">
                                    <path d="M5 20v-5M12 20V9M19 20V4" />
                                </svg>
                                Level
                            </span>
                            <b>Beginner to Advanced</b>
                        </li>
                        <li>
                            <span>
                                <svg class="htf-cd__ico" viewBox="0 0 24 24">
                                    <path d="M4 5h9M4 9h6M12 20l4-10 4 10M13.5 16.5h5" />
                                </svg>
                                Language
                            </span>
                            <b>Urdu / English</b>
                        </li>

                        <li>
                            <span>
                                <svg class="htf-cd__ico" viewBox="0 0 24 24">
                                    <path d="M2 9l10-5 10 5-10 5z" />
                                    <path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" />
                                </svg>
                                Certificate
                            </span>
                            <b>Yes</b>
                        </li>

                    </ul>

                </div>

                @* <div class="htf-cd__help">
                    <h4>Need help deciding?</h4>
                    <p>Talk to an advisor about the pace, or whether this is the right starting point.</p>
                    <a href="/Contact">Contact our team <span class="htf-cd__arr">&rarr;</span></a>
                </div> *@
            </aside>

            <div class="htf-cd__main">
                <nav class="htf-cd__tabs htf-cd__up" aria-label="Course sections">
                    <span class="htf-cd__ind" aria-hidden="true"></span>
                    <a href="#overview" class="is-active">Overview</a>
                    <a href="#curriculum">Curriculum</a>
                    <a href="#requirements">Requirements</a>
                    <a href="#instructor">Instructor</a>
                </nav>

                <section class="htf-cd__panel htf-cd__rv" id="overview">
                    <span class="htf-cd__eyebrow">Overview</span>


                    <h2 class="htf-cd__title">
                        <span class="hero-title-black">More than just a </span>
                        <span class="hero-title-pink">course</span>
                    </h2>

                    <div class="htf-cd__prose">
                        <p>Most traditional courses hand you a syllabus and a video playlist. HTF puts you in a live interactive environment, learning directly from industry mentors who review and critique your actual work.</p>
                        <p>The first six weeks build the fundamentals in sequence: structure with HTML, layout with CSS, then the language itself. The last six weeks are a studio block. You pick one product brief, build it in public, and get a written critique every Friday until it ships.</p>
                    </div>
                    <p class="htf-cd__pull">“We believe one real-world project you can confidently showcase is worth more than a dozen unfinished tutorials.”</p>

                    <div class="htf-cd__sub">By the end of week 12</div>
                    <ul class="htf-cd__wins">
                        <li class="htf-cd__win"><i><svg class="htf-cd__ico" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></i><b>Ship three real projects</b><span>A responsive marketing page, a data-driven dashboard and a deployed portfolio you can show in interviews.</span></li>
                        <li class="htf-cd__win"><i><svg class="htf-cd__ico" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></i><b>Work from a design file</b><span>Translate a Figma screen into accessible, responsive markup without guessing at spacing.</span></li>
                        <li class="htf-cd__win"><i><svg class="htf-cd__ico" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></i><b>Read a codebase with confidence</b><span>Debug in the browser, follow a component tree and review pull requests without panic.</span></li>
                        <li class="htf-cd__win"><i><svg class="htf-cd__ico" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></i><b>Launch your reviewed portfolio</b><span>A one-to-one critique with your mentor on the final week, plus a certificate on completion.</span></li>
                    </ul>
                </section>

                <section class="htf-cd__panel htf-cd__rv" id="curriculum">
                    <span class="htf-cd__eyebrow">Curriculum</span>
                    <h2 class="htf-cd__title">
                        <span class="hero-title-black">Explore the course</span>
                        <span class="hero-title-pink">curriculum</span>
                    </h2>                    
                    <p class="htf-cd__lead">Each module ends with a small build you keep. The final six weeks are a studio block: your own project, reviewed weekly.</p>

                    <div class="htf-cd__tl">
                        <article class="htf-cd__mod">
                            <div class="htf-cd__wk">Module 1 · Weeks 1–6</div>
                            <h4>Fundamentals, in sequence</h4>
                            <p>Structure with HTML, layout with CSS, then the language itself.</p>
                            <div class="htf-cd__steps"><span>HTML</span><span>CSS</span><span>JavaScript</span></div>
                        </article>
                        <article class="htf-cd__mod">
                            <div class="htf-cd__wk">Module 2 · Weeks 7–12</div>
                            <h4>Project studio</h4>
                            <p>Pick one product brief, build it in public and get a written critique every Friday until it ships.</p>
                            <div class="htf-cd__steps"><span>Product brief</span><span>Build in public</span><span>Weekly critique</span></div>
                        </article>
                    </div>

                    <div class="htf-cd__handbook">
                        <div>
                            <i><svg class="htf-cd__ico" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg></i>
                            <p><b>Web-Development Handbook</b><span>How the web actually works, and the tools you will use every day.</span></p>
                        </div>
                        <nav><a class="htf-cd__btn htf-cd__btn--ghost htf-cd__btn--sm" href="#">View</a><a class="htf-cd__btn htf-cd__btn--sm" href="#">Download</a></nav>
                    </div>
                </section>

                <section class="htf-cd__panel htf-cd__rv" id="requirements">
                    <span class="htf-cd__eyebrow">Requirements</span>
                    <h2 class="htf-cd__title">
                        <span class="hero-title-black">What you need to</span>
                        <span class="hero-title-pink">start</span>
                    </h2>                  
                    <ul class="htf-cd__reqs">
                        <li><b>Laptop</b><span>Any machine from the last six years, macOS, Windows or Linux.</span></li>
                        <li><b>Connection</b><span>A stable 5 Mbps connection for the two live sessions each week.</span></li>
                        <li><b>Prior experience</b><span>None required. Comfort with a keyboard and file folders is enough.</span></li>
                        <li><b>Tools</b><span>VS Code, Node.js and a GitHub account, all free, installed in lesson two.</span></li>
                    </ul>
                </section>

                <section class="htf-cd__panel htf-cd__rv" id="instructor">
                    <span class="htf-cd__eyebrow">Instructor</span>
                    <h2 class="htf-cd__title">
                        <span class="hero-title-black">Taught by industry</span>
                        <span class="hero-title-pink">experts</span>
                    </h2>                    <div class="htf-cd__teacher">
                        <div class="htf-cd__tcard">
                            <span class="htf-cd__avatar" aria-hidden="true">NN</span>
                            <b>Dr. M Nouman Noor</b>
                            <span>Lead Web Engineer, Course Director</span>
                        </div>
                        <div class="htf-cd__tbody">
                            <p>Dr. Nouman Noor has spent twelve years building front-end systems for banks, logistics companies and early-stage products across the Gulf. He teaches the way he reviews code: plainly, patiently, and always with the browser open.</p>
                            <p class="htf-cd__pull">
                                "Your journey starts with one brave step. Keep practicing, challenge your limits, and turn every small victory into lasting confidence.",
                            </p>
                            @* <div class="htf-cd__stats">
                                <div><b>12 years</b><span>Building for the web</span></div>
                                <div><b>1,240</b><span>Students taught</span></div>
                                <div><b>4.9</b><span>Average rating</span></div>
                            </div> *@
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <div class="htf-cd__bar">
            <div><b>Web Development</b><small>Free to enrol · Next cohort 4 March 2027</small></div>
            <a class="htf-cd__btn htf-cd__btn--sm" asp-controller="Account" asp-action="Login">Enroll now</a>
        </div>
        <!-- CTA BAND -->
        <section class="htf-courses__cta-wrap">
            <div class="htf-courses__cta">
                <svg class="htf-courses__cap" viewBox="0 0 90 70" aria-hidden="true">
                    <path d="M45 6L2 26l43 20 43-20z" fill="#1d1d1f" />
                    <path d="M20 38v14c0 6 11 12 25 12s25-6 25-12V38l-25 12z" fill="#2a2a2d" />
                    <path d="M80 30v22" stroke="#f2b600" stroke-width="3" />
                    <rect x="77" y="50" width="6" height="14" rx="2" fill="#f2b600" />
                </svg>
                <div class="htf-courses__cta-text">
                    <h2>Let's Clear Your Doubts</h2>
                    <p>Talk to an advisor about the pace, or whether this is the right starting point.</p>
                </div>
                <a asp-controller="Contact" asp-action="ContactIndex" class="htf-courses__cta-btn">Get Expert Guidance</a>
            </div>
        </section>
    </div>
</main>

<script src="~/js/Website/htf-course-detail.js"></script>