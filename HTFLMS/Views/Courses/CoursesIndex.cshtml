@model List<HTFLMS.Models.Course>
@{
    ViewData["Title"] = "Courses";
    Layout = "_Layout";
}

<main class="main">

    <div class="page-title page-title-courses" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1>Courses</h1>
                        <p class="mb-0">Explore our courses and start learning today.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section id="courses" class="courses section">
        <div class="container">
            <div class="row g-4">

                @if (Model == null || Model.Count == 0)
                {
                    <div class="col-12">
                        <div class="text-center p-5">
                            <h4>No courses available yet</h4>
                            <p class="mb-0">Please check back soon.</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <div class="col-lg-4 col-md-6 d-flex align-items-stretch"
                             data-aos="zoom-in" data-aos-delay="100">
                            <div class="course-item">

                                <img src="@(string.IsNullOrWhiteSpace(c.CourseImagePath)
                                                                                                                  ? Url.Content("~/img/course/course-2.webp")
                                                                                                                  : c.CourseImagePath)"
                                                                                                                                      class="img-fluid course-cover" alt="">

                                <div class="course-content">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <p class="category">@c.Category</p>
                                        @* price removed because your DB course has no price field *@
                                    </div>

                                    <h3><a href="#">@c.Title</a></h3>

                                    <p class="description">
                                        @(string.IsNullOrWhiteSpace(c.Description)
                                                                        ? "Course description coming soon."
                                                                        : c.Description)
                            </p>

                                    @* <div class="text-center mt-3 mb-3">
                                        <a asp-controller="Account"
                                           asp-action="Login"
                                           class="btn btn-danger sub-btn">
                                            Enroll Now
                                        </a>
                                    </div> *@
                                    <div class="text-center mt-3 mb-3">
                                        <a asp-area="Student"
                                           asp-controller="Courses"
                                           asp-action="EnrollDetail"
                                           asp-route-id="@c.Id"
                                           class="btn btn-danger sub-btn">
                                            Enroll Now
                                        </a>
                                    </div>

                                    <div class="trainer d-flex justify-content-between align-items-center">
                                        <div class="trainer-profile d-flex align-items-center">
                                            <img src="~/img/trainers/trainer-2.jpg" class="img-fluid" alt="">
                                            @* <a href="#" class="trainer-link">@c.Trainer</a> *@
                                            <a href="#" class="trainer-link">@(c.Trainer != null ? c.Trainer.Name : "No Trainer")</a>
                                        </div>
                                        <div class="trainer-rank d-flex align-items-center">
                                            <i class="bi bi-person user-icon"></i>&nbsp;35
                                            &nbsp;&nbsp;
                                            <i class="bi bi-heart heart-icon"></i>&nbsp;42
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                                }
                }

            </div>
        </div>
    </section>
</main>