<section class="htf-courses__listing" id="courses">

    <div class="htf-courses__toolbar">

        <div class="htf-courses__filters" id="htfCoursesFilters">
            <button type="button"
                    class="htf-courses__filter is-active"
                    data-filter="all"
                    aria-pressed="true">
                All
            </button>

            @foreach (var cat in categories)
            {
                <button type="button"
                        class="htf-courses__filter"
                        data-filter="@cat.ToLowerInvariant()"
                        aria-pressed="false">
                    @cat
                </button>
            }
        </div>

        <div class="htf-courses__search">
            <label for="htfCoursesSearch" class="htf-courses__sr">
                Search courses
            </label>

            <svg viewBox="0 0 24 24"
                 width="18"
                 height="18"
                 aria-hidden="true">
                <circle cx="11" cy="11" r="7"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2" />

                <path d="M20 20l-3.5-3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />
            </svg>

            <input type="search"
                   id="htfCoursesSearch"
                   placeholder="Search courses"
                   autocomplete="off">
        </div>

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="htf-courses__empty">
            <h4>No courses available yet</h4>
            <p>Please check back soon.</p>
        </div>
    }
    else
    {
        <div class="htf-courses__grid" id="htfCoursesGrid">

            @foreach (var c in Model)
            {
                <article class="htf-courses__card"
                         tabindex="0"
                         role="link"
                         aria-label="View details for @c.Title"
                         data-detail-url="@Url.Action("CourseDetailPage", "Courses", new {  id = c.Id })"
                         data-category="@(c.Category?.Trim().ToLowerInvariant())"
                         data-search="@((c.Title + " " + c.Category + " " + c.Trainer?.Name).ToLowerInvariant())">

                    <div class="htf-courses__media">
                        <img src="@(string.IsNullOrWhiteSpace(c.CourseImagePath)
                            ? Url.Content("~/img/course/course-2.webp")
                            : c.CourseImagePath)"
                             alt="@c.Title"
                             loading="lazy">
                    </div>

                    <div class="htf-courses__glass">
                        <span class="htf-courses__tag">
                            @c.Category
                        </span>

                        <h3 class="htf-courses__name">
                            @c.Title
                        </h3>
                    </div>

                    <div class="htf-courses__panel">

                        <h3 class="htf-courses__panel-title">
                            @c.Title
                        </h3>

                        <p class="htf-courses__panel-text">

                            @if (c.Trainer != null &&
                                 !string.IsNullOrWhiteSpace(c.Trainer.Name))
                            {
                                <strong>By @c.Trainer.Name</strong>
                                <br />
                            }

                            @(string.IsNullOrWhiteSpace(c.Description)
                                ? "Course description coming soon."
                                : c.Description)

                        </p>

                        <!-- Enroll Now -> Login Page -->
                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Login"
                           class="htf-courses__enroll">
                            Enroll Now
                            <span aria-hidden="true">&rarr;</span>
                        </a>

                    </div>

                </article>
            }

        </div>

        <div class="htf-courses__empty"
             id="htfCoursesNoMatch"
             hidden>
            <h4>No matching courses</h4>
            <p>Try a different search or category.</p>
        </div>
    }

</section>



        <!-- CTA BAND -->
        <section class="htf-courses__cta-wrap">
            <div class="htf-courses__cta">
                <svg class="htf-courses__cap" viewBox="0 0 90 70" aria-hidden="true">
                    <path d="M45 6L2 26l43 20 43-20z" fill="#1d1d1f" />
                    <path d="M20 38v14c0 6 11 12 25 12s25-6 25-12V38l-25 12z" fill="#2a2a2d" />
                    <path d="M80 30v22" stroke="#f2b600" stroke-width="3" />
                    <rect x="77" y="50" width="6" height="14" rx="2" fill="#f2b600" />
                </svg>
                <div class="htf-courses__cta-text">
                    <h2>You have the power to change your future</h2>
                    <p>We're here to help you every step of the way</p>
                </div>
                <a asp-controller="Account" asp-action="Login" class="htf-courses__cta-btn">Join HCC LMS Now</a>
            </div>
        </section>

    </div>
</main>

<script src="~/js/Website/Course.js" asp-append-version="true"></script>