@{
    ViewData["Title"] = "Add Student";
    Layout = "_TrainerLayout";
}

<div class="dashboard-page trainer-student-form-page">
    <div class="dashboard-page-head trainer-courses-page-head">
        <div>
            <h1 class="dashboard-h1" id="pageTitle">Add Student</h1>
            <p class="dashboard-sub" id="pageSub">Register or enroll a student into your assigned courses.</p>
        </div>

        <div class="dashboard-head-actions">
            <a asp-area="Trainer"
               asp-controller="Students"
               asp-action="Index"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Students
            </a>
        </div>
    </div>

    <div class="dashboard-panel trainer-student-form-panel">
        <form id="studentForm" class="trainer-student-form">
            <input type="hidden" id="studentId" value="@ViewBag.StudentId" />

            <div class="trainer-student-form-top">
                <div class="trainer-student-form-main">
                    <div class="trainer-student-form-grid">

                        <div class="trainer-student-form-group trainer-student-form-group-full">
                            <label class="trainer-student-label">Student Name</label>
                            <input type="text" id="name" class="course-input" placeholder="Enter student name" required />
                        </div>

                        <div class="trainer-student-form-group">
                            <label class="trainer-student-label">Email Address</label>
                            <input type="email" id="email" class="course-input" placeholder="Enter email address" required />
                        </div>

                        <div class="trainer-student-form-group">
                            <label class="trainer-student-label">Password</label>
                            <input type="password" id="password" class="course-input" placeholder="Required for new student" />
                        </div>

                        <div class="trainer-student-form-group">
                            <label class="trainer-student-label">Status</label>
                            <select id="status" class="course-input" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>

                        <div class="trainer-student-form-group">
                            <label class="trainer-student-label">Join Date</label>
                            <input type="date" id="joinDate" class="course-input" />
                        </div>

                        <div class="trainer-student-form-group trainer-student-form-group-full">
                            <label class="trainer-student-label">Enrolled Courses</label>
                            <div class="course-select-list" id="courseSelectList">
                                <div class="dashboard-muted-small">Loading courses...</div>
                            </div>
                        </div>
                    </div>

                    <div class="text-danger small mb-2 error-box"></div>

                    <div class="trainer-student-form-actions">
                        <a asp-area="Trainer"
                           asp-controller="Students"
                           asp-action="Index"
                           class="dashboard-btn dashboard-btn-outline">
                            Cancel
                        </a>

                        <button type="submit" id="saveStudentBtn" class="dashboard-btn add-course-btn">
                            Save Student
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ManageStudent/addEditStudent.js"></script>
}