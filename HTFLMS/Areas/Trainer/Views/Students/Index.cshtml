@{
    ViewData["Title"] = "Students";
    Layout = "_TrainerLayout";
}

<div class="dashboard-page trainer-students-page">
    <div class="dashboard-page-head trainer-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Students</h1>
            <p class="dashboard-sub">Manage all registered students and their course enrollments.</p>
        </div>

        <div class="trainer-courses-head-actions">
            <div class="courses-head-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search students..." />
            </div>

            <a asp-area="Trainer"
               asp-controller="Students"
               asp-action="Create"
               class="dashboard-btn add-course-btn trainer-add-course-btn">
                <i class="bi bi-plus-circle"></i>
                Add Student
            </a>
        </div>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Students</div>
                <i class="bi bi-people"></i>
            </div>
            <div class="dashboard-stat-value">128</div>
            <div class="dashboard-stat-meta">Registered students</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Active Students</div>
                <i class="bi bi-person-check"></i>
            </div>
            <div class="dashboard-stat-value">96</div>
            <div class="dashboard-stat-meta">Currently active</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">At Risk</div>
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <div class="dashboard-stat-value">18</div>
            <div class="dashboard-stat-meta">Need attention</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Inactive Students</div>
                <i class="bi bi-person-x"></i>
            </div>
            <div class="dashboard-stat-value">14</div>
            <div class="dashboard-stat-meta">Not currently active</div>
        </div>
    </div>

    <div class="dashboard-panel trainer-students-filter-panel">
        <div class="trainer-students-filter-row">
            <select class="course-input trainer-students-select">
                <option>All courses</option>
                <option>Web Development</option>
                <option>Digital Marketing</option>
                <option>Graphic Design</option>
            </select>

            <select class="course-input trainer-students-select">
                <option>All statuses</option>
                <option>Active</option>
                <option>At Risk</option>
                <option>Inactive</option>
            </select>
        </div>
    </div>

    <div class="dashboard-panel trainer-students-table-panel">
        <div class="dashboard-panel-head">
            <div class="dashboard-panel-title">All Students</div>
            <div class="dashboard-muted-small">5 student(s)</div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row dashboard-table-head trainer-students-table-row trainer-students-table-head">
                <div>Student</div>
                <div>Email</div>
                <div>Enrolled courses</div>
                <div>Avg grade</div>
                <div>Joined</div>
                <div>Status</div>
                <div>Actions</div>
            </div>

            <div class="dashboard-table-row trainer-students-table-row">
                <div class="trainer-student-main">
                    <div class="trainer-student-avatar trainer-avatar-pink">D</div>
                    <div class="trainer-student-name-wrap">
                        <div class="trainer-student-name">daudrana400</div>
                    </div>
                </div>
                <div>daudrana400@gmail.com</div>
                <div>3 courses</div>
                <div class="trainer-grade-good">93.7%</div>
                <div>Jan 10, 2026</div>
                <div><span class="dashboard-status status-active">Active</span></div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Students"
                       asp-action="Edit"
                       asp-route-id="1"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>
                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-students-table-row">
                <div class="trainer-student-main">
                    <div class="trainer-student-avatar trainer-avatar-blue">A</div>
                    <div class="trainer-student-name-wrap">
                        <div class="trainer-student-name">Ali Hassan</div>
                    </div>
                </div>
                <div>ali.hassan@gmail.com</div>
                <div>2 courses</div>
                <div class="trainer-grade-good">87.2%</div>
                <div>Jan 15, 2026</div>
                <div><span class="dashboard-status status-active">Active</span></div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Students"
                       asp-action="Edit"
                       asp-route-id="2"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>
                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-students-table-row">
                <div class="trainer-student-main">
                    <div class="trainer-student-avatar trainer-avatar-purple">S</div>
                    <div class="trainer-student-name-wrap">
                        <div class="trainer-student-name">Sara Malik</div>
                    </div>
                </div>
                <div>sara.malik@gmail.com</div>
                <div>1 course</div>
                <div class="trainer-grade-warn">74.5%</div>
                <div>Feb 2, 2026</div>
                <div><span class="dashboard-status status-warning">At Risk</span></div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Students"
                       asp-action="Edit"
                       asp-route-id="3"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>
                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-students-table-row">
                <div class="trainer-student-main">
                    <div class="trainer-student-avatar trainer-avatar-green">O</div>
                    <div class="trainer-student-name-wrap">
                        <div class="trainer-student-name">Omar Sheikh</div>
                    </div>
                </div>
                <div>omar.sheikh@gmail.com</div>
                <div>2 courses</div>
                <div class="trainer-grade-good">91.0%</div>
                <div>Feb 8, 2026</div>
                <div><span class="dashboard-status status-active">Active</span></div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Students"
                       asp-action="Edit"
                       asp-route-id="4"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>
                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-students-table-row">
                <div class="trainer-student-main">
                    <div class="trainer-student-avatar trainer-avatar-rose">H</div>
                    <div class="trainer-student-name-wrap">
                        <div class="trainer-student-name">Hina Rao</div>
                    </div>
                </div>
                <div>hina.rao@gmail.com</div>
                <div>3 courses</div>
                <div class="trainer-grade-danger">61.3%</div>
                <div>Mar 1, 2026</div>
                <div><span class="dashboard-status status-inactive">Inactive</span></div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Students"
                       asp-action="Edit"
                       asp-route-id="5"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>
                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>