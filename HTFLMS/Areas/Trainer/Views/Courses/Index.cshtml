@{
    ViewData["Title"] = "My Courses";
    Layout = "_TrainerLayout";
}

<div class="dashboard-page trainer-courses-page">
    <div class="dashboard-page-head trainer-courses-page-head">
        <div>
            <h1 class="dashboard-h1">My Courses</h1>
            <p class="dashboard-sub">Manage your assigned courses, modules, and lessons.</p>
        </div>

        <div class="trainer-courses-head-actions">
            <div class="courses-head-search">
                <i class="bi bi-search"></i>
                <input type="text" id="courseSearchInput" placeholder="Search courses..." />
            </div>

            <a asp-area="Trainer"
               asp-controller="Courses"
               asp-action="Create"
               class="dashboard-btn add-course-btn trainer-add-course-btn">
                <i class="bi bi-plus-circle"></i> Add Course
            </a>
        </div>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Courses</div>
                <i class="bi bi-journal-bookmark"></i>
            </div>
            <div class="dashboard-stat-value" id="totalCoursesCount">0</div>
            <div class="dashboard-stat-meta">Assigned to you</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Active Courses</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value" id="activeCoursesCount">0</div>
            <div class="dashboard-stat-meta">Currently running</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Draft Courses</div>
                <i class="bi bi-pencil-square"></i>
            </div>
            <div class="dashboard-stat-value" id="draftCoursesCount">0</div>
            <div class="dashboard-stat-meta">Needs completion</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Students</div>
                <i class="bi bi-people"></i>
            </div>
            <div class="dashboard-stat-value" id="totalStudentsCount">0</div>
            <div class="dashboard-stat-meta">Across all courses</div>
        </div>
    </div>

    <div class="dashboard-panel trainer-courses-table-panel">
        <div class="dashboard-panel-head">
            <div class="dashboard-panel-title">All Courses</div>
            <div class="dashboard-muted-small" id="courseCountText">0 course(s)</div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row dashboard-table-head courses-table-row trainer-courses-table-head">
                <div>Title</div>
                <div>Category</div>
                <div>Students</div>
                <div>Status</div>
                <div>Created</div>
                <div>Actions</div>
            </div>

            <div id="coursesTableBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/Course/index.js"></script>
}