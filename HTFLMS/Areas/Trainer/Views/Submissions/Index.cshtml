@{
    ViewData["Title"] = "All Submissions";
    Layout = "_TrainerLayout";
}

<div class="dashboard-page trainer-content-page trainer-submissions-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">All Submissions</h1>
            <p class="dashboard-sub">Review student submissions across your assigned courses and modules.</p>
        </div>
    </div>

    <!-- STATS -->
    <div class="dashboard-stats trainer-content-stats trainer-submissions-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Submissions</div>
                <i class="bi bi-inbox"></i>
            </div>
            <div class="dashboard-stat-value" id="trainerSubmissionTotal">0</div>
            <div class="dashboard-stat-meta">Across all assigned courses</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Graded</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value" id="trainerSubmissionGraded">0</div>
            <div class="dashboard-stat-meta">Reviewed and graded</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Pending</div>
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="dashboard-stat-value" id="trainerSubmissionPending">0</div>
            <div class="dashboard-stat-meta">Waiting for grading</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Missing / Not Submitted</div>
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <div class="dashboard-stat-value" id="trainerSubmissionMissing">0</div>
            <div class="dashboard-stat-meta">No student submission yet</div>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="dashboard-panel trainer-content-panel trainer-submissions-filter-panel">
        <div class="dashboard-panel-head trainer-content-panel-head trainer-submissions-filter-head">
            <div class="dashboard-panel-title">
                Search & Filter
            </div>

            <div class="courses-head-search trainer-submissions-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="trainerSubmissionSearch"
                       placeholder="Search student or assignment..." />
            </div>
        </div>

        <div class="trainer-submissions-filter-row">
            <select class="course-input trainer-inline-select trainer-submissions-select"
                    id="trainerSubmissionCourseFilter">
                <option value="">All courses</option>
            </select>

            <select class="course-input trainer-inline-select trainer-submissions-select"
                    id="trainerSubmissionModuleFilter">
                <option value="">All modules</option>
            </select>

            <select class="course-input trainer-inline-select trainer-submissions-select"
                    id="trainerSubmissionStatusFilter">
                <option value="">All statuses</option>
                <option value="Graded">Graded</option>
                <option value="Pending">Pending</option>
                <option value="Not Submitted">Not Submitted</option>
            </select>
        </div>
    </div>

    <!-- TABLE -->
    <div class="dashboard-panel trainer-content-panel trainer-submissions-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Submission Records</div>
            </div>
            <div class="dashboard-muted-small" id="trainerSubmissionRecordCount">0 record(s)</div>
        </div>

        <div class="dashboard-table-wrap trainer-submissions-table-wrap">
            <div class="dashboard-table-row dashboard-table-head trainer-submissions-table-row trainer-submissions-table-head">
                <div>Student</div>
                <div>Assignment</div>
                <div>Course</div>
                <div>Module</div>
                <div>Submitted</div>
                <div>Status</div>
                <div>Score</div>
                <div>Action</div>
            </div>

            <div id="trainerSubmissionRows">
                <div class="dashboard-table-row trainer-submissions-table-row">
                    <div class="dashboard-cell-strong">Loading...</div>
                    <div>—</div>
                    <div>—</div>
                    <div>—</div>
                    <div>—</div>
                    <div>—</div>
                    <div>—</div>
                    <div>—</div>
                </div>
            </div>
        </div>

        <div class="dashboard-muted-small" id="trainerSubmissionEmpty" style="display:none; padding:16px;">
            No submission records found.
        </div>

        <div class="error-box" id="trainerSubmissionError"></div>
    </div>
</div>

<!-- CUSTOM TOAST -->
<div class="dashboard-panel"
     id="trainerSubmissionToast"
     style="display:none; position:fixed; right:24px; top:88px; z-index:2000; max-width:360px; padding:16px 18px; box-shadow:0 12px 35px rgba(0,0,0,0.12);">
    <div style="display:flex; align-items:flex-start; gap:12px;">
        <div id="trainerSubmissionToastIcon"
             style="width:34px; height:34px; border-radius:12px; display:flex; align-items:center; justify-content:center; background:#fce8eb; color:#d21f3c; flex-shrink:0;">
            <i class="bi bi-check2-circle"></i>
        </div>

        <div style="flex:1;">
            <div class="dashboard-panel-title" id="trainerSubmissionToastTitle" style="font-size:15px;">
                Success
            </div>
            <div class="dashboard-sub" id="trainerSubmissionToastMessage" style="margin-top:2px;">
                Action completed successfully.
            </div>
        </div>

        <button type="button"
                id="trainerSubmissionToastClose"
                style="border:0; background:transparent; font-size:20px; line-height:1; cursor:pointer;">
            ×
        </button>
    </div>
</div>
<!-- MARK ZERO CONFIRM MODAL -->
<div id="trainerMarkZeroModal"
     style="display:none; position:fixed; inset:0; z-index:3000; background:rgba(0,0,0,0.35); align-items:center; justify-content:center; padding:20px;">
    <div class="dashboard-panel"
         style="width:100%; max-width:520px; padding:24px; box-shadow:0 18px 45px rgba(0,0,0,0.18);">
        <div class="dashboard-panel-title mb-2" id="trainerMarkZeroModalLabel">
            Mark Missing Submission as 0
        </div>

        <p class="dashboard-sub mb-4" id="trainerMarkZeroModalText">
            This student did not submit the assignment before the due date. Do you want to assign 0 marks?
        </p>

        <div class="trainer-form-actions" style="justify-content:flex-end;">
            <button type="button"
                    class="dashboard-btn dashboard-btn-outline"
                    id="trainerMarkZeroCancelBtn">
                Cancel
            </button>

            <button type="button"
                    class="dashboard-btn add-course-btn"
                    id="trainerMarkZeroConfirmBtn">
                Confirm
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trainer/trainer-assignment-grading-index.js" asp-append-version="true"></script>
}