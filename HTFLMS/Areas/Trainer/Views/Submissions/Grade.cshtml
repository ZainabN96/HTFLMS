@{
    ViewData["Title"] = "Grade Submission";
    Layout = "_TrainerLayout";

    var submissionId = ViewBag.SubmissionId ?? 0;
    var mode = ViewBag.Mode ?? "grade";
}

<div class="dashboard-page trainer-form-page"
     id="trainerAssignmentGradePage"
     data-submission-id="@submissionId"
     data-mode="@mode">

    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1" id="trainerGradePageTitle">Grade Submission</h1>
            <p class="dashboard-sub" id="trainerGradePageSub">
                Review the submitted work and assign marks with feedback.
            </p>
        </div>

        <div class="trainer-content-head-actions">
            <a asp-area="Trainer"
               asp-controller="Submissions"
               asp-action="Index"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to All Submissions
            </a>
        </div>
    </div>

    <div class="dashboard-panel trainer-submission-topbar">
        <div class="trainer-submission-topbar-main">
            <div class="trainer-submission-title-row">
                <h2 class="dashboard-panel-title trainer-submission-title" id="trainerGradeAssignmentHeading">
                    Loading assignment...
                </h2>
                <span class="pill pill-yellow" id="trainerGradeStatusBadge">Pending Review</span>
            </div>

            <div class="trainer-submission-meta">
                <span><strong>Student:</strong> <span id="trainerGradeMetaStudent">—</span></span>
                <span><strong>Course:</strong> <span id="trainerGradeMetaCourse">—</span></span>
                <span><strong>Module:</strong> <span id="trainerGradeMetaModule">—</span></span>
                <span><strong>Submitted:</strong> <span id="trainerGradeMetaSubmitted">—</span></span>
            </div>
        </div>

        <div class="dashboard-stat-card trainer-submission-score-card">
            <div class="dashboard-stat-title">Current Score</div>
            <div class="dashboard-stat-value" id="trainerGradeCurrentScore">--/0</div>
            <div class="dashboard-stat-meta" id="trainerGradeCurrentMeta">Pending</div>
        </div>
    </div>

    <div class="dashboard-panel trainer-form-panel trainer-form-panel-wide">
        <form method="post" class="trainer-assignment-form" id="trainerAssignmentGradeForm">
            <input type="hidden" id="trainerGradeSubmissionId" value="@submissionId" />

            <div class="trainer-form-grid">
                <div class="trainer-form-group">
                    <label class="trainer-form-label">Student Name</label>
                    <input type="text" class="course-input" id="trainerGradeStudentName" readonly />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Assignment Title</label>
                    <input type="text" class="course-input" id="trainerGradeAssignmentTitle" readonly />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Course</label>
                    <input type="text" class="course-input" id="trainerGradeCourse" readonly />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Module</label>
                    <input type="text" class="course-input" id="trainerGradeModule" readonly />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Submitted On</label>
                    <input type="text" class="course-input" id="trainerGradeSubmittedOn" readonly />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Total Marks</label>
                    <input type="number" class="course-input" id="trainerGradeTotalMarks" readonly />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Awarded Marks</label>
                    <input type="number"
                           class="course-input"
                           id="trainerGradeAwardedMarks"
                           placeholder="Enter marks"
                           min="0" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Result Label</label>
                    <select class="course-input" id="trainerGradeResultLabel">
                        <option value="" selected disabled>Select result</option>
                        <option value="Excellent Work">Excellent Work</option>
                        <option value="Good Attempt">Good Attempt</option>
                        <option value="Needs Improvement">Needs Improvement</option>
                    </select>
                </div>

                <div class="trainer-form-group trainer-form-group-full">
                    <label class="trainer-form-label">Student File</label>

                    <div class="trainer-submission-file-card" id="trainerSubmissionFileCard">
                        <div class="trainer-submission-file-main">
                            <div class="trainer-sa-file-icon trainer-sa-file-pdf">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>

                            <div class="trainer-sa-file-text">
                                <div class="trainer-sa-file-title" id="trainerSubmissionFileName">
                                    No file uploaded
                                </div>
                                <div class="trainer-sa-meta-text" id="trainerSubmissionFileMeta">
                                    Uploaded submission file
                                </div>
                            </div>
                        </div>

                        <div class="trainer-courses-actions">
                            <a href="javascript:void(0)"
                               class="dashboard-btn dashboard-btn-outline trainer-course-action-btn trainer-hidden"
                               id="trainerSubmissionViewFileBtn">
                                View
                            </a>

                            <a href="javascript:void(0)"
                               class="dashboard-btn dashboard-btn-outline trainer-course-action-btn trainer-hidden"
                               id="trainerSubmissionDownloadFileBtn">
                                Download
                            </a>
                        </div>
                    </div>
                </div>

                <div class="trainer-form-group trainer-form-group-full trainer-hidden" id="trainerSubmissionPreviewWrap">
                    <label class="trainer-form-label">Submission Preview</label>
                    <div id="trainerSubmissionPreview"></div>
                </div>

                <div class="trainer-form-group trainer-form-group-full trainer-hidden" id="trainerSubmittedTextWrap">
                    <label class="trainer-form-label">Submitted Text / Link</label>
                    <textarea class="course-input trainer-textarea" id="trainerSubmittedText" readonly></textarea>
                </div>

                <div class="trainer-form-group trainer-form-group-full">
                    <label class="trainer-form-label">Trainer Feedback</label>
                    <textarea class="course-input trainer-textarea"
                              id="trainerGradeFeedback"
                              placeholder="Write feedback for the student"></textarea>
                </div>
            </div>

            <div class="error-box" id="trainerGradeError"></div>

            <div class="trainer-form-actions">
                <a asp-area="Trainer"
                   asp-controller="Submissions"
                   asp-action="Index"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="dashboard-btn add-course-btn" id="trainerGradeSaveBtn">
                    Submit Grade
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/trainer/trainer-assignment-grading-grades.js" asp-append-version="true"></script>
}