@{
    ViewData["Title"] = "Create Material";
    Layout = "_TrainerLayout";
}

<div class="dashboard-page trainer-form-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Create Material</h1>
            <p class="dashboard-sub">Add slides, files, uploaded videos, or lecture links for students.</p>
        </div>

        <div class="trainer-content-head-actions">
            <a asp-area="Trainer"
               asp-controller="SlidesAssignments"
               asp-action="Index"
               asp-route-courseId="@ViewBag.CourseId"
               asp-route-moduleId="@ViewBag.ModuleId"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Slides & Assignments
            </a>
        </div>
    </div>

    <div class="dashboard-panel trainer-form-panel trainer-form-panel-wide">
        <form method="post" enctype="multipart/form-data" class="trainer-material-form">
            <div class="trainer-form-grid">

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Material Title</label>
                    <input type="text" class="course-input" placeholder="Enter material title" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Content Type</label>

                    <select class="course-input" id="materialType" onchange="toggleMaterialFields()">

                        <option value="" selected>Select option</option>

                        <option>PDF</option>

                        <option>PPTX</option>

                        <option>MP4 Upload</option>

                        <option>Video Link</option>

                    </select>
                </div>


                <div class="trainer-form-group" id="fileUploadField">
                    <label class="trainer-form-label">Upload File</label>
                    <input type="file" class="course-input" />
                    <div class="dashboard-muted-small" style="margin-top:8px;">Upload a PDF, PPT, or MP4 file for students.</div>
                </div>


                <div class="trainer-form-group" id="videoLinkField" style="display:none;">
                    <label class="trainer-form-label">Lecture Video Link</label>
                    <input type="url" class="course-input" placeholder="Paste recorded lecture link" />
                </div>


                <!-- PDF PAGES -->
                <div class="trainer-form-group" id="pdfPagesField">
                    <label class="trainer-form-label">Pages</label>
                    <input type="number" class="course-input" placeholder="e.g. 12" />
                </div>


                <!-- PPT SLIDES -->
                <div class="trainer-form-group" id="pptSlidesField" style="display:none;">
                    <label class="trainer-form-label">Slides</label>
                    <input type="number" class="course-input" placeholder="e.g. 18" />
                </div>


                <!-- VIDEO MINUTES -->
                <div class="trainer-form-group" id="minutesField" style="display:none;">
                    <label class="trainer-form-label">Minutes</label>
                    <input type="number" class="course-input" placeholder="e.g. 18" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Status</label>

                    <select class="course-input">

                        <option value="" selected>Select option</option>

                        <option>Active</option>

                        <option>Draft</option>

                        <option>Hidden</option>

                    </select>
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Sort Order</label>
                    <input type="number" class="course-input" placeholder="e.g. 1" />
                </div>

            </div>

            <div class="trainer-form-actions">
                <a asp-area="Trainer"
                   asp-controller="SlidesAssignments"
                   asp-action="Index"
                   asp-route-courseId="@ViewBag.CourseId"
                   asp-route-moduleId="@ViewBag.ModuleId"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="dashboard-btn add-course-btn">
                    Create Material
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script>

        function toggleMaterialFields() {

            const type = document.getElementById('materialType').value;

            const fileField = document.getElementById('fileUploadField');

            const linkField = document.getElementById('videoLinkField');

            const pdfField = document.getElementById('pdfPagesField');

            const pptField = document.getElementById('pptSlidesField');

            const minutesField = document.getElementById('minutesField');


            fileField.style.display = 'none';

            linkField.style.display = 'none';

            pdfField.style.display = 'none';

            pptField.style.display = 'none';

            minutesField.style.display = 'none';



            if (type === 'PDF') {

                fileField.style.display = 'block';

                pdfField.style.display = 'block';

            }

            else if (type === 'PPTX') {

                fileField.style.display = 'block';

                pptField.style.display = 'block';

            }

            else if (type === 'MP4 Upload') {

                fileField.style.display = 'block';

                minutesField.style.display = 'block';

            }

            else if (type === 'Video Link') {

                linkField.style.display = 'block';

                minutesField.style.display = 'block';

            }

        }


        toggleMaterialFields();

    </script>
}