@{
    ViewData["Title"] = "Edit Assignment";
    Layout = "_TrainerLayout";
}

<div class="dashboard-page trainer-form-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Edit Assignment</h1>
            <p class="dashboard-sub">Update assignment details, due date, marks, and submission settings.</p>
        </div>

        <div class="trainer-content-head-actions">
            <a asp-area="Trainer"
               asp-controller="SlidesAssignments"
               asp-action="Index"
               asp-route-courseId="@ViewBag.CourseId"
               asp-route-moduleId="@ViewBag.ModuleId"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Slides & Assignments
            </a>
        </div>
    </div>

    <div class="dashboard-panel trainer-form-panel trainer-form-panel-wide">
        <form method="post" enctype="multipart/form-data" class="trainer-assignment-form">
            <div class="trainer-form-grid">

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Assignment Title</label>
                    <input type="text" class="course-input" value="Assignment 1: Rewrite the Abstract" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Marks</label>
                    <input type="number" class="course-input" value="20" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Due Date</label>
                    <input type="date" class="course-input" value="2026-03-12" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Due Time</label>
                    <input type="time" class="course-input" value="23:59" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Status</label>
                    <select class="course-input">
                        <option selected>Active</option>
                        <option>Hidden</option>
                    </select>
                </div>

                <div class="trainer-form-group trainer-form-group-full">
                    <label class="trainer-form-label">Assignment File / Attachment</label>
                    <input type="file" class="course-input" />
                </div>
            </div>

            <div class="trainer-form-actions">
                <a asp-area="Trainer"
                   asp-controller="SlidesAssignments"
                   asp-action="Index"
                   asp-route-courseId="@ViewBag.CourseId"
                   asp-route-moduleId="@ViewBag.ModuleId"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="dashboard-btn add-course-btn">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>