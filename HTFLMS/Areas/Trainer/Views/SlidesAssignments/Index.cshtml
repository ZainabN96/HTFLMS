@{
    ViewData["Title"] = "Slides & Assignments";
    Layout = "_TrainerLayout";

    var courseId = ViewBag.CourseId ?? 0;
    var moduleId = ViewBag.ModuleId ?? 0;
}

<input type="hidden" id="selectedCourseId" value="@courseId" />
<input type="hidden" id="selectedModuleId" value="@moduleId" />

<div class="dashboard-page trainer-content-page trainer-slides-assignments-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Slides & Assignments</h1>
            <p class="dashboard-sub">Manage course files, videos, and assignments for each module.</p>
        </div>
    </div>

    <div class="dashboard-stats trainer-content-stats trainer-sa-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Files</div>
                <i class="bi bi-folder2-open"></i>
            </div>
            <div class="dashboard-stat-value" id="totalFilesCount">0</div>
            <div class="dashboard-stat-meta">Across selected module</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Assignments</div>
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="dashboard-stat-value" id="assignmentsCount">0</div>
            <div class="dashboard-stat-meta">Currently created</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Video Lessons</div>
                <i class="bi bi-play-btn"></i>
            </div>
            <div class="dashboard-stat-value" id="videoLessonsCount">0</div>
            <div class="dashboard-stat-meta">Uploaded content</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Submissions</div>
                <i class="bi bi-people"></i>
            </div>
            <div class="dashboard-stat-value" id="submissionsCount">0</div>
            <div class="dashboard-stat-meta">Combined assignment</div>
        </div>
    </div>

    <div class="dashboard-panel trainer-content-panel trainer-sa-filter-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Select Course & Module</div>
            </div>

            <div class="trainer-panel-actions trainer-inline-tools trainer-sa-filter-tools">
                <select id="courseSelect" class="course-input trainer-inline-select trainer-sa-course-select">
                    <option value="0">Select Course</option>
                </select>

                <select id="moduleSelect" class="course-input trainer-inline-select trainer-sa-module-select">
                    <option value="0">Select a course first</option>
                </select>
            </div>
        </div>
    </div>

    <div class="dashboard-panel trainer-content-panel trainer-sa-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Slides & Videos</div>
            </div>

            <div class="trainer-panel-actions">
                <a id="uploadMaterialBtn"
                   href="/Trainer/SlidesAssignments/CreateMaterial?courseId=0&moduleId=0"
                   class="dashboard-btn add-course-btn trainer-sa-action-btn">
                    <i class="bi bi-plus-circle"></i>
                    Upload File
                </a>
            </div>
        </div>

        <div class="trainer-sa-files-wrap">
            <div class="trainer-sa-files-head">
                <div>File</div>
                <div>Type</div>
                <div>Module</div>
                <div>Status</div>
                <div>Actions</div>
            </div>

            <div id="materialsContainer">
                <div class="dashboard-empty-state" style="padding: 18px 15px;">
                    Please select a course.
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-panel trainer-content-panel trainer-sa-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Module Assignments</div>
            </div>

            <div class="trainer-panel-actions">
                <a id="createAssignmentBtn"
                   href="/Trainer/SlidesAssignments/CreateAssignment?courseId=0&moduleId=0"
                   class="dashboard-btn add-course-btn trainer-sa-action-btn">
                    <i class="bi bi-plus-circle"></i>
                    Create Assignment
                </a>
            </div>
        </div>

        <div id="assignmentsContainer">
            <div class="dashboard-empty-state">
                Please select a course.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/SlideAssignment/index.js"></script>
}