@{
    ViewData["Title"] = "Add Module";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";

    var courseId = ViewBag.CourseId ?? 0;
    var moduleId = ViewBag.ModuleId ?? 0;
}
<div class="dashboard-page trainer-content-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Add Module</h1>
            <p class="dashboard-sub">Create a new module for the selected course.</p>
        </div>

        <div class="trainer-content-head-actions">
            <a asp-area="Trainer"
               asp-controller="ModulesLessons"
               asp-action="Index"
               asp-route-id="@courseId"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Modules & Lessons
            </a>
        </div>
    </div>

    <div class="dashboard-panel trainer-form-panel">
        <div class="dashboard-panel-head">
            <div>
                <div class="dashboard-panel-title">Module Details</div>
                <div class="dashboard-muted-small">Fill in the basic information for this module.</div>
            </div>
        </div>

        <div class="error-box"></div>

        <form id="moduleCreateForm"
              class="trainer-form-grid">

            <input type="hidden"
                   id="courseId"
                   name="CourseId"
                   value="@courseId" />

            <input type="hidden"
                   id="moduleId"
                   value="@moduleId" />

            <div class="trainer-form-group trainer-form-group-full">
                <label class="trainer-form-label">Module Title</label>
                <input type="text"
                       id="title"
                       name="Title"
                       class="course-input"
                       placeholder="Enter module title" />
            </div>

            <div class="trainer-form-group trainer-form-group-full">
                <label class="trainer-form-label">Description</label>
                <textarea id="description"
                          name="Description"
                          class="course-input trainer-textarea"
                          placeholder="Write a short description"></textarea>
            </div>

            <div class="trainer-form-group">
                <label class="trainer-form-label">Display Order</label>
                <input type="number"
                       id="displayOrder"
                       name="DisplayOrder"
                       class="course-input"
                       value="1"
                       min="1" />
            </div>

            <div class="trainer-form-group">
                <label class="trainer-form-label">Status</label>
                <select id="isActive"
                        name="IsActive"
                        class="course-input">
                    <option value="false">Draft</option>
                    <option value="true">Published</option>
                </select>
            </div>

            <div class="trainer-form-group">
                <label class="trainer-form-label">Module Access</label>
                <div class="trainer-checkbox-wrap">
                    <label>
                        <input type="hidden"
                               name="IsAccessible"
                               value="false" />

                        <input type="checkbox"
                               id="isAccessible"
                               name="IsAccessible"
                               value="true" />

                        Open this module at the start
                    </label>
                </div>
            </div>

            <div class="trainer-form-actions trainer-form-group-full">
                <a asp-area="Trainer"
                   asp-controller="ModulesLessons"
                   asp-action="Index"
                   asp-route-id="@courseId"
                   class="dashboard-btn dashboard-btn-outline"
                   onclick="sessionStorage.setItem('selectedCourseId', '@courseId'); sessionStorage.setItem('selectedModuleId', '@moduleId'); sessionStorage.setItem('restoreSelectionAfterCancel', 'true');">
                    Cancel
                </a>

                <button type="submit"
                        id="saveModuleBtn"
                        class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Save Module
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ModuleLesson/addEditModule.js"></script>
}