@{
    ViewData["Title"] = "Edit Module";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    var courseId = ViewBag.CourseId ?? 0;
    var moduleId = ViewBag.ModuleId ?? 0;
}

<div class="dashboard-page trainer-content-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Edit Module</h1>
            <p class="dashboard-sub">Update the module details for the selected course.</p>
        </div>

        <div class="trainer-content-head-actions">
            <a asp-area="Trainer"
               asp-controller="ModulesLessons"
               asp-action="Index"
               asp-route-id="@courseId"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Modules & Lessons
            </a>
        </div>
    </div>

    <div class="dashboard-panel trainer-form-panel">
        <div class="dashboard-panel-head">
            <div>
                <div class="dashboard-panel-title">Module Details</div>
                <div class="dashboard-muted-small">Update the basic information for this module.</div>
            </div>
        </div>

        <form asp-area="Trainer"
              asp-controller="ModulesLessons"
              asp-action="EditModule"
              method="post"
              class="trainer-form-grid">

            <input type="hidden" name="courseId" value="@courseId" />
            <input type="hidden" name="moduleId" value="@moduleId" />

            <div class="trainer-form-group trainer-form-group-full">
                <label class="trainer-form-label">Module Title</label>
                <input type="text"
                       name="title"
                       class="course-input"
                       value="Module 1: Introduction to Web Development" />
            </div>

            <div class="trainer-form-group trainer-form-group-full">
                <label class="trainer-form-label">Description</label>
                <textarea name="description"
                          class="course-input trainer-textarea">Learn the fundamentals of web development</textarea>
            </div>

            <div class="trainer-form-group">
                <label class="trainer-form-label">Display Order</label>
                <input type="number"
                       name="displayOrder"
                       class="course-input"
                       value="1"
                       min="1" />
            </div>

            <div class="trainer-form-group">
                <label class="trainer-form-label">Status</label>
                <select name="status" class="course-input">
                    <option value="Draft">Draft</option>
                    <option value="Published" selected>Published</option>
                </select>
            </div>

            <div class="trainer-form-group">
                <label class="trainer-form-label">Module Access</label>
                <div class="trainer-checkbox-wrap">
                    <label>
                        <input type="checkbox" name="isOpenAtStart" value="true" />
                        Open this module at the start
                    </label>
                </div>
            </div>

            <div class="trainer-form-actions trainer-form-group-full">
                <a asp-area="Trainer"
                   asp-controller="ModulesLessons"
                   asp-action="Index"
                   asp-route-id="@courseId"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="dashboard-btn add-course-btn">
                    <i class="bi bi-check2-circle"></i>
                    Update Module
                </button>
            </div>
        </form>
    </div>
</div>