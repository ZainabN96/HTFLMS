@{
    ViewData["Title"] = "Add Quiz";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    var courseId = ViewBag.CourseId ?? 0;
    var moduleId = ViewBag.ModuleId ?? 0;
}

<div class="dashboard-page trainer-content-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Add Quiz</h1>
            <p class="dashboard-sub">Create a quiz the way students will actually see and attempt it.</p>
        </div>

        <div class="trainer-content-head-actions">
            <a asp-area="Trainer"
               asp-controller="ModulesLessons"
               asp-action="Index"
               asp-route-id="@courseId"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Modules & Lessons
            </a>
        </div>
    </div>

    <form asp-area="Trainer"
          asp-controller="ModulesLessons"
          asp-action="CreateQuiz"
          method="post"
          class="trainer-quiz-builder-form">

        <input type="hidden" name="courseId" value="@courseId" />

        <div class="dashboard-panel trainer-form-panel">
            <div class="dashboard-panel-head">
                <div>
                    <div class="dashboard-panel-title">Quiz Details</div>
                    <div class="dashboard-muted-small">Set up the main quiz information first.</div>
                </div>
            </div>

            <div class="trainer-form-grid">
                <div class="trainer-form-group">
                    <label class="trainer-form-label">Module</label>
                    <select name="moduleId" class="course-input">
                        <option value="">Select module</option>
                        <option value="1" selected="@(moduleId?.ToString() == "1")">Module 1: Introduction to Web Development</option>
                        <option value="2" selected="@(moduleId?.ToString() == "2")">Module 2: JavaScript Fundamentals</option>
                        <option value="3" selected="@(moduleId?.ToString() == "3")">Module 3: React Basics</option>
                        <option value="4" selected="@(moduleId?.ToString() == "4")">Module 4: Advanced React Patterns</option>
                    </select>
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Display Order</label>
                    <input type="number" name="displayOrder" class="course-input" placeholder="1" min="1" />
                </div>

                <div class="trainer-form-group trainer-form-group-full">
                    <label class="trainer-form-label">Quiz Title</label>
                    <input type="text" name="title" class="course-input" placeholder="Enter quiz title" />
                </div>

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Attempts Allowed</label>
                    <input type="number" name="attemptsAllowed" class="course-input" placeholder="3" min="1" />
                </div>

                <div class="trainer-form-group trainer-form-group-full">
                    <label class="trainer-form-label">Instructions</label>
                    <textarea name="instructions" class="course-input trainer-textarea" placeholder="Add instructions for the quiz"></textarea>
                </div>

                <input type="hidden" name="isLocked" value="true" />

                <div class="trainer-form-group">
                    <label class="trainer-form-label">Quiz Access</label>
                    <div style="padding-top:12px;">
                        <label style="display:flex; align-items:center; gap:10px; font-weight:500;">
                            <input type="checkbox" name="isLocked" value="false" />
                            Allow students to access this quiz
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-panel trainer-form-panel">
            <div class="dashboard-panel-head trainer-content-panel-head">
                <div>
                    <div class="dashboard-panel-title">Quiz Questions</div>
                    <div class="dashboard-muted-small">Add the questions and answer options students will attempt.</div>
                </div>

                <div class="trainer-panel-actions">
                    <button type="button" class="dashboard-btn add-course-btn">
                        <i class="bi bi-plus-circle"></i>
                        Add Question
                    </button>
                </div>
            </div>

            <div class="trainer-question-builder-list">

                <!-- QUESTION 1 -->
                <div class="trainer-question-builder-card">
                    <div class="trainer-question-builder-head">
                        <div class="trainer-question-builder-title">Question 1</div>
                        <button type="button" class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                            Remove
                        </button>
                    </div>

                    <div class="trainer-form-grid">
                        <div class="trainer-form-group trainer-form-group-full">
                            <label class="trainer-form-label">Question Text</label>
                            <textarea name="questions[0].QuestionText"
                                      class="course-input trainer-textarea"
                                      placeholder="What does HTML mainly do?"></textarea>
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option A</label>
                            <input type="text" name="questions[0].OptionA" class="course-input" placeholder="Adds server security" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option B</label>
                            <input type="text" name="questions[0].OptionB" class="course-input" placeholder="Structures webpage content" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option C</label>
                            <input type="text" name="questions[0].OptionC" class="course-input" placeholder="Stores database records" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option D</label>
                            <input type="text" name="questions[0].OptionD" class="course-input" placeholder="Compiles JavaScript" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Correct Answer</label>
                            <select name="questions[0].CorrectAnswer" class="course-input">
                                <option value="">Select correct option</option>
                                <option value="A">Option A</option>
                                <option value="B">Option B</option>
                                <option value="C">Option C</option>
                                <option value="D">Option D</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- QUESTION 2 -->
                <div class="trainer-question-builder-card">
                    <div class="trainer-question-builder-head">
                        <div class="trainer-question-builder-title">Question 2</div>
                        <button type="button" class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                            Remove
                        </button>
                    </div>

                    <div class="trainer-form-grid">
                        <div class="trainer-form-group trainer-form-group-full">
                            <label class="trainer-form-label">Question Text</label>
                            <textarea name="questions[1].QuestionText"
                                      class="course-input trainer-textarea"
                                      placeholder="Which tag is commonly used for the largest heading?"></textarea>
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option A</label>
                            <input type="text" name="questions[1].OptionA" class="course-input" placeholder="<p>" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option B</label>
                            <input type="text" name="questions[1].OptionB" class="course-input" placeholder="<div>" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option C</label>
                            <input type="text" name="questions[1].OptionC" class="course-input" placeholder="<h1>" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option D</label>
                            <input type="text" name="questions[1].OptionD" class="course-input" placeholder="<span>" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Correct Answer</label>
                            <select name="questions[1].CorrectAnswer" class="course-input">
                                <option value="">Select correct option</option>
                                <option value="A">Option A</option>
                                <option value="B">Option B</option>
                                <option value="C">Option C</option>
                                <option value="D">Option D</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- QUESTION 3 -->
                <div class="trainer-question-builder-card">
                    <div class="trainer-question-builder-head">
                        <div class="trainer-question-builder-title">Question 3</div>
                        <button type="button" class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                            Remove
                        </button>
                    </div>

                    <div class="trainer-form-grid">
                        <div class="trainer-form-group trainer-form-group-full">
                            <label class="trainer-form-label">Question Text</label>
                            <textarea name="questions[2].QuestionText"
                                      class="course-input trainer-textarea"
                                      placeholder="What does CSS mainly control?"></textarea>
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option A</label>
                            <input type="text" name="questions[2].OptionA" class="course-input" placeholder="Styling and layout" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option B</label>
                            <input type="text" name="questions[2].OptionB" class="course-input" placeholder="Database queries" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option C</label>
                            <input type="text" name="questions[2].OptionC" class="course-input" placeholder="Browser installation" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Option D</label>
                            <input type="text" name="questions[2].OptionD" class="course-input" placeholder="File compression" />
                        </div>

                        <div class="trainer-form-group">
                            <label class="trainer-form-label">Correct Answer</label>
                            <select name="questions[2].CorrectAnswer" class="course-input">
                                <option value="">Select correct option</option>
                                <option value="A">Option A</option>
                                <option value="B">Option B</option>
                                <option value="C">Option C</option>
                                <option value="D">Option D</option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>

            <div class="trainer-form-actions trainer-form-actions-sticky">
                <a asp-area="Trainer"
                   asp-controller="ModulesLessons"
                   asp-action="Index"
                   asp-route-id="@courseId"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Save Quiz
                </button>
            </div>
        </div>
    </form>
</div>