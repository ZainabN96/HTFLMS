@{
    ViewData["Title"] = "Admin My Courses";
    Layout = "_AdminLayout";
}

<div class="dashboard-page trainer-courses-page">
    <div class="dashboard-page-head trainer-courses-page-head">
        <div>
            <h1 class="dashboard-h1">My Courses</h1>
            <p class="dashboard-sub">Manage your assigned courses, modules, and lessons.</p>
        </div>

        <div class="trainer-courses-head-actions">
            <div class="courses-head-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search courses..." />
            </div>

            <a asp-area="Admin"
               asp-controller="AdminCourses"
               asp-action="AddNewCourse"
               class="dashboard-btn add-course-btn trainer-add-course-btn">
                <i class="bi bi-plus-circle"></i> Add Course
            </a>
        </div>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Courses</div>
                <i class="bi bi-journal-bookmark"></i>
            </div>
            <div class="dashboard-stat-value">4</div>
            <div class="dashboard-stat-meta">Assigned to you</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Active Courses</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value">3</div>
            <div class="dashboard-stat-meta">Currently running</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Draft Courses</div>
                <i class="bi bi-pencil-square"></i>
            </div>
            <div class="dashboard-stat-value">1</div>
            <div class="dashboard-stat-meta">Needs completion</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Students</div>
                <i class="bi bi-people"></i>
            </div>
            <div class="dashboard-stat-value">128</div>
            <div class="dashboard-stat-meta">Across all courses</div>
        </div>
    </div>

    <div class="dashboard-panel trainer-courses-table-panel">
        <div class="dashboard-panel-head">
            <div class="dashboard-panel-title">All Courses</div>
            <div class="dashboard-muted-small">4 course(s)</div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row dashboard-table-head courses-table-row trainer-courses-table-head">
                <div>Title</div>
                <div>Category</div>
                <div>Students</div>
                <div>Status</div>
                <div>Created</div>
                <div>Actions</div>
            </div>

            <div class="dashboard-table-row courses-table-row trainer-courses-table-row">
                <div class="courses-coursecell">
                    <div class="courses-title-wrap">
                        <div class="course-thumb">
                            <img src="~/img/course/course-1.webp" alt="React Advanced Patterns" />
                        </div>
                        <div class="courses-title-block">
                            <div class="courses-title">React Advanced Patterns</div>
                            <div class="courses-sub-text">Frontend</div>
                        </div>
                    </div>
                </div>
                <div><span class="trainer-course-chip">Frontend</span></div>
                <div>34</div>
                <div><span class="pill pill-green">Active</span></div>
                <div>Feb 25, 2026</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Courses"
                       asp-action="Edit"
                       asp-route-id="1"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>

                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row courses-table-row trainer-courses-table-row">
                <div class="courses-coursecell">
                    <div class="courses-title-wrap">
                        <div class="course-thumb">
                            <img src="~/img/course/course-1.webp" alt="Node.js Backend Development" />
                        </div>
                        <div class="courses-title-block">
                            <div class="courses-title">Node.js Backend Development</div>
                            <div class="courses-sub-text">Backend</div>
                        </div>
                    </div>
                </div>
                <div><span class="trainer-course-chip">Backend</span></div>
                <div>29</div>
                <div><span class="pill pill-green">Active</span></div>
                <div>Feb 20, 2026</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Courses"
                       asp-action="Edit"
                       asp-route-id="2"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>

                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row courses-table-row trainer-courses-table-row">
                <div class="courses-coursecell">
                    <div class="courses-title-wrap">
                        <div class="course-thumb">
                            <img src="~/img/course/course-1.webp" alt="Python for Data Science" />
                        </div>
                        <div class="courses-title-block">
                            <div class="courses-title">Python for Data Science</div>
                            <div class="courses-sub-text">Data Science</div>
                        </div>
                    </div>
                </div>
                <div><span class="trainer-course-chip">Data Science</span></div>
                <div>41</div>
                <div><span class="pill pill-green">Active</span></div>
                <div>Mar 01, 2026</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Courses"
                       asp-action="Edit"
                       asp-route-id="3"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>

                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>

            <div class="dashboard-table-row courses-table-row trainer-courses-table-row">
                <div class="courses-coursecell">
                    <div class="courses-title-wrap">
                        <div class="course-thumb">
                            <img src="~/img/course/course-1.webp" alt="Full Stack Web Development" />
                        </div>
                        <div class="courses-title-block">
                            <div class="courses-title">Full Stack Web Development</div>
                            <div class="courses-sub-text">Development</div>
                        </div>
                    </div>
                </div>
                <div><span class="trainer-course-chip">Development</span></div>
                <div>24</div>
                <div><span class="pill pill-yellow">Draft</span></div>
                <div>Mar 03, 2026</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="Courses"
                       asp-action="Edit"
                       asp-route-id="4"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">
                        Edit
                    </a>

                    <button type="button" class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>