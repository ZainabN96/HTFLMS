@{
    ViewData["Title"] = "Add Lesson";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var courseId = ViewBag.CourseId ?? 0;
    var moduleId = ViewBag.ModuleId ?? 0;
    var lessonId = ViewBag.LessonId ?? 0;
}

<div class="dashboard-page admin-content-page">
    <div class="dashboard-page-head admin-content-head">
        <div>
            <h1 class="dashboard-h1">Add Lesson</h1>
            <p class="dashboard-sub">Create a lesson and assign it to a module.</p>
        </div>

        <div class="admin-content-head-actions">
            <a id="cancelBtn"
               href="#"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Modules & Lessons
            </a>
        </div>
    </div>

    <div class="error-box"></div>

    <div class="dashboard-panel admin-form-panel">
        <div class="dashboard-panel-head">
            <div>
                <div class="dashboard-panel-title">Lesson Details</div>
                <div class="dashboard-muted-small">Add lesson content for the selected course and module.</div>
            </div>
        </div>

        <form id="lessonCreateForm" class="admin-form-grid">
            <input type="hidden" id="courseId" value="@courseId" />
            <input type="hidden" id="moduleId" value="@moduleId" />
            <input type="hidden" id="lessonId" value="@lessonId" />

            <div class="admin-form-group">
                <label class="admin-form-label">Module</label>
                <select id="moduleSelect" class="course-input">
                    <option value="">Select module</option>
                </select>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Display Order</label>
                <input type="number" id="displayOrder" class="course-input" value="1" min="1" />
            </div>

            <div class="admin-form-group admin-form-group-full">
                <label class="admin-form-label">Lesson Title</label>
                <input type="text" id="title" class="course-input" placeholder="Enter lesson title" />
            </div>

            <div class="admin-form-group admin-form-group-full">
                <label class="admin-form-label">Lesson Content</label>
                <textarea id="description"
                          class="course-input admin-textarea admin-content-textarea"
                          placeholder="Add lesson text, summary, instructions, or links here"></textarea>
            </div>

            <input type="hidden" id="isActive" value="true" />

            <div class="admin-form-actions admin-form-group-full">
                <a id="cancelBtn"
                   href="#"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit"
                        id="saveLessonBtn"
                        class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Save Lesson
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ModuleLesson/adminAddEditLesson.js"></script>
}