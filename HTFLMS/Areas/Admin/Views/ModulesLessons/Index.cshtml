@{
    ViewData["Title"] = "Modules & Lessons";
    Layout = "_AdminLayout";

    var courseId = ViewBag.CourseId ?? 0;
}

<input type="hidden"
       id="selectedCourseId"
       value="@courseId" />

<div class="dashboard-page admin-content-page admin-modules-page">
    <div class="dashboard-page-head admin-content-head">
        <div>
            <h1 class="dashboard-h1">Modules & Lessons</h1>
            <p class="dashboard-sub">Select a course, then manage modules, lessons, and quizzes separately.</p>
        </div>
    </div>

    <div class="dashboard-stats admin-content-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Modules</div>
                <i class="bi bi-collection"></i>
            </div>
            <div class="dashboard-stat-value" id="totalModulesCount">0</div>
            <div class="dashboard-stat-meta">In this course</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Lessons</div>
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="dashboard-stat-value" id="totalLessonsCount">0</div>
            <div class="dashboard-stat-meta">Across all modules</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Quizzes</div>
                <i class="bi bi-patch-question"></i>
            </div>
            <div class="dashboard-stat-value" id="totalQuizzesCount">0</div>
            <div class="dashboard-stat-meta">Separate quiz items</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Published</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value" id="publishedStatus">No</div>
            <div class="dashboard-stat-meta">Visible to students</div>
        </div>
    </div>

    <div class="dashboard-panel admin-content-panel admin-modules-filter-panel">
        <div class="dashboard-panel-head admin-content-panel-head admin-modules-filter-head">
            <div>
                <div class="dashboard-panel-title">Select Course & Module</div>
            </div>

            <div class="admin-panel-actions admin-inline-tools admin-modules-filter-tools">
                <select id="courseSelect"
                        class="course-input admin-inline-select admin-modules-course-select">
                </select>

                <select id="moduleSelect"
                        class="course-input admin-inline-select admin-modules-module-select">
                    <option value="0">Select a Course First to view modules list</option>
                </select>
            </div>
        </div>
    </div>

    <div class="dashboard-panel admin-content-panel">
        <div class="dashboard-panel-head admin-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Modules</div>
            </div>

            <div class="admin-panel-actions">
                <a id="addModuleBtn"
                   href="/Admin/ModulesLessons/CreateModule?courseId=0"
                   class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Module
                </a>
            </div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row admin-modules-table-row dashboard-table-head">
                <div>Title</div>
                <div>Lessons</div>
                <div>Quiz</div>
                <div>Status</div>
                <div>Access</div>
                <div>Order</div>
                <div>Actions</div>
            </div>

            <div id="modulesContainer">
                <div class="dashboard-empty-state">Please select a course.</div>
            </div>
        </div>
    </div>

    <div class="dashboard-panel admin-content-panel">
        <div class="dashboard-panel-head admin-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Lessons</div>
            </div>

            <div class="admin-panel-actions">
                <a id="addLessonBtn"
                   href="/Admin/ModulesLessons/CreateLesson?courseId=0"
                   class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Lesson
                </a>
            </div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row admin-lessons-table-row dashboard-table-head">
                <div>Title</div>
                <div>Module</div>
                <div>Type</div>
                <div>Status</div>
                <div>Order</div>
                <div>Actions</div>
            </div>

            <div id="lessonsContainer">
                <div class="dashboard-empty-state">Please select a course.</div>
            </div>
        </div>
    </div>

    <div class="dashboard-panel admin-content-panel">
        <div class="dashboard-panel-head admin-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Quizzes</div>
            </div>

            <div class="admin-panel-actions">
                <a id="addQuizBtn"
                   href="/Admin/ModulesLessons/CreateQuiz?courseId=0"
                   class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Quiz
                </a>
            </div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row admin-quiz-table-row dashboard-table-head">
                <div>Title</div>
                <div>Module</div>
                <div>Questions</div>
                <div>Attempts</div>
                <div>Status</div>
                <div>Access</div>
                <div>Actions</div>
            </div>

            <div id="quizzesContainer">
                <div class="dashboard-empty-state">Please select a course.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ModuleLesson/adminIndex.js"></script>
}