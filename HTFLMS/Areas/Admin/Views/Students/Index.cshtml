@{
    ViewData["Title"] = "Students";
    Layout = "_AdminLayout";
}

<div class="dashboard-page admin-students-page">
    <div class="dashboard-page-head admin-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Students</h1>
            <p class="dashboard-sub">Manage all registered students and their course enrollments.</p>
        </div>

        <div class="admin-courses-head-actions">
            <div class="courses-head-search">
                <i class="bi bi-search"></i>
                <input type="text" id="studentSearchInput" placeholder="Search students..." />
            </div>

            <a asp-area="Admin"
               asp-controller="Students"
               asp-action="Create"
               class="dashboard-btn add-course-btn admin-add-course-btn">
                <i class="bi bi-plus-circle"></i>
                Add Student
            </a>
        </div>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-title">Total Students</div>
            <div class="dashboard-stat-value" id="totalStudentsCount">0</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-title">Active Students</div>
            <div class="dashboard-stat-value" id="activeStudentsCount">0</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-title">Inactive Students</div>
            <div class="dashboard-stat-value" id="inactiveStudentsCount">0</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-title">Enrollments</div>
            <div class="dashboard-stat-value" id="totalEnrollmentsCount">0</div>
        </div>
    </div>

    <div class="dashboard-panel admin-students-filter-panel">
        <div class="dashboard-panel-head admin-content-panel-head">
            <div class="dashboard-panel-title">Select Filter</div>
        </div>

        <div class="admin-students-filter-row">
            <select class="course-input admin-students-select" id="courseFilter">
                <option value="">All courses</option>
            </select>

            <select class="course-input admin-students-select" id="statusFilter">
                <option value="">All statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>

    <div class="dashboard-panel admin-students-table-panel">
        <div class="dashboard-panel-head">
            <div class="dashboard-panel-title">All Students</div>
            <div class="dashboard-muted-small" id="studentCountText">0 student(s)</div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row dashboard-table-head admin-students-table-row admin-students-table-head">
                <div>Student</div>
                <div>Email</div>
                <div>Enrolled courses</div>
                <div>Avg grade</div>
                <div>Joined</div>
                <div>Status</div>
                <div>Actions</div>
            </div>

            <div id="studentsTableBody"></div>
        </div>
    </div>
</div>

<div id="deleteStudentModal" class="custom-modal">
    <div class="custom-modal-backdrop"></div>

    <div class="custom-modal-box">
        <h3>Deactivate Student</h3>
        <p>Are you sure you want to deactivate this student?</p>

        <div class="custom-modal-actions">
            <button id="cancelDeleteStudentBtn" class="dashboard-btn dashboard-btn-outline">
                Cancel
            </button>

            <button id="confirmDeleteStudentBtn" class="dashboard-btn add-course-btn">
                Deactivate
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ManageStudent/index.js"></script>
}