@{
    ViewData["Title"] = "Add Student";
    Layout = "_AdminLayout";
}

<div class="dashboard-page admin-student-form-page">
    <div class="dashboard-page-head admin-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Add Student</h1>
            <p class="dashboard-sub">Create a new student profile and assign course details.</p>
        </div>

        <div class="dashboard-head-actions">
            <a asp-area="Admin"
               asp-controller="Students"
               asp-action="Index"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Students
            </a>
        </div>
    </div>

    <div class="dashboard-panel admin-student-form-panel">
        <form method="post" asp-action="Create" class="admin-student-form">
            <div class="admin-student-form-top">

                <!-- RIGHT SIDE FORM -->
                <div class="admin-student-form-main">

                    <div class="admin-student-form-grid">

                        <div class="admin-student-form-group">
                            <label class="admin-student-label">First Name</label>
                            <input type="text"
                                   name="FirstName"
                                   class="course-input"
                                   placeholder="Enter first name" />
                        </div>

                        <div class="admin-student-form-group">
                            <label class="admin-student-label">Last Name</label>
                            <input type="text"
                                   name="LastName"
                                   class="course-input"
                                   placeholder="Enter last name" />
                        </div>

                        <div class="admin-student-form-group">
                            <label class="admin-student-label">Email Address</label>
                            <input type="email"
                                   name="Email"
                                   class="course-input"
                                   placeholder="Enter email address" />
                        </div>

                        <div class="admin-student-form-group">
                            <label class="admin-student-label">Status</label>
                            <select name="Status" class="course-input">
                                <option value="">Select status</option>
                                <option value="Active">Active</option>
                                <option value="At Risk">At Risk</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>

                        <div class="admin-student-form-group">
                            <label class="admin-student-label">Join Date</label>
                            <input type="date"
                                   name="JoinDate"
                                   class="course-input" />
                        </div>

                        <!-- ENROLLED COURSES AT END -->
                        <div class="admin-student-form-group admin-student-form-group-full">
                            <label class="admin-student-label">Enrolled Courses</label>

                            <div class="course-select-list">
                                <label class="course-select-item">
                                    <input type="checkbox" name="CourseIds" value="1" />
                                    <span>Web Development</span>
                                </label>

                                <label class="course-select-item">
                                    <input type="checkbox" name="CourseIds" value="2" />
                                    <span>Digital Marketing</span>
                                </label>

                                <label class="course-select-item">
                                    <input type="checkbox" name="CourseIds" value="3" />
                                    <span>Graphic Design</span>
                                </label>

                                <label class="course-select-item">
                                    <input type="checkbox" name="CourseIds" value="4" />
                                    <span>UI UX Design</span>
                                </label>

                                <label class="course-select-item">
                                    <input type="checkbox" name="CourseIds" value="5" />
                                    <span>Python Basics</span>
                                </label>

                                <label class="course-select-item">
                                    <input type="checkbox" name="CourseIds" value="6" />
                                    <span>Data Science Fundamentals</span>
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="admin-student-form-actions">

                        <a asp-area="Admin"
                           asp-controller="Students"
                           asp-action="Index"
                           class="dashboard-btn dashboard-btn-outline">
                            Cancel
                        </a>

                        <button type="submit"
                                class="dashboard-btn add-course-btn">
                            Save Student
                        </button>

                    </div>

                </div>

            </div>
        </form>
    </div>
</div>