@{
    ViewData["Title"] = ((int)ViewBag.TrainerId == 0) ? "Add New Trainer" : "Edit Trainer";
    Layout = "_AdminLayout";
}

<input type="hidden" id="trainerId" value="@ViewBag.TrainerId" />

<div class="dashboard-page trainer-form-page manage-trainer-form-page">
    <div class="dashboard-page-head trainer-courses-page-head">
        <div>
            <h1 class="dashboard-h1" id="pageTitle">Add New Trainer</h1>
            <p class="dashboard-sub" id="pageSubTitle">Create a new trainer profile and save all required details.</p>
        </div>

        <div class="dashboard-head-actions">
            <a href="/Admin/ManageTrainers/Trainers"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Trainers
            </a>
        </div>
    </div>

    <div class="dashboard-panel manage-trainer-form-panel">
        <form id="trainerForm" class="manage-trainer-form">
            <div class="manage-trainer-form-grid">
                <div class="trainer-form-layout">

                    <div class="trainer-upload">
                        <label for="Picture" class="trainer-upload-box">
                            <div class="trainer-upload-inner" id="trainerPicturePlaceholder">
                                <div class="trainer-upload-icon">
                                    <i class="bi bi-image"></i>
                                </div>
                                <div class="trainer-upload-title">Upload Profile Picture</div>
                                <div class="trainer-upload-sub">
                                    PNG/JPG supported. Recommended square image for trainer profile page.
                                </div>
                            </div>

                            <img id="trainerPicturePreview"
                                 class="trainer-preview"
                                 alt="Trainer picture preview" />

                            <input id="Picture"
                                   name="Picture"
                                   type="file"
                                   class="trainer-file-hidden"
                                   accept="image/*" />
                        </label>
                    </div>

                    <div class="trainer-fields">
                        <div class="trainer-row-2">
                            <div>
                                <label class="trainer-label">Name</label>
                                <input id="name" class="course-input" placeholder="Enter trainer name" />
                                <span class="text-danger small field-error" data-field="name"></span>
                            </div>

                            <div>
                                <label class="trainer-label">Email Address</label>
                                <input id="email" class="course-input" placeholder="Enter email address" />
                                <span class="text-danger small field-error" data-field="email"></span>
                            </div>
                        </div>

                        <div class="trainer-row-2">
                            <div>
                                <label class="trainer-label">Password</label>
                                <input id="password" type="password" class="course-input" placeholder="Enter password" />
                                <span class="text-danger small field-error" data-field="password"></span>
                            </div>

                            <div>
                                <label class="trainer-label">Confirm Password</label>
                                <input id="confirmPassword" type="password" class="course-input" placeholder="Confirm password" />
                                <span class="text-danger small field-error" data-field="confirmPassword"></span>
                            </div>
                        </div>

                        <div class="trainer-row-2">
                            <div>
                                <label class="trainer-label">Designation</label>
                                <input id="designation" class="course-input" placeholder="Enter designation" />
                                <span class="text-danger small field-error" data-field="designation"></span>
                            </div>

                            <div>
                                <label class="trainer-label">CNIC</label>
                                <input id="cnic" class="course-input" placeholder="Enter CNIC" />
                                <span class="text-danger small field-error" data-field="cnic"></span>
                            </div>
                        </div>

                        <div class="trainer-row-2">
                            <div>
                                <label class="trainer-label">Mobile Number</label>
                                <input id="mobileNumber" class="course-input" placeholder="Enter mobile number" />
                                <span class="text-danger small field-error" data-field="mobileNumber"></span>
                            </div>

                            <div>
                                <label class="trainer-label">Status</label>
                                <select id="isActive" class="course-input">
                                    <option value="">Select status</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                                <span class="text-danger small field-error" data-field="isActive"></span>
                            </div>
                        </div>

                        <div class="trainer-row-2">
                            <div>
                                <label class="trainer-label">Gender</label>
                                <select id="gender" class="course-input">
                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <div>
                                <label class="trainer-label">Qualification</label>
                                <select id="qualification" class="course-input">
                                    <option value="">Select qualification</option>
                                    <option value="Matric">Matric</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Bachelors">Bachelors</option>
                                    <option value="Masters">Masters</option>
                                </select>
                            </div>
                        </div>

                        <div class="trainer-row-2">
                            <div>
                                <label class="trainer-label">Address</label>
                                <input id="address" class="course-input" placeholder="Enter address" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="formErrorSummary" class="text-danger small manage-trainer-validation-summary"></div>

            <div class="manage-trainer-form-actions">
                <a href="/Admin/ManageTrainers/Trainers"
                   class="dashboard-btn dashboard-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="dashboard-btn add-course-btn trainer-add-course-btn" id="saveTrainerBtn">
                    Save Trainer
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ManageTrainer/addEditTrainer.js"></script>
}