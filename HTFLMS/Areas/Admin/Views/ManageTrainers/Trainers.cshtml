@{
    ViewData["Title"] = "Trainers";
    Layout = "_AdminLayout";
}

<div class="dashboard-page trainer-courses-page">
    <div class="dashboard-page-head trainer-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Trainers</h1>
            <p class="dashboard-sub">Add, manage and assign trainers to courses</p>
        </div>

        <div class="trainer-courses-head-actions">
            <div class="courses-head-search">
                <i class="bi bi-search"></i>
                <input type="text" id="trainerSearchInput" placeholder="Search Trainer..." />
            </div>

            <a href="/Admin/ManageTrainers/AddTrainer"
               class="dashboard-btn add-course-btn trainer-add-course-btn">
                <i class="bi bi-plus-circle"></i> Add Trainer
            </a>
        </div>
    </div>

    <div class="ManageTrainer-stat">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Trainers</div>
                <i class="bi bi-people"></i>
            </div>
            <div class="dashboard-stat-value" id="totalTrainersCount">0</div>
            <div class="dashboard-stat-meta">All registered trainers</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Active Trainers</div>
                <i class="bi bi-person-check"></i>
            </div>
            <div class="dashboard-stat-value" id="activeTrainersCount">0</div>
            <div class="dashboard-stat-meta">Currently active trainers</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Inactive Trainers</div>
                <i class="bi bi-person-x"></i>
            </div>
            <div class="dashboard-stat-value" id="inactiveTrainersCount">0</div>
            <div class="dashboard-stat-meta">Currently inactive trainers</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Assigned Courses</div>
                <i class="bi bi-journal-check"></i>
            </div>
            <div class="dashboard-stat-value" id="assignedCoursesCount">0</div>
            <div class="dashboard-stat-meta">Across all trainers</div>
        </div>
    </div>

    <div class="dashboard-panel trainer-courses-table-panel">
        <div class="dashboard-panel-head">
            <div class="dashboard-panel-title">All Trainers</div>
            <div class="dashboard-muted-small" id="trainerTableCount">0 trainer(s)</div>
        </div>

        <div class="dashboard-table-wrap manage-trainer-table-fix">
            <div class="dashboard-table-row dashboard-table-head courses-table-row trainer-courses-table-head manage-trainer-table-head">
                <div>Name</div>
                <div>Email</div>
                <div>Designation</div>
                <div>Assigned Course</div>
                <div>Status</div>
                <div>Created At</div>
                <div>Actions</div>
            </div>

            <div id="trainersContainer"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/ManageTrainer/index.js"></script>
}