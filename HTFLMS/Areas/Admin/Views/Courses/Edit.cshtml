@{
    ViewData["Title"] = "Edit Course";
    Layout = "_AdminLayout";
}

<div class="dashboard-page admin-form-page">
    <div class="dashboard-page-head admin-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Edit Course</h1>
            <p class="dashboard-sub">Update the course details used across the student pages.</p>
        </div>

        <div class="dashboard-head-actions">
            <a asp-area="Admin"
               asp-controller="Courses"
               asp-action="Index"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Courses
            </a>
        </div>
    </div>

    <div class="dashboard-panel course-form-panel admin-form-panel admin-form-panel-wide">
        <form method="post"
              asp-action="Edit"
              asp-route-id="@ViewBag.CourseId"
              enctype="multipart/form-data"
              class="course-form-grid admin-form-layout-split">

            <!-- LEFT SIDE IMAGE -->
            <div class="admin-form-media">
                <label for="imageFile" class="admin-form-media-box admin-upload-box">
                    <div class="admin-form-media-inner">
                        <div class="admin-form-media-content admin-upload-content"
                             id="uploadPlaceholder"
                             style="display:@(string.IsNullOrWhiteSpace(ViewBag.ImageUrl as string) ? "flex" : "none");">
                            <div class="admin-form-media-icon">
                                <i class="bi bi-image"></i>
                            </div>
                            <div class="admin-form-media-title">Upload Course Image</div>
                            <div class="admin-form-media-sub">
                                PNG/JPG supported. Upload a new image if you want to replace the current one.
                            </div>
                        </div>

                        <img id="imagePreview"
                             class="admin-upload-preview"
                             src="@ViewBag.ImageUrl"
                             alt="Course preview"
                             style="display:@(string.IsNullOrWhiteSpace(ViewBag.ImageUrl as string) ? "none" : "block");" />
                    </div>
                </label>

                <input type="file"
                       id="imageFile"
                       name="imageFile"
                       accept=".png,.jpg,.jpeg"
                       class="admin-hidden-file"
                       onchange="previewAdminImage(event)" />

                @if (!string.IsNullOrWhiteSpace(ViewBag.ImageUrl as string))
                {
                    <div class="dashboard-muted-small" style="margin-top:10px;">
                        Current image is saved. Upload a new one to replace it.
                    </div>
                }
            </div>

            <!-- RIGHT SIDE FIELDS -->
            <div class="course-fields">
                <div>
                    <label class="course-label">Course Title</label>
                    <input type="text" name="title" class="course-input" value="React Advanced Patterns" />
                </div>

                <div class="course-row-2">
                    <div>
                        <label class="course-label">Course Category</label>
                        <select name="category" class="course-input">
                            <option>Marketing</option>
                            <option>Design</option>
                            <option>Development</option>
                            <option>Business</option>
                            <option>IT & Security</option>
                            <option selected>Frontend</option>
                            <option>Backend</option>
                            <option>Data Science</option>
                        </select>
                    </div>

                    <div>
                        <label class="course-label">Level</label>
                        <select name="level" class="course-input">
                            <option>Beginner</option>
                            <option selected>Intermediate</option>
                            <option>Advanced</option>
                        </select>
                    </div>
                </div>

                <div class="course-row-2">
                    <div>
                        <label class="course-label">Instructor</label>
                        <input type="text" name="instructor" class="course-input" value="Jane Smith" />
                    </div>

                    <div>
                        <label class="course-label">Course Code</label>
                        <input type="text" name="courseCode" class="course-input" value="FE401" />
                    </div>
                </div>

                <div class="course-row-2">
                    <div>
                        <label class="course-label">Duration</label>
                        <input type="text" name="durationText" class="course-input" value="3 Months" />
                    </div>

                    <div>
                        <label class="course-label">Language</label>
                        <input type="text" name="language" class="course-input" value="English" />
                    </div>
                </div>

                <div class="course-row-2">
                    <div>
                        <label class="course-label">Total Modules</label>
                        <input type="number" min="0" name="totalModules" class="course-input" value="4" />
                    </div>

                    <div>
                        <label class="course-label">Certificate</label>
                        <select name="certificateIncluded" class="course-input">
                            <option value="true" selected>Included</option>
                            <option value="false">Not Included</option>
                        </select>
                    </div>

                    <div>
                        <label class="course-label">Status</label>
                        <select name="status" class="course-input">
                            <option>Active</option>
                            <option selected>Draft</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="course-label">Course Description</label>
                    <textarea name="description"
                              class="course-input">Explore reusable React patterns, composition, hooks, and scalable frontend architecture.</textarea>
                </div>

                <div>
                    <label class="course-label">Course Content</label>
                    <textarea name="content"
                              class="course-input admin-editor">Hooks, composition, context patterns, state handling, performance optimization, and scalable React architecture.</textarea>
                </div>

                <div class="course-actions">
                    <a asp-area="Admin"
                       asp-controller="Courses"
                       asp-action="Index"
                       class="dashboard-btn dashboard-btn-outline">
                        Cancel
                    </a>

                    <button type="submit" class="dashboard-btn add-course-btn">
                        Update Course
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewAdminImage(event) {
            const input = event.target;
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('uploadPlaceholder');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    if (placeholder) placeholder.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}