@{
    ViewData["Title"] = "Add New Course";
    Layout = "_AdminLayout";
}

<div class="dashboard-page admin-form-page">
    <div class="dashboard-page-head admin-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Add New Course</h1>
            <p class="dashboard-sub">Create a course with all the details needed for the student pages.</p>
        </div>

        <div class="dashboard-head-actions">
            <a asp-area="Admin"
               asp-controller="Courses"
               asp-action="Index"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Courses
            </a>
        </div>
    </div>

    <div class="dashboard-panel course-form-panel admin-form-panel admin-form-panel-wide">
        <form id="courseCreateForm"
              enctype="multipart/form-data"
              class="course-form-grid admin-form-layout-split">
            <input type="hidden" id="courseId" value="@ViewBag.CourseId" />
            <input type="hidden" id="isAdminPage" value="true" />
            <input type="hidden" id="redirectUrl" value="/Admin/Courses/Index" />
            <input type="hidden" id="selectedTrainerId" value="" />

            <!-- LEFT SIDE IMAGE -->
            <div class="admin-form-media">
                <label for="imageFile" class="admin-form-media-box admin-upload-box">
                    <div class="admin-form-media-inner" id="uploadInner">
                        <div class="admin-form-media-content admin-upload-content" id="uploadPlaceholder">
                            <div class="admin-form-media-icon">
                                <i class="bi bi-image"></i>
                            </div>
                            <div class="admin-form-media-title">Upload Course Image</div>
                            <div class="admin-form-media-sub">
                                PNG/JPG supported. Recommended wide cover image for cards and detail page.
                            </div>
                        </div>

                        <img id="imagePreview"
                             class="admin-upload-preview"
                             alt="Course preview"
                             style="display:none;" />
                    </div>
                </label>

                <input type="file"
                       id="imageFile"
                       name="ImageFile"
                       accept=".png,.jpg,.jpeg"
                       class="admin-hidden-file"
                       onchange="previewAdminImage(event)" />
            </div>

            <!-- RIGHT SIDE FIELDS -->
            <div class="course-fields">
                <div class="course-row-2">
                    <div>
                        <label class="course-label">Course Title</label>
                        <input type="text" id="title" name="Title" class="course-input" placeholder="Enter course title" required />
                    </div>

                    <div>
                        <label class="course-label">Course Category</label>
                        <select id="category" name="Category" class="course-input" required>
                            <option value="">Select category</option>
                            <option>Marketing</option>
                            <option>Design</option>
                            <option>Development</option>
                            <option>Business</option>
                            <option>IT & Security</option>
                            <option>Frontend</option>
                            <option>Backend</option>
                            <option>Data Science</option>
                        </select>
                    </div>
                </div>

                <div class="course-row-2">
                    <div>
                        <label class="course-label">Batch Number</label>
                        <input type="text" id="batchNumber" name="BatchNumber" class="course-input" placeholder="Optional (e.g. CS101)" />
                    </div>
                    <div>
                        <label class="course-label">Trainer</label>
                        <select id="trainerId" name="trainerId" class="course-input" required>
                            <option value="">Select trainers</option>
                        </select>
                    </div>
                    @* <div>
                        <label class="course-label">Trainer</label>
                        <select id="trainerId" name="TrainerId" class="course-input" required>
                            <option value="">Select trainer</option>
                            @foreach (var trainer in ViewBag.Trainers)
                            {
                                <option value="@trainer.Value">@trainer.Text</option>
                            }
                        </select>
                    </div> *@
                    <div>
                        <label class="course-label">Duration</label>
                        <input type="text" id="durationText" name="DurationText" class="course-input" placeholder="e.g. 3 Months" />
                    </div>
                </div>

                <div class="course-row-2">
                    <div>
                        <label class="course-label">Batch Start Date</label>
                        <input type="date" id="batchStartDate" name="BatchStartDate" class="course-input" required />
                    </div>

                    <div>
                        <label class="course-label">Batch End Date</label>
                        <input type="date" id="batchEndDate" name="BatchEndDate" class="course-input" />
                    </div>
                </div>

                <div class="course-row-2">
                    @* <div>
                        <label class="course-label">Total Modules</label>
                        <input type="number" min="0" id="totalModules" name="totalModules" class="course-input" placeholder="e.g. 4" />
                    </div> *@

                    <div>
                        <label class="course-label">Certificate</label>
                        <select id="certificateIncluded" name="CertificateIncluded" class="course-input">
                            <option value="false">Not Included</option>
                            <option value="true">Included</option>
                        </select>
                    </div>

                    <div>
                        <label class="course-label">Status</label>
                        <select id="status" name="Status" class="course-input">
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                        </select>
                    </div>
                    <div>
                        <label class="course-label">Course Handbook</label>

                        <label for="handbookFile" class="student-upload-box course-handbook-upload">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span id="handbookFileName">Choose PDF / document file</span>

                            <input type="file"
                                   id="handbookFile"
                                   name="HandbookFile"
                                   accept=".pdf,.doc,.docx,.ppt,.pptx"
                                   onchange="showHandbookFileName(event)" />
                        </label>
                    </div>
                </div>

                <div>
                    <label class="course-label">Course Description</label>
                    <textarea id="description"
                              name="Description"
                              class="course-input"
                              placeholder="Short summary shown in cards and overview"
                              required></textarea>
                </div>

               

                <div class="text-danger small mb-2 error-box"></div>

                <div class="course-actions">
                    <a asp-area="Admin"
                       asp-controller="Courses"
                       asp-action="Index"
                       class="dashboard-btn dashboard-btn-outline">
                        Cancel
                    </a>

                    <button type="submit" id="saveCourseBtn" class="dashboard-btn add-course-btn">
                        Save Course
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/Course/addEditCourse.js"></script>
}