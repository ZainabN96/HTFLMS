@{
    ViewData["Title"] = "Manage Courses";
    Layout = "_AdminLayout";
}

<div class="dashboard-page admin-courses-page">
    <div class="dashboard-page-head admin-courses-page-head">
        <div>
            <h1 class="dashboard-h1">Manage Courses</h1>
            <p class="dashboard-sub">Manage all courses, modules, and lessons.</p>
        </div>

        <div class="admin-courses-head-actions">
            <div class="courses-head-search">
                <i class="bi bi-search"></i>
                <input type="text" id="courseSearchInput" placeholder="Search courses..." />
            </div>

            <a asp-area="Admin"
               asp-controller="Courses"
               asp-action="Create"
               class="dashboard-btn add-course-btn admin-add-course-btn">
                <i class="bi bi-plus-circle"></i> Add Course
            </a>
        </div>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Courses</div>
                <i class="bi bi-journal-bookmark"></i>
            </div>
            <div class="dashboard-stat-value" id="totalCoursesCount">0</div>
            <div class="dashboard-stat-meta">Available in system</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Active Courses</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value" id="activeCoursesCount">0</div>
            <div class="dashboard-stat-meta">Currently published</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Draft Courses</div>
                <i class="bi bi-pencil-square"></i>
            </div>
            <div class="dashboard-stat-value" id="draftCoursesCount">0</div>
            <div class="dashboard-stat-meta">Pending completion</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Students</div>
                <i class="bi bi-people"></i>
            </div>
            <div class="dashboard-stat-value" id="totalStudentsCount">0</div>
            <div class="dashboard-stat-meta">Across all courses</div>
        </div>
    </div>

    <div class="dashboard-panel admin-courses-table-panel">
        <div class="dashboard-panel-head">
            <div class="dashboard-panel-title">All Courses</div>
            <div class="dashboard-muted-small" id="courseCountText">0 course(s)</div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row dashboard-table-head courses-table-row admin-courses-table-head">
                <div>Title</div>
                <div>Category</div>
                <div>Students</div>
                <div>Status</div>
                <div>Created</div>
                <div>Actions</div>
            </div>

            <div id="coursesTableBody"></div>
        </div>
    </div>
</div>

<div id="toggleCourseConfirmModal" class="custom-modal">
    <div class="custom-modal-backdrop"></div>

    <div class="custom-modal-box">
        <h3 id="toggleCourseModalTitle">Update Course</h3>
        <p id="toggleCourseModalText">Are you sure you want to update this course?</p>

        <div class="custom-modal-actions">
            <button id="cancelToggleCourseBtn" class="dashboard-btn dashboard-btn-outline">
                Cancel
            </button>

            <button id="confirmToggleCourseBtn" class="dashboard-btn add-course-btn">
                Confirm
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax/Course/AdminIndex.js"></script>
}