@{
    ViewData["Title"] = "Modules & Lessons";
    Layout = "_AdminLayout";
}

<div class="dashboard-page trainer-content-page trainer-modules-page">
    <div class="dashboard-page-head trainer-content-head">
        <div>
            <h1 class="dashboard-h1">Modules & Lessons</h1>
            <p class="dashboard-sub">Select a course, then manage modules, lessons, and quizzes separately.</p>
        </div>
    </div>

    <!-- QUICK STATS -->
    <div class="dashboard-stats trainer-content-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Total Modules</div>
                <i class="bi bi-collection"></i>
            </div>
            <div class="dashboard-stat-value">4</div>
            <div class="dashboard-stat-meta">In this course</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Lessons</div>
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="dashboard-stat-value">18</div>
            <div class="dashboard-stat-meta">Across all modules</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Quizzes</div>
                <i class="bi bi-patch-question"></i>
            </div>
            <div class="dashboard-stat-value">4</div>
            <div class="dashboard-stat-meta">Separate quiz items</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Published</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value">Yes</div>
            <div class="dashboard-stat-meta">Visible to students</div>
        </div>
    </div>

    <!-- SHARED TOP FILTER LIKE SLIDES PAGE -->
    <div class="dashboard-panel trainer-content-panel trainer-modules-filter-panel">
        <div class="dashboard-panel-head trainer-content-panel-head trainer-modules-filter-head">
            <div>
                <div class="dashboard-panel-title">Select Course & Module</div>
            </div>

            <div class="trainer-panel-actions trainer-inline-tools trainer-modules-filter-tools">
                <select class="course-input trainer-inline-select trainer-modules-course-select">
                    <option selected>React Advanced Patterns</option>
                    <option>Node.js Backend Development</option>
                    <option>Python for Data Science</option>
                    <option>Full Stack Web Development</option>
                </select>

                <select class="course-input trainer-inline-select trainer-modules-module-select">
                    <option selected>Module 1: Introduction to Web Development</option>
                    <option>Module 2: JavaScript Fundamentals</option>
                    <option>Module 3: React Basics</option>
                    <option>Module 4: Advanced React Patterns</option>
                </select>
            </div>
        </div>
    </div>

    <!-- MODULES SECTION -->
    <div class="dashboard-panel trainer-content-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Modules</div>
            </div>

            <div class="trainer-panel-actions">
                <a asp-area="Trainer"
                   asp-controller="ModulesLessons"
                   asp-action="CreateModule"
                   asp-route-courseId="@ViewBag.CourseId"
                   class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Module
                </a>
            </div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row trainer-modules-table-row dashboard-table-head">
                <div>Title</div>
                <div>Lessons</div>
                <div>Quiz</div>
                <div>Status</div>
                <div>Access</div>
                <div>Order</div>
                <div>Actions</div>
            </div>

            <div class="dashboard-table-row trainer-modules-table-row">
                <div>
                    <div class="courses-title">Module 1: Introduction to Web Development</div>
                    <div class="courses-sub-text">Learn the fundamentals of web development</div>
                </div>
                <div>5 Lessons</div>
                <div>1 Quiz</div>
                <div><span class="pill pill-green">Published</span></div>
                <div>
                    <label class="trainer-toggle">
                        <input type="checkbox"
                               class="module-lock-toggle"
                               data-module-id="1"
                               checked />
                    </label>
                </div>
                <div>1</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="ModulesLessons"
                       asp-action="EditModule"
                       asp-route-courseId="@ViewBag.CourseId"
                       asp-route-moduleId="1"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">Edit</a>
                    <button class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">Delete</button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-modules-table-row">
                <div>
                    <div class="courses-title">Module 2: JavaScript Fundamentals</div>
                    <div class="courses-sub-text">Master the basics of JavaScript programming</div>
                </div>
                <div>4 Lessons</div>
                <div>1 Quiz</div>
                <div><span class="pill pill-yellow">Draft</span></div>
                <div>
                    <label class="trainer-toggle">
                        <input type="checkbox"
                               class="module-lock-toggle"
                               data-module-id="2"
                               checked />
                    </label>
                </div>
                <div>2</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="ModulesLessons"
                       asp-action="EditModule"
                       asp-route-courseId="@ViewBag.CourseId"
                       asp-route-moduleId="2"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">Edit</a>
                    <button class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- LESSONS SECTION -->
    <div class="dashboard-panel trainer-content-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Lessons</div>
            </div>

            <div class="trainer-panel-actions">
                <a asp-area="Trainer"
                   asp-controller="ModulesLessons"
                   asp-action="CreateLesson"
                   asp-route-courseId="@ViewBag.CourseId"
                   class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Lesson
                </a>
            </div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row trainer-lessons-table-row dashboard-table-head">
                <div>Title</div>
                <div>Module</div>
                <div>Type</div>
                <div>Duration</div>
                <div>Status</div>
                <div>Order</div>
                <div>Actions</div>
            </div>

            <div class="dashboard-table-row trainer-lessons-table-row">
                <div>
                    <div class="courses-title">What is Web Development?</div>
                    <div class="courses-sub-text">Intro lesson for beginners</div>
                </div>
                <div>Module 1</div>
                <div><span class="trainer-course-chip">Lesson</span></div>
                <div>15 mins</div>
                <div><span class="pill pill-green">Published</span></div>
                <div>1</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="ModulesLessons"
                       asp-action="EditLesson"
                       asp-route-courseId="@ViewBag.CourseId"
                       asp-route-lessonId="1"
                       asp-route-moduleId="1"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">Edit</a>
                    <button class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">Delete</button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-lessons-table-row">
                <div>
                    <div class="courses-title">HTML Basics</div>
                    <div class="courses-sub-text">Core HTML tags and structure</div>
                </div>
                <div>Module 1</div>
                <div><span class="trainer-course-chip">Lesson</span></div>
                <div>20 mins</div>
                <div><span class="pill pill-green">Published</span></div>
                <div>2</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="ModulesLessons"
                       asp-action="EditLesson"
                       asp-route-courseId="@ViewBag.CourseId"
                       asp-route-lessonId="2"
                       asp-route-moduleId="1"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">Edit</a>
                    <button class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- QUIZ SECTION -->
    <div class="dashboard-panel trainer-content-panel">
        <div class="dashboard-panel-head trainer-content-panel-head">
            <div>
                <div class="dashboard-panel-title">Quizzes</div>
            </div>

            <div class="trainer-panel-actions">
                <a asp-area="Trainer"
                   asp-controller="ModulesLessons"
                   asp-action="CreateQuiz"
                   asp-route-courseId="@ViewBag.CourseId"
                   class="dashboard-btn add-course-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Quiz
                </a>
            </div>
        </div>

        <div class="dashboard-table-wrap">
            <div class="dashboard-table-row trainer-quiz-table-row dashboard-table-head">
                <div>Title</div>
                <div>Module</div>
                <div>Questions</div>
                <div>Attempts</div>
                <div>Status</div>
                <div>Access</div>
                <div>Order</div>
                <div>Actions</div>
            </div>

            <div class="dashboard-table-row trainer-quiz-table-row">
                <div>
                    <div class="courses-title">HTML &amp; CSS Quiz</div>
                    <div class="courses-sub-text">Basic knowledge check</div>
                </div>
                <div>Module 1</div>
                <div>5</div>
                <div>3</div>
                <div><span class="pill pill-green">Published</span></div>
                <div>
                    <label class="trainer-toggle">
                        <input type="checkbox"
                               class="quiz-lock-toggle"
                               data-quiz-id="1"
                               checked />
                    </label>
                </div>
                <div>1</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="ModulesLessons"
                       asp-action="EditQuiz"
                       asp-route-courseId="@ViewBag.CourseId"
                       asp-route-quizId="1"
                       asp-route-moduleId="1"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">Edit</a>
                    <button class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">Delete</button>
                </div>
            </div>

            <div class="dashboard-table-row trainer-quiz-table-row">
                <div>
                    <div class="courses-title">JavaScript Basics Quiz</div>
                    <div class="courses-sub-text">End of module assessment</div>
                </div>
                <div>Module 2</div>
                <div>8</div>
                <div>2</div>
                <div><span class="pill pill-yellow">Draft</span></div>
                <div>
                    <label class="trainer-toggle">
                        <input type="checkbox"
                               class="quiz-lock-toggle"
                               data-quiz-id="2"
                               checked />
                    </label>
                </div>
                <div>2</div>
                <div class="trainer-courses-actions">
                    <a asp-area="Trainer"
                       asp-controller="ModulesLessons"
                       asp-action="EditQuiz"
                       asp-route-courseId="@ViewBag.CourseId"
                       asp-route-quizId="2"
                       asp-route-moduleId="2"
                       class="dashboard-btn dashboard-btn-outline trainer-course-action-btn">Edit</a>
                    <button class="dashboard-btn trainer-delete-soft-btn trainer-course-action-btn">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>