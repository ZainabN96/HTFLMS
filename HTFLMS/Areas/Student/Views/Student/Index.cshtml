@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_StudentLayout";
}

<div class="dashboard-page">

    <div class="dashboard-page-head">
        <div>
            <h1 class="dashboard-h1">Dashboard</h1>
            <p class="dashboard-sub">Your progress, courses, and upcoming deadlines.</p>
        </div>

        <div class="dashboard-head-actions">

            <a class="dashboard-btn dashboard-btn-outline"
               asp-area="Student"
               asp-controller="Courses"
               asp-action="Index">
                <i class="bi bi-journal-plus"></i> Browse Courses
            </a>
        </div>

    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Enrolled Courses</div>
                <i class="bi bi-journal-bookmark"></i>
            </div>
            <div class="dashboard-stat-value" id="totalEnrolledCourses">0</div>
            <div class="dashboard-stat-meta" id="activeCourseCount">0 active right now</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Lessons Completed</div>
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="dashboard-stat-value" id="lessonsCompleted">0</div>
            <div class="dashboard-stat-meta" id="lessonsCompletedMeta">Will update after lesson progress starts</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Average Grade</div>
                <i class="bi bi-award"></i>
            </div>
            <div class="dashboard-stat-value" id="averageGrade">0%</div>
            <div class="dashboard-stat-meta" id="averageGradeMeta">Keep it up</div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-top">
                <div class="dashboard-stat-title">Pending Tasks</div>
                <i class="bi bi-alarm"></i>
            </div>
            <div class="dashboard-stat-value" id="pendingTasks">0</div>
            <div class="dashboard-stat-meta" id="pendingTasksMeta">Due Invoice</div>
        </div>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-panel">
            <div class="dashboard-panel-head">
                <div class="dashboard-panel-title">Upcoming Deadlines</div>
                <a href="#" class="dashboard-panel-link">View all</a>
            </div>

            <div class="dashboard-table">
                <div class="dashboard-table-row dashboard-table-head">
                    <div>Item</div>
                    <div>Course</div>
                    <div>Due</div>
                    <div>Status</div>
                </div>

                <div class="dashboard-table-row">
                    <div class="dashboard-cell-strong">Unit 2 Homework</div>
                    <div>Writing in the Sciences</div>
                    <div>Today 11:59 PM</div>
                    <div><span class="pill pill-yellow">Pending</span></div>
                </div>

                <div class="dashboard-table-row">
                    <div class="dashboard-cell-strong">Unit 3 Homework</div>
                    <div>Writing in the Sciences</div>
                    <div>In 2 days</div>
                    <div><span class="pill pill-yellow">Pending</span></div>
                </div>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="dashboard-panel-head">
                <div class="dashboard-panel-title">Quick Actions</div>
            </div>

            <div class="dashboard-actions">

                <a asp-area="Student"
                   asp-controller="Grades"
                   asp-action="Index"
                   class="dashboard-action-card">
                    <div class="dashboard-action-icon"><i class="bi bi-award"></i></div>
                    <div>
                        <div class="dashboard-action-title">View Grades</div>
                        <div class="dashboard-action-sub">See assignment scores</div>

                    </div>
                </a>

                <a asp-area="Student"
                   asp-controller="Notes"
                   asp-action="Index"
                   class="dashboard-action-card">
                    <div class="dashboard-action-icon"><i class="bi bi-stickies"></i></div>
                    <div>
                        <div class="dashboard-action-title">My Notes</div>
                        <div class="dashboard-action-sub">Review your saved notes</div>
                    </div>
                </a>

                <a asp-area="Student"
                   asp-controller="Profile"
                   asp-action="Index"
                   class="dashboard-action-card">
                    <div class="dashboard-action-icon"><i class="bi bi-person"></i></div>
                    <div>
                        <div class="dashboard-action-title">Update Profile</div>
                        <div class="dashboard-action-sub">Personal info and settings</div>
                    </div>
                </a>
            </div>
        </div>

    </div>

</div>
@section Scripts {
    <script src="~/js/student/student-dashboard.js" asp-append-version="true"></script>
}