@{
    ViewData["Title"] = "Course Enrollment";
    Layout = "_StudentLayout";

    var courseId = ViewBag.CourseId;
}

<input type="hidden" id="courseId" value="@courseId" />

<div class="student-course-details-page">

    <div class="student-course-breadcrumb">
        <a asp-area="" asp-controller="Courses" asp-action="CoursesIndex">Courses</a>
        <span class="student-course-breadcrumb-sep"><i class="bi bi-chevron-right"></i></span>
        <span>Course Enrollment</span>
    </div>

    <div class="dashboard-panel student-course-hero">
        <div class="student-course-hero-header">
            <div class="student-course-hero-title-wrap">
                <div class="student-course-hero-thumb">
                    <img id="courseImage" src="~/img/course/course-1.webp" alt="Course Image" />
                </div>

                <div class="student-course-hero-content">
                    <h1 class="student-course-hero-title" id="courseTitle">Loading...</h1>

                    <div class="student-course-hero-meta-row">
                        <span>
                            <i class="bi bi-person"></i>
                            Trainer:
                            <strong id="trainerName">-</strong>
                        </span>

                        <span>
                            <i class="bi bi-journal-bookmark"></i>
                            <strong id="courseCategory">-</strong>
                        </span>

                        <span>
                            <i class="bi bi-award"></i>
                            <strong id="certificateIncluded">-</strong>
                        </span>
                    </div>
                </div>
            </div>

            <a asp-area="" asp-controller="Courses" asp-action="CoursesIndex"
               class="dashboard-btn dashboard-btn-outline">
                <i class="bi bi-arrow-left"></i> Back to Courses
            </a>
        </div>
    </div>

    <div class="student-course-info-layout">

        <div class="dashboard-panel student-course-info-main-panel">
            <div class="course-info-hero">
                <div class="student-course-info-label">Course Overview</div>
                <h3 class="page-h2 big-title" id="overviewTitle">Loading...</h3>
                <p class="student-course-info-subtext" id="courseDescription">
                    Please wait while course detail is loading.
                </p>
            </div>

            <div class="student-course-info-section">
                <div class="info-h">About this course</div>
                <p class="student-course-info-text" id="aboutCourse">
                    -
                </p>
            </div>

            <div class="student-course-info-section">
                <div class="info-h">Enrollment Confirmation</div>
                <div class="student-course-info-content-box">
                    Please review this course carefully. Your enrollment will only be completed after you click the confirm button.
                </div>

                <div class="mt-3">
                    <button type="button" class="dashboard-btn course-save-btn" id="openEnrollmentModalBtn">
                        <i class="bi bi-check2-circle"></i> Confirm Enrollment
                    </button>
                </div>

                <div class="error-box mt-3" id="enrollmentErrorBox"></div>
            </div>
        </div>

        <div class="dashboard-panel student-course-info-side-panel">
            <div class="student-course-side-image-wrap">
                <img id="sideCourseImage" src="~/img/course/course-1.webp" alt="Course Image" class="student-course-side-image" />
            </div>

            <div class="student-course-side-block">
                <div class="info-h">Trainer</div>

                <div class="taught-by student-course-instructor-card">
                    <img src="~/img/trainers/trainer-2.jpg" alt="Trainer" class="teacher-pic" />
                    <div>
                        <div class="teacher-name" id="sideTrainerName">-</div>
                        <div class="muted">Course Trainer</div>
                    </div>
                </div>
            </div>

            <div class="student-course-side-block">
                <div class="info-h">Course details</div>

                <div class="info-table student-course-details-table">
                    <div class="info-row">
                        <div class="info-key">Category</div>
                        <div class="info-val" id="sideCategory">-</div>
                    </div>

                    <div class="info-row">
                        <div class="info-key">Batch No.</div>
                        <div class="info-val" id="batchNumber">-</div>
                    </div>

                    <div class="info-row">
                        <div class="info-key">Start Date</div>
                        <div class="info-val" id="batchStartDate">-</div>
                    </div>

                    <div class="info-row">
                        <div class="info-key">End Date</div>
                        <div class="info-val" id="batchEndDate">-</div>
                    </div>

                    <div class="info-row">
                        <div class="info-key">Duration</div>
                        <div class="info-val" id="durationText">-</div>
                    </div>

                    <div class="info-row">
                        <div class="info-key">Certificate</div>
                        <div class="info-val" id="sideCertificateIncluded">-</div>
                    </div>
                </div>
            </div>

            <div class="student-course-side-block" id="handbookBlock" style="display:none;">
                <div class="info-h">Handbook</div>

                <a id="handbookBtn" href="#" target="_blank" class="dashboard-btn dashboard-btn-outline">
                    <i class="bi bi-file-earmark-text"></i> Download Handbook
                </a>
            </div>
        </div>

    </div>
</div>

<div class="student-note-modal" id="enrollmentConfirmModal" style="display:none;">
    <div class="student-note-modal-backdrop" id="enrollmentModalBackdrop"></div>

    <div class="student-note-modal-dialog">
        <div class="student-note-form-head">
            <h4 class="student-note-form-title">Confirm Enrollment</h4>

            <button type="button" class="student-note-form-close" id="closeEnrollmentModalBtn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="student-course-info-section">
            <p class="student-course-info-text">
                Are you sure you want to enroll in this course?
            </p>

            <div class="student-note-form-actions">
                <button type="button" class="dashboard-btn dashboard-btn-outline" id="cancelEnrollmentBtn">
                    Cancel
                </button>

                <button type="button" class="dashboard-btn course-save-btn" id="confirmEnrollmentBtn">
                    Yes, Enroll Me
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student/course-enroll-detail.js" asp-append-version="true"></script>
}