@{
    ViewData["Title"] = "My Courses";
    Layout = "_StudentLayout";
}

<div class="dashboard-page course-page-wrap">

    <div class="dashboard-page-head course-page-header-simple">
        <div>
            <h1 class="dashboard-h1">My Courses</h1>
            <p class="dashboard-sub">Continue your learning journey</p>
        </div>
    </div>

    <div class="student-course-grid" id="studentMyCoursesContainer">
        <div class="dashboard-panel">
            <div class="text-center p-4">
                Loading your enrolled courses...
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/student/student-my-courses.js" asp-append-version="true"></script>
}



















