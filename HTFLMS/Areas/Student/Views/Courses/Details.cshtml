                            Remember the order: content, padding, border, margin. This is important
                            when debugging layout spacing issues.
                        </div>

                        <div class="student-note-footer">
                            <span class="student-note-tag">CSS</span>
                            <span class="student-note-tag">Box Model</span>
                            <span class="student-note-tag">Layout</span>
                        </div>
                    </div>

                    <div class="student-note-card"
                         data-module="Module 2: JavaScript Fundamentals"
                         data-lesson="Variables and Data Types"
                         data-title="JavaScript Variables"
                         data-note="Use const when value should not change, let when it can change, and avoid var in modern JavaScript unless there is a specific reason."
                         data-pinned="false">
                        <div class="student-note-card-top">
                            <div class="student-note-card-left">
                                <div class="student-note-title-row">
                                    <h4 class="student-note-title">JavaScript Variables</h4>
                                </div>

                                <div class="student-note-meta">
                                    <span>Module 2</span>
                                    <span>•</span>
                                    <span>Lesson: Variables and Data Types</span>
                                    <span>•</span>
                                    <span>Updated: 2 days ago</span>
                                </div>
                            </div>

                            <div class="student-note-card-right">
                                <button type="button" class="student-note-action-btn js-edit-note-btn">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                            </div>
                        </div>

                        <div class="student-note-content">
                            Use const when value should not change, let when it can change, and avoid var
                            in modern JavaScript unless there is a specific reason.
                        </div>

                        <div class="student-note-footer">
                            <span class="student-note-tag">JavaScript</span>
                            <span class="student-note-tag">Variables</span>
                            <span class="student-note-tag">Data Types</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- COURSE INFO TAB -->
    <div class="student-course-tab-panel" id="tab-info">
        <div class="student-course-info-layout">

            <div class="dashboard-panel student-course-info-side-panel">
                <div class="student-course-side-image-wrap">
                    <img src="@courseImage" alt="@courseTitle" class="student-course-side-image" />
                </div>

                <div class="student-course-side-block">
                    <div class="info-h">Instructor</div>

                    <div class="taught-by student-course-instructor-card">
                        <img src="~/img/trainers/trainer-2.jpg" alt="Instructor" class="teacher-pic" />
                        <div>
                            <div class="teacher-name">@instructorName</div>
                            <div class="muted">Course Instructor</div>
                        </div>
                    </div>
                </div>

                <div class="student-course-side-block">
                    <div class="info-h">Course details</div>

                    <div class="info-table student-course-details-table">
                        <div class="info-row">
                            <div class="info-key">Category</div>
                            <div class="info-val">@courseCategory</div>
                        </div>
                        <div class="info-row">
                            <div class="info-key">Level</div>
                            <div class="info-val">@courseLevel</div>
                        </div>
                        <div class="info-row">
                            <div class="info-key">Total Modules</div>
                            <div class="info-val">@courseModules</div>
                        </div>
                        <div class="info-row">
                            <div class="info-key">Duration</div>
                            <div class="info-val">@courseDuration</div>
                        </div>
                        <div class="info-row">
                            <div class="info-key">Language</div>
                            <div class="info-val">@courseLanguage</div>
                        </div>
                        <div class="info-row">
                            <div class="info-key">Certificate</div>
                            <div class="info-val">@(certificateIncluded ? "Included" : "Not Included")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-panel student-course-info-main-panel">
                <div class="course-info-hero">
                    <div class="student-course-info-label">Course Overview</div>
                    <h3 class="page-h2 big-title">@courseTitle</h3>
                    <p class="student-course-info-subtext">
                        Explore the full details of this course including description, instructor, structure, and learning information.
                    </p>
                </div>

                <div class="student-course-info-section">
                    <div class="info-h">About this course</div>
                    <p class="student-course-info-text">@courseDescription</p>
                </div>

                <div class="student-course-info-section">
                    <div class="info-h">Course content</div>
                    <div class="student-course-info-content-box">@courseContent</div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="student-note-modal" id="studentNoteModal" style="display:none;">
    <div class="student-note-modal-backdrop" id="studentNoteModalBackdrop"></div>

    <div class="student-note-modal-dialog">
        <div class="student-note-form-head">
            <h4 class="student-note-form-title" id="studentNoteModalTitle">Add New Note</h4>
            <button type="button" class="student-note-form-close" id="closeNoteFormBtn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form class="student-note-form" id="studentNoteForm">
            <input type="hidden" id="editingNoteIndex" />

            <div class="student-note-form-grid">
                <div class="student-note-field">
                    <label class="course-label">Module</label>
                    <select class="course-input" id="noteModule">
                        <option value="">Select module</option>
                        <option>Module 1: Introduction to Web Development</option>
                        <option>Module 2: JavaScript Fundamentals</option>
                    </select>
                </div>

                <div class="student-note-field">
                    <label class="course-label">Lesson</label>
                    <select class="course-input" id="noteLesson">
                        <option value="">Select lesson</option>
                        <option>What is Web Development?</option>
                        <option>HTML Basics</option>
                        <option>CSS Fundamentals</option>
                        <option>Introduction to JavaScript</option>
                        <option>Variables and Data Types</option>
                    </select>
                </div>
            </div>

            <div class="student-note-field">
                <label class="course-label">Note Title</label>
                <input type="text" class="course-input" id="noteTitle" placeholder="Enter note title" />
            </div>

            <div class="student-note-field">
                <label class="course-label">Your Note</label>
                <textarea rows="6" class="course-input course-textarea student-note-textarea" id="noteContent" placeholder="Write your note here..."></textarea>
            </div>

            <div class="student-note-form-options">
                <label class="student-note-check">
                    <input type="checkbox" id="notePinned" />
                    <span>Pin this note</span>
                </label>
            </div>

            <div class="student-note-form-actions">
                <button type="button" class="dashboard-btn dashboard-btn-outline" id="cancelNoteFormBtn">Cancel</button>
                <button type="submit" class="dashboard-btn course-save-btn" id="studentNoteSubmitBtn">
                    <i class="bi bi-floppy"></i> Save Note
                </button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script src="~/js/student/course-contentdetails.js" asp-append-version="true"></script>
}
