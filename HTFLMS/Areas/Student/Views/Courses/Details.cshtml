@{
    ViewData["Title"] = "Course Details";
    Layout = "_StudentLayout";
}

<div class="student-course-details-page">

    <div id="studentCourseDetailLoader" class="dashboard-panel">
        <div class="text-center p-4">Loading course details...</div>
    </div>

    <div id="studentCourseDetailContent" style="display:none;">

        <div class="student-course-breadcrumb">
            <a asp-area="Student" asp-controller="Courses" asp-action="Index">My Courses</a>
            <span class="student-course-breadcrumb-sep"><i class="bi bi-chevron-right"></i></span>
            <span id="breadcrumbCourseTitle">Course Details</span>
        </div>

        <div id="studentCourseHero"></div>

        <div class="student-course-tabs">
            <button type="button" class="student-course-tab active" data-tab="modules">Modules &amp; Lessons</button>
            <button type="button" class="student-course-tab" data-tab="slides-assignments">Slides &amp; Assignments</button>
            <button type="button" class="student-course-tab" data-tab="grades">Grades</button>
            <button type="button" class="student-course-tab" data-tab="notes">Notes</button>
            <button type="button" class="student-course-tab" data-tab="info">Course Info</button>
        </div>

        <div class="student-course-tab-panel active" id="tab-modules">
            <div class="course-module-notice">
                <i class="bi bi-info-circle"></i>
                <p>
                    <strong>Module Access Information:</strong>
                    Modules are unlocked sequentially to guide your learning progress.
                </p>
            </div>

            <div id="studentModulesContainer"></div>
        </div>

        <div class="student-course-tab-panel" id="tab-slides-assignments">
            <div id="studentSlidesAssignmentsContainer"></div>
        </div>

        @* <div class="student-course-tab-panel" id="tab-grades">
            <div class="dashboard-panel">
                <h3 class="page-h2">Grades</h3>
                <p class="student-panel-sub">Grades will appear here once your work is graded.</p>
            </div>
        </div> *@

        @* <div class="student-course-tab-panel" id="tab-notes">
            <div class="dashboard-panel">
                <h3 class="page-h2">Notes</h3>
                <p class="student-panel-sub">Notes can be connected later.</p>
            </div>
        </div> *@

        <div class="student-course-tab-panel" id="tab-info">
            <div id="studentCourseInfoContainer"></div>
        </div>

        <!-- GRADES TAB -->
        <div class="student-course-tab-panel" id="tab-grades">
            <div class="student-tab-stack">
                <div class="dashboard-stats">
                    <div class="student-summary-card">
                        <div class="dashboard-stat-title">Overall Grade</div>
                        <div class="dashboard-stat-value">84%</div>
                        <div class="dashboard-stat-meta">Based on graded submissions</div>
                    </div>

                    <div class="student-summary-card">
                        <div class="dashboard-stat-title">Graded Items</div>
                        <div class="dashboard-stat-value">2/4</div>
                        <div class="dashboard-stat-meta">2 items still pending review</div>
                    </div>

                    <div class="student-summary-card">
                        <div class="dashboard-stat-title">Highest Score</div>
                        <div class="dashboard-stat-value">92%</div>
                        <div class="dashboard-stat-meta">Assignment 1</div>
                    </div>

                    <div class="student-summary-card">
                        <div class="dashboard-stat-title">Current Standing</div>
                        <div class="dashboard-stat-value">Good</div>
                        <div class="dashboard-stat-meta">Keep completing upcoming work</div>
                    </div>
                </div>

                <div class="dashboard-panel">
                    <div class="dashboard-panel-head student-panel-head">
                        <div>
                            <h3 class="page-h2">Grade Breakdown</h3>
                            <p class="student-panel-sub">
                                View your assignment and assessment results, grading status, and trainer feedback.
                            </p>
                        </div>

                        <div class="student-grade-legend">
                            <span class="student-grade-legend-item"><span class="student-grade-dot graded"></span> Graded</span>
                            <span class="student-grade-legend-item"><span class="student-grade-dot pending"></span> Pending</span>
                            <span class="student-grade-legend-item"><span class="student-grade-dot missing"></span> Missing</span>
                        </div>
                    </div>

                    <div class="student-grade-list">
                        <div class="student-grade-card graded">
                            <div class="student-grade-card-top">
                                <div class="student-grade-card-left">
                                    <div class="student-grade-item-title">Assignment 1: Rewrite the abstract</div>
                                    <div class="student-grade-item-meta">
                                        <span>Module 1</span>
                                        <span>•</span>
                                        <span>Submitted: 10 Mar, 08:30 PM</span>
                                    </div>
                                </div>

                                <div class="student-grade-card-right">
                                    <span class="student-grade-status graded">Graded</span>
                                    <div class="student-grade-score-block">
                                        <span class="student-grade-score">18/20</span>
                                        <span class="student-grade-score-percent">90%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="student-grade-extra-grid">
                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Trainer</span>
                                    <span class="student-grade-extra-value">John Doe</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Graded On</span>
                                    <span class="student-grade-extra-value">11 Mar, 04:10 PM</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Weight</span>
                                    <span class="student-grade-extra-value">20 Marks</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Result</span>
                                    <span class="student-grade-extra-value good">Excellent Work</span>
                                </div>
                            </div>

                            <div class="student-grade-feedback-box">
                                <div class="student-grade-feedback-title">
                                    <i class="bi bi-chat-left-text"></i> Trainer Feedback
                                </div>
                                <p>
                                    Strong rewrite overall. The abstract is much clearer and easier to follow.
                                    Try to tighten the second sentence and make the conclusion slightly more specific.
                                </p>
                            </div>
                        </div>

                        <div class="student-grade-card graded">
                            <div class="student-grade-card-top">
                                <div class="student-grade-card-left">
                                    <div class="student-grade-item-title">Module 1 Assessment</div>
                                    <div class="student-grade-item-meta">
                                        <span>Type: Assessment</span>
                                        <span>•</span>
                                        <span>Module 1</span>
                                        <span>•</span>
                                        <span>Submitted: 09 Mar, 06:15 PM</span>
                                    </div>
                                </div>

                                <div class="student-grade-card-right">
                                    <span class="student-grade-status graded">Graded</span>
                                    <div class="student-grade-score-block">
                                        <span class="student-grade-score">23/30</span>
                                        <span class="student-grade-score-percent">77%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="student-grade-extra-grid">
                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Trainer</span>
                                    <span class="student-grade-extra-value">John Doe</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Graded On</span>
                                    <span class="student-grade-extra-value">10 Mar, 12:40 PM</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Weight</span>
                                    <span class="student-grade-extra-value">30 Marks</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Result</span>
                                    <span class="student-grade-extra-value average">Good Attempt</span>
                                </div>
                            </div>

                            <div class="student-grade-feedback-box">
                                <div class="student-grade-feedback-title">
                                    <i class="bi bi-chat-left-text"></i> Trainer Feedback
                                </div>
                                <p>
                                    Good understanding of the main ideas. Review structure and supporting detail in the
                                    longer answers because that is where most marks were lost.
                                </p>
                            </div>
                        </div>

                        <div class="student-grade-card pending">
                            <div class="student-grade-card-top">
                                <div class="student-grade-card-left">
                                    <div class="student-grade-item-title">Assignment 2: Analyze the reading passage</div>
                                    <div class="student-grade-item-meta">
                                        <span>Type: Written Assignment</span>
                                        <span>•</span>
                                        <span>Module 2</span>
                                        <span>•</span>
                                        <span>Submitted: 18 Mar, 10:42 PM</span>
                                    </div>
                                </div>

                                <div class="student-grade-card-right">
                                    <span class="student-grade-status pending">Pending Review</span>
                                    <div class="student-grade-score-block">
                                        <span class="student-grade-score muted-text">--/15</span>
                                        <span class="student-grade-score-percent muted-text">Pending</span>
                                    </div>
                                </div>
                            </div>

                            <div class="student-grade-extra-grid">
                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Submission Status</span>
                                    <span class="student-grade-extra-value">Submitted Successfully</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Review Status</span>
                                    <span class="student-grade-extra-value">Waiting for trainer review</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Due Date</span>
                                    <span class="student-grade-extra-value">18 Mar, 11:59 PM</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Marks</span>
                                    <span class="student-grade-extra-value">15 Marks</span>
                                </div>
                            </div>
                        </div>

                        <div class="student-grade-card missing">
                            <div class="student-grade-card-top">
                                <div class="student-grade-card-left">
                                    <div class="student-grade-item-title">Module 2 Assessment</div>
                                    <div class="student-grade-item-meta">
                                        <span>Type: Assessment</span>
                                        <span>•</span>
                                        <span>Module 2</span>
                                        <span>•</span>
                                        <span>Due: 22 Mar, 11:59 PM</span>
                                    </div>
                                </div>

                                <div class="student-grade-card-right">
                                    <span class="student-grade-status missing">Not Submitted</span>
                                    <div class="student-grade-score-block">
                                        <span class="student-grade-score muted-text">--/25</span>
                                        <span class="student-grade-score-percent muted-text">Missing</span>
                                    </div>
                                </div>
                            </div>

                            <div class="student-grade-extra-grid">
                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Submission</span>
                                    <span class="student-grade-extra-value danger">No submission found</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Status</span>
                                    <span class="student-grade-extra-value">Awaiting student submission</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Due Date</span>
                                    <span class="student-grade-extra-value">22 Mar, 11:59 PM</span>
                                </div>

                                <div class="student-grade-extra-item">
                                    <span class="student-grade-extra-label">Marks</span>
                                    <span class="student-grade-extra-value">25 Marks</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- NOTES TAB -->
        <!-- NOTES TAB -->
        <div class="student-course-tab-panel" id="tab-notes">
            <div id="studentNotesContainer"></div>
        </div>



    </div>
</div>

@section Scripts {
    <script src="~/js/student/student-course-content.js" asp-append-version="true"></script>
}
